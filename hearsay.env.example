# Optional settings for docker-compose.yml. Hearsay needs none of them: its
# first visit asks where Audiobookshelf is, and the rest is on the admin screen.
# To set any here instead, copy this to hearsay.env and fill in. A value saved
# on the admin screen wins over one set here.

# Where the API reaches Audiobookshelf. On the same Docker host this can be its
# container, e.g. http://audiobookshelf:80, if both are on one network.
# ABS_URL=https://audiobooks.example.com

# A token that can read items and list users in ABS (an ABS API key).
# ABS_SERVICE_TOKEN=

# The address people open Hearsay at, as your reverse proxy serves it.
# First-run setup saves the address it was done from.
# FRONTEND_URL=https://hearsay.example.com

# Which sign-in routes answer: abs (Audiobookshelf passwords), oidc
# (Authentik), or both. Use abs until an Authentik application exists.
# AUTH_MODE=abs

# Authentik: a new OAuth2/OpenID application for Hearsay, confidential, with
# scopes openid email profile. The redirect URI is FRONTEND_URL + /api/auth/callback.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=

# Mirror each person's recommendations into an ABS collection, hourly.
# MIRROR_ENABLED=false

# What linked servers call this one, e.g. "The family library".
# SERVER_NAME=

# How long a sign-in lasts, in seconds (default 7 days).
# SESSION_MAX_AGE=604800
