use fiig.http
use fiig.http.HttpClient

test absMeSendsTheToken {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect http.headerValue(request.headers, "authorization") == "Bearer tok-1"
            return Ok(http.Reply(status: 200, headers: [], body: "{\"id\":\"u-1\",\"username\":\"ryan\",\"type\":\"admin\",\"permissions\":{}}".utf8()))
        }
    }
    expect AbsApi.me("tok-1") is Ok(user)
    expect user == AbsUser(id: "u-1", username: "ryan", type: "admin")
}
