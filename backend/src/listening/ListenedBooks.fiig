use hearsay.absclient.catalog;
use hearsay.absclient.progress;
use hearsay.ratings.rated;

// What I have listened to, most recent first, each with my score if I gave one.
// A book with progress but no metadata (gone from ABS) is left out.
rule listenedBooks(
    started: List<progress.Progress>,
    books: List<catalog.Book>,
    mine: List<rated.RatingRow>)
        -> List<ListenedBook> {
    byId: Map<string, catalog.Book> = [:];
    for (book in books) {
        byId = byId.put(book.itemId, book);
    }

    scores: Map<string, rated.RatingRow> = [:];
    for (row in mine) {
        scores = scores.put(row.itemId, row);
    }

    listened: List<ListenedBook> = [];
    for (entry in sorted(p in started): p.lastListenedAt descending) {
        match (byId.atOrNone(entry.itemId)) {
            None -> {
            },

            book -> {
                rating = scores.atOrNone(entry.itemId);
                listened = append(
                    listened,
                    ListenedBook(
                        itemId: book.itemId,
                        libraryId: book.libraryId,
                        title: book.title,
                        authors: book.authors,
                        finished: entry.finished,
                        percent: entry.percent,
                        lastListenedAt: entry.lastListenedAt,
                        myScore: scoreOf(rating),
                        recommended: recommendedOf(rating),
                        myNote: noteOf(rating),
                        myNoteShared: noteSharedOf(rating),
                    ),
                );
            },
        }
    }

    return listened;
}

private {
    scoreOf(rating: rated.RatingRow | None) -> int | None {
        return match (rating) {
            None -> None,
            row -> row.score,
        }
    }

    noteOf(rating: rated.RatingRow | None) -> string {
        return match (rating) {
            None -> "",
            row -> row.note,
        }
    }

    noteSharedOf(rating: rated.RatingRow | None) -> bool {
        return match (rating) {
            None -> false,
            row -> row.noteShared,
        }
    }

    recommendedOf(rating: rated.RatingRow | None) -> bool {
        return match (rating) {
            None -> false,
            row -> row.recommended,
        }
    }
}
