use hearsay.books

// The status and message a client sees for each way listening can fail.
conversion listeningErrorResponse(error: ListeningError) -> HttpResponse<string> {
    return match (error) {
        ListeningError.AccountNotFound -> HttpResponse(
            status: 404,
            body: "no Audiobookshelf account for you",
        )
        ListeningError.Book(cause) -> books.bookErrorResponse(cause)
        ListeningError.Unavailable(detail) -> HttpResponse(status: 503, body: detail)
    }
}
