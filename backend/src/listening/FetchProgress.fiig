use hearsay.absclient
use hearsay.absclient.progress
use hearsay.absclient.progress.AbsProgress
use hearsay.common

// What ABS says I have started. A 404 is an account ABS no longer has.
gateway fetchProgress(abs: absclient.AbsTarget, userId: string) -> Result<List<progress.Progress>, common.ApiError>
    requires AbsProgress
{
    return mapErr(e in AbsProgress.progressAsService(abs, userId)): common.apiErrorOfAbs(e)
}
