use abs.recommendations.absclient.progress
use abs.recommendations.absclient.progress.AbsProgress
use abs.recommendations.common

// What ABS says I have started. A 404 is an account ABS no longer has.
gateway fetchProgress(userId: string) -> Result<List<progress.Progress>, common.ApiError>
    requires AbsProgress
{
    return mapErr(e in AbsProgress.progressAsService(userId)): common.apiErrorOfAbs(e)
}
