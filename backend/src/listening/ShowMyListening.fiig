use hearsay.accounts;
use hearsay.books;
use hearsay.settings;

// GET /me/listening: what I am listening to and finished, for
// "My books" screen and Rate tab.
workflow showMyListening(me: accounts.Identity) -> Result<List<ListenedBook>, ListeningError> {
    started = mapErr(e in loadProgress(me.userId)): listeningErrorOfFault(e)?;
    found = mapErr(e in books.cachedBooks(map(p in started): p.itemId)): ListeningError.Book(e)?;
    return Ok(listenedBooks(started, found, loadMyScores(me.userId)));
}
