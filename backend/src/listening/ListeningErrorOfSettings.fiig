use hearsay.settings

// A server that is not set up has no listening to show.
conversion listeningErrorOfSettings(error: settings.SettingsError) -> ListeningError {
    return match (error) {
        settings.SettingsError.NoAbsUrl -> ListeningError.Unavailable(
            "this server isn't set up yet: an admin needs to enter the Audiobookshelf address",
        )
        settings.SettingsError.NoServiceToken -> ListeningError.Unavailable(
            "this server isn't set up yet: an admin needs to enter its Audiobookshelf token",
        )
    }
}
