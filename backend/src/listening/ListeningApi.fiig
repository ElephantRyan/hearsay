use hearsay.accounts
use hearsay.sessions

// The listening routes of the HTTP surface; src/Hearsay.fiig serves every domain's
// adapter together.
adapter http listeningApi {
    principal me: accounts.Identity from cookie "sid" by sessions.signedIn else sessions.identityErrorResponse

    GET "/me/listening" -> showMyListening(me)
        produces "application/json"
    {
        Ok(books) -> 200 books
        Err(error) -> listeningErrorResponse(error)
    }
}
