use hearsay.common

// The listening routes of the HTTP surface; serve-dev.sh serves every domain's
// adapter together.
adapter http listeningApi {
    GET "/me/listening" -> showMyListening(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(books) -> 200 books
        Err(error) -> common.apiErrorResponse(error)
    }
}
