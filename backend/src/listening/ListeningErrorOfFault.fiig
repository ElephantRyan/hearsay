use hearsay.absclient as client;

// Here a 404 from ABS means the person's own account, not a book.
conversion listeningErrorOfFault(fault: client.AbsFault) -> ListeningError {
    return match (fault) {
        client.AbsFault.Missing -> ListeningError.AccountNotFound,
        client.AbsFault.Denied -> ListeningError.Unavailable(
            "this server's Audiobookshelf token was refused; tell the server's admin",
        ),
        client.AbsFault.Down(detail) -> ListeningError.Unavailable(detail),
    }
}
