use fiig.http

// A GET to the identity provider; token is "" for the discovery document.
rule oidcGet(url: string, token: string) -> http.Request {
    if token == "" {
        return http.Request(
            method: http.Method.Get,
            url: url,
            headers: [http.Header(name: "Accept", value: "application/json")],
            timeoutMillis: 10000,
        )
    }
    return http.Request(
        method: http.Method.Get,
        url: url,
        headers: [http.Header(name: "Accept", value: "application/json"), http.Header(name: "Authorization", value: "Bearer ${token}")],
        timeoutMillis: 10000,
    )
}
