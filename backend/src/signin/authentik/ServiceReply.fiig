use hearsay.absclient as client;
use hearsay.accounts;
use fiig.http;

// A reply to a call made with this server's own ABS token, not the person's.
// A refusal here is a misconfigured server, not a wrong password, so it
// must never read "wrong username or password".
conversion serviceReply(
    answer: Result<http.Reply, client.AbsError>,
) -> Result<http.Reply, accounts.SignInError> {
    return match (answer) {
        Ok(reply) -> Ok(reply),
        Err(error) -> Err(serviceFailure(error)),
    }
}

private {
    serviceFailure(error: client.AbsError) -> accounts.SignInError {
        return match (client.faultOfAbs(error)) {
            client.AbsFault.Missing -> accounts.SignInError.Unavailable(
                "Audiobookshelf has no user list at the expected address",
            ),
            client.AbsFault.Denied -> accounts.SignInError.Unavailable(
                "this server's Audiobookshelf token was refused; tell the server's admin",
            ),
            client.AbsFault.Down(detail) -> accounts.SignInError.Unavailable(detail),
        }
    }
}
