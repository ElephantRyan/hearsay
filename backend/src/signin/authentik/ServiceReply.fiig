use abs.recommendations.absclient as client
use abs.recommendations.accounts
use fiig.http

// A reply to a call made with this server's own ABS token, not the person's.
// A refusal here is a misconfigured server, not a wrong password, so it
// must never read "wrong username or password".
conversion serviceReply(answer: Result<http.Reply, client.AbsError>) -> Result<http.Reply, accounts.SignInError> {
    match answer {
        Ok(reply) -> Ok(reply)
        Err(error) -> Err(serviceFailure(error))
    }
}

private {
    serviceFailure(error: client.AbsError) -> accounts.SignInError {
        match error {
            client.AbsError.Unauthorized -> accounts.SignInError.Unavailable("this server's Audiobookshelf token was refused; tell the server's admin")
            client.AbsError.NotFound -> accounts.SignInError.Unavailable("Audiobookshelf has no user list at the expected address")
            client.AbsError.Rejected(status) -> accounts.SignInError.Unavailable("Audiobookshelf answered ${status}")
            client.AbsError.Unreachable(failure) -> accounts.SignInError.Unavailable("Audiobookshelf is unreachable")
            client.AbsError.Unreadable(failure) -> accounts.SignInError.Unavailable("Audiobookshelf's reply was unreadable")
        }
    }
}
