use fiig.http;

// Where the browser goes to sign in. state ties the callback to this
// browser; the challenge ties the code to the verifier only we hold.
conversion authorizeUrl(
    endpoint: string,
    clientId: string,
    redirectUri: string,
    state: string,
    challenge: string,
) -> string {
    query = queryOf(
        [
            http.Header(name: "response_type", value: "code"),
            http.Header(name: "client_id", value: clientId),
            http.Header(name: "redirect_uri", value: redirectUri),
            http.Header(name: "scope", value: "openid email profile"),
            http.Header(name: "state", value: state),
            http.Header(name: "code_challenge", value: challenge),
            http.Header(name: "code_challenge_method", value: "S256"),
        ],
    );
    return "${endpoint}?${query}";
}

private {
    queryOf(fields: List<http.Header>) -> string {
        return match (http.formEncode(fields).utf8()) {
            None -> "",
            text -> text,
        }
    }
}
