// Sign-in through Authentik (OIDC authorization code + PKCE). A gateway
// requires exactly one capability (ADR 0010), so this one does its own HTTP
// to the identity provider and to ABS, reusing abs.client's pure helpers
// (absGet, absReply, usersMatchingEmail) rather than calling AbsMembers.
//
// `beginUrl` is outside the SignIn interface: only the OIDC path has a
// redirect step. The caller makes `state` and `codeVerifier` (Random.bytes),
// keeps them in a short-lived cookie, and passes them back at the callback.
use hearsay.absclient as client;
use hearsay.absclient.members;
use hearsay.accounts;
use fiig.http;
use fiig.http.HttpClient;

capability AuthentikSignIn provides accounts.SignIn {
    gateway beginUrl(oidc: accounts.OidcSettings, state: string, codeVerifier: string)
            -> Result<string, accounts.SignInError>
            requires HttpClient {
        found = oidcReply(HttpClient.send(oidcGet(discoveryUrl(oidc.issuer), "")))?;
        endpoints: OidcDiscovery = mapErr(e in json.decode(found.body)):
                unreadable("discovery document")?;
        return Ok(
            authorizeUrl(
                endpoints.authorizationEndpoint,
                oidc.clientId,
                oidc.redirectUri,
                state,
                pkceChallenge(codeVerifier)
            )
        );
    }

    gateway authenticate(attempt: accounts.SignInAttempt, server: accounts.SignInServer)
            -> Result<accounts.Identity, accounts.SignInError>
            requires HttpClient {
        return match (attempt) {
            accounts.SignInAttempt.Password(username, password) -> Err(
                accounts.SignInError.WrongMethod
            ),
            accounts.SignInAttempt.AuthorizationCode(code, codeVerifier) -> {
                oidc = oidcOf(server)?;
                found = oidcReply(HttpClient.send(oidcGet(discoveryUrl(oidc.issuer), "")))?;
                endpoints: OidcDiscovery = mapErr(e in json.decode(found.body)):
                        unreadable("discovery document")?;
                exchanged = oidcReply(
                    HttpClient.send(
                        tokenRequest(
                            endpoints.tokenEndpoint,
                            code,
                            codeVerifier,
                            oidc.redirectUri,
                            oidc.clientId,
                            oidc.clientSecret.reveal()
                        )
                    )
                )?;
                token: OidcTokenReply = mapErr(e in json.decode(exchanged.body)):
                        unreadable("token reply")?;
                profile = oidcReply(
                    HttpClient.send(oidcGet(endpoints.userinfoEndpoint, token.accessToken))
                )?;
                info: OidcUserInfo = mapErr(e in json.decode(profile.body)):
                        unreadable("user info")?;
                email = emailOf(info)?;
                serviceToken = tokenOf(server)?;
                listed = serviceReply(
                    client.absReply(
                        HttpClient.send(
                            client.absGet(server.absUrl, "/api/users", serviceToken.reveal())
                        )
                    )
                )?;
                everyone: members.AbsUsersReply = mapErr(e in json.decode(listed.body)):
                        unreadable("list of Audiobookshelf users")?;
                return identityOfMatches(members.usersMatchingEmail(everyone.users, email));
            }
        }
    }

    // Whether the Authentik application's discovery document answers: the admin
    // screen's check before anyone signs in with it.
    gateway discover(oidc: accounts.OidcSettings) -> Result<int, accounts.SignInError>
            requires HttpClient {
        found = oidcReply(HttpClient.send(oidcGet(discoveryUrl(oidc.issuer), "")))?;
        endpoints: OidcDiscovery = mapErr(e in json.decode(found.body)):
                unreadable("discovery document")?;
        return Ok(found.status);
    }
}
