// Proves who a person is with whichever provider the rule picks, then
// returns only the Identity. Nobody can sign in before Audiobookshelf's
// address is set.
use hearsay.accounts;
use hearsay.settings;

activity signIn(attempt: accounts.SignInAttempt)
        -> Result<accounts.Identity, accounts.SignInError> {
    return match (settings.absUrl()) {
        None -> {
            return Err(accounts.SignInError.Unavailable("this server isn't set up yet"));
        },

        url -> {
            Provider = signInProvider(attempt);
            return Provider.authenticate(
                attempt,
                accounts.SignInServer(
                    absUrl: url,
                    serviceToken: settings.serviceToken(),
                    oidc: settings.oidcSettingsOf(),
                ),
            );
        },
    }
}
