use abs.recommendations.accounts
use abs.recommendations.common

conversion apiErrorOfSignIn(error: accounts.SignInError) -> common.ApiError {
    match error {
        accounts.SignInError.WrongMethod -> common.ApiError.Refused("this server does not sign people in that way")
        accounts.SignInError.NoAccount -> common.ApiError.Refused("no Audiobookshelf account has your email; sign in to Audiobookshelf once first")
        accounts.SignInError.Refused(reason) -> common.ApiError.Refused(reason)
        accounts.SignInError.Unavailable(detail) -> common.ApiError.Unavailable(detail)
    }
}
