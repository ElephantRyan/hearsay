// Step two: the browser comes back from Authentik with a code and the state
// we sent. The cookie we set in step one must carry the same state, or this
// callback wasn't started by this browser (CSRF), and nothing is exchanged.
// Every outcome is a place to send the browser, so a failure never leaves
// someone staring at JSON.
use abs.recommendations.accounts
use abs.recommendations.sessions

activity finishSignIn(code: string | None, state: string | None, error: string | None, pending: string | None) -> Landing {
    if SignInConfig.authMode == "abs" {
        return failedLanding("disabled")
    }
    match error {
        None -> {
            return landAfterExchange(code, state, pending)
        }
        denied -> {
            return failedLanding("denied")
        }
    }
}

private {
    failedLanding(reason: string) -> Landing {
        return Landing(
            location: "${SignInConfig.frontendUrl}/sign-in?error=${reason}",
            session: None,
        )
    }

    landAfterExchange(code: string | None, state: string | None, pending: string | None) -> Landing {
        match code {
            None -> {
                return failedLanding("missing")
            }
            given -> {
                match readPendingParts(pending) {
                    None -> {
                        return failedLanding("state")
                    }
                    parts -> {
                        if state != parts.state {
                            return failedLanding("state")
                        }
                        return exchange(given, parts.verifier)
                    }
                }
            }
        }
    }

    exchange(code: string, verifier: string) -> Landing {
        proven = signIn(accounts.SignInAttempt.AuthorizationCode(code, verifier))
        match proven {
            Err(failure) -> {
                return failedLanding(refusalCode(failure))
            }
            Ok(identity) -> {
                session = sessions.startSession(identity)
                return Landing(location: SignInConfig.frontendUrl, session: session)
            }
        }
    }

    // Splits the "state.verifier" cookie; anything else is None.
    readPendingParts(pending: string | None) -> PendingParts | None {
        match pending {
            None -> None
            text -> partsOf(text.split("."))
        }
    }

    partsOf(pieces: List<string>) -> PendingParts | None {
        if pieces.length() != 2 {
            return None
        }
        return PendingParts(state: pieces.at(0), verifier: pieces.at(1))
    }

    // A short code for the frontend to show a message for; never the provider's
    // own words.
    refusalCode(error: accounts.SignInError) -> string {
        match error {
            accounts.SignInError.WrongMethod -> "method"
            accounts.SignInError.NoAccount -> "no-account"
            accounts.SignInError.Refused(reason) -> "refused"
            accounts.SignInError.Unavailable(detail) -> "unavailable"
        }
    }
}
