// The self-hoster's sign-in: the person's own Audiobookshelf username and
// password, checked by ABS's /login. The password is forwarded and dropped;
// only the Identity comes back (PLAN.md section 5).
use abs.recommendations.absclient as client
use abs.recommendations.absclient.AbsApi
use abs.recommendations.signin

capability AbsPasswordSignIn provides signin.SignIn {
    gateway authenticate(attempt: signin.SignInAttempt) -> Result<signin.Identity, signin.SignInError>
        requires AbsApi
    {
        match attempt {
            signin.SignInAttempt.AuthorizationCode(code, codeVerifier) -> Err(signin.SignInError.WrongMethod)
            signin.SignInAttempt.Password(username, password) -> {
                session = AbsApi.login(username, password)
                match session {
                    Err(error) -> Err(signin.signInErrorOfAbs(error))
                    Ok(found) -> Ok(identityOfSession(found))
                }
            }
        }
    }
}
