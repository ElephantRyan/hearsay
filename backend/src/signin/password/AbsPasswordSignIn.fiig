// The self-hoster's sign-in: the person's own Audiobookshelf username and
// password, checked by ABS's /login. The password is forwarded and dropped;
// only the Identity comes back (PLAN.md section 5).
use hearsay.absclient.members.AbsMembers;
use hearsay.accounts;

capability AbsPasswordSignIn provides accounts.SignIn {
    gateway authenticate(attempt: accounts.SignInAttempt, server: accounts.SignInServer)
            -> Result<accounts.Identity, accounts.SignInError>
            requires AbsMembers {
        return match (attempt) {
            accounts.SignInAttempt.AuthorizationCode(code, codeVerifier) -> Err(
                accounts.SignInError.WrongMethod
            ),
            accounts.SignInAttempt.Password(username, password) -> {
                session = AbsMembers.login(server.absUrl, username, password);
                return match (session) {
                    Err(error) -> Err(accounts.signInErrorOfAbs(error)),
                    Ok(found) -> Ok(identityOfSession(found))
                }
            }
        }
    }
}
