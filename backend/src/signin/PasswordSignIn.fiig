use hearsay.accounts;
use hearsay.sessions;

// Password sign-in exists unless the server is Authentik-only; then this
// route doesn't, as far as a caller can tell.
workflow passwordSignIn(input: PasswordLogin) -> Result<sessions.Session, LoginError> {
    modes = loadSignInModes();
    if (!modes.password) {
        return Err(LoginError.PasswordNotOffered);
    }

    identity = mapErr(e in signIn(accounts.SignInAttempt.Password(input.username, input.password))): loginErrorOfSignIn(
        e,
    )?;
    return Ok(sessions.startSession(identity));
}
