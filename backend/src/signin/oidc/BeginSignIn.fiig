use abs.recommendations.accounts
use abs.recommendations.common
use abs.recommendations.settings

// Step one of Authentik sign-in: fresh state and PKCE verifier (256 random
// bits each, ADR 0068), and the URL to send the browser to.
activity beginSignIn() -> Result<OidcStart, common.ApiError> {
    match settings.oidcSettingsOf() {
        None -> {
            return Err(common.ApiError.NotFound("Authentik sign-in on this server"))
        }
        oidc -> {
            return beginWith(oidc)
        }
    }
}

private {
    beginWith(oidc: accounts.OidcSettings) -> Result<OidcStart, common.ApiError> {
        state = Random.bytes(count: 32).toBase64Url()
        verifier = Random.bytes(count: 32).toBase64Url()
        url = fetchAuthorizeUrl(oidc, state, verifier)?
        return Ok(OidcStart(url: url, pending: "${state}.${verifier}"))
    }
}
