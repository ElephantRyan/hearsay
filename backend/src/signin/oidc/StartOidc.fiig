use hearsay.signin;

// Authentik sign-in exists unless the server is password-only.
workflow startOidc() -> Result<OidcStart, signin.LoginError> {
    modes = signin.loadSignInModes();
    if (!modes.oidc) {
        return Err(signin.LoginError.OidcNotOffered);
    }

    return mapErr(e in beginSignIn()): signin.loginErrorOfSignIn(e);
}
