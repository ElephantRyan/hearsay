// 302 to the frontend. When the sign-in worked it carries the session cookie;
// either way the one-use oidc cookie is deleted.
conversion landed(landing: Landing) -> HttpResponse<None> {
    return match (landing.session) {
        None -> HttpResponse(
            status: 302,
            headers: ["Location": landing.location, "Cache-Control": "no-store"],
            cookies: [Cookie(name: "oidc", value: "", maxAge: 0)]
        ),
        session -> HttpResponse(
            status: 302,
            headers: ["Location": landing.location, "Cache-Control": "no-store"],
            cookies: [
                Cookie(name: "sid", value: session.token, maxAge: session.maxAge),
                Cookie(name: "oidc", value: "", maxAge: 0)
            ]
        )
    }
}
