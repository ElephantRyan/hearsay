use hearsay.absclient as client
use hearsay.common

// The same as apiErrorOfAbs, except a 404 here means the library, not a book.
conversion apiErrorOfLibrary(error: client.AbsError) -> common.ApiError {
    match client.faultOfAbs(error) {
        client.AbsFault.Missing -> common.ApiError.NotFound("library with that id")
        client.AbsFault.Denied -> common.apiErrorOfAbs(error)
        client.AbsFault.Down(detail) -> common.ApiError.Unavailable(detail)
    }
}
