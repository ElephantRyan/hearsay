use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.common

gateway fetchHits(libraryId: string, query: string, size: int) -> Result<catalog.BookPage, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.searchAsService(libraryId, query, size)): apiErrorOfLibrary(e)
}
