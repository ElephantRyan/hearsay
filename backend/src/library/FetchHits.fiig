use hearsay.absclient;
use hearsay.absclient.catalog;
use hearsay.absclient.catalog.AbsCatalog;

gateway fetchHits(libraryId: string, query: string, size: int)
        -> Result<catalog.SearchHits, absclient.AbsFault>
        requires AbsCatalog {
    return mapErr(e in AbsCatalog.searchAsService(libraryId, query, size)): absclient.faultOfAbs(e);
}
