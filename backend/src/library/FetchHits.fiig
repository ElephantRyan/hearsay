use abs.recommendations.absclient as client
use abs.recommendations.absclient.AbsApi
use abs.recommendations.common

gateway fetchHits(libraryId: string, query: string, size: int) -> Result<client.BookPage, common.ApiError>
    requires AbsApi
{
    return mapErr(e in AbsApi.searchAsService(libraryId, query, size)): apiErrorOfLibrary(e)
}
