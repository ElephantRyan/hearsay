use abs.recommendations.absclient
use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.common

gateway fetchHits(abs: absclient.AbsTarget, libraryId: string, query: string, size: int) -> Result<catalog.BookPage, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.searchAsService(abs, libraryId, query, size)): apiErrorOfLibrary(e)
}
