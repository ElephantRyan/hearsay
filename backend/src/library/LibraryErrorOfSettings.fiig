use hearsay.settings

// A server that is not set up has no libraries to show.
conversion libraryErrorOfSettings(error: settings.SettingsError) -> LibraryError {
    return match (error) {
        settings.SettingsError.NoAbsUrl -> LibraryError.Unavailable(
            "this server isn't set up yet: an admin needs to enter the Audiobookshelf address",
        )
        settings.SettingsError.NoServiceToken -> LibraryError.Unavailable(
            "this server isn't set up yet: an admin needs to enter its Audiobookshelf token",
        )
    }
}
