// One book with the ratings the viewer may see. A book nobody has rated yet
// is fetched from ABS, so the page can offer the first rating.
use abs.recommendations.books
use abs.recommendations.common
use abs.recommendations.ratings
use abs.recommendations.sessions

activity loadItemDetail(session: string | None, itemId: string) -> Result<ItemDetail, common.ApiError> {
    me = sessions.currentUser(session)?
    rows = ratings.visibleRatingsOf(itemId, me.userId)
    book = books.cachedBook(itemId)?
    return Ok(
        ItemDetail(book: book, average: averageOf(rows), count: count(r in rows): r.recommended, ratings: rows),
    )
}
