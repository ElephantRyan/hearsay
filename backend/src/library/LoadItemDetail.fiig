// One book with the ratings the viewer may see. A book nobody has rated yet
// is fetched from ABS, so the page can offer the first rating.
use abs.recommendations.books
use abs.recommendations.common
use abs.recommendations.ratings.rated
use abs.recommendations.ratings.rated.RatedBooks
use abs.recommendations.sessions

activity loadItemDetail(session: string | None, itemId: string) -> Result<ItemDetail, common.ApiError> {
    me = sessions.currentUser(session)?
    rows = RatedBooks.visibleFor(itemId, me.userId)
    book = books.cachedBook(itemId)?
    return Ok(
        ItemDetail(book: book, average: averageOf(rows), count: count(r in rows): r.recommended, ratings: rows),
    )
}

private {
    // The average score over the recommended rows, or 0.00 for none.
    averageOf(rows: List<rated.RatingRow>) -> decimal {
        recommended = filter(r in rows): r.recommended
        if recommended.length() == 0 {
            return math.divide(
                math.toDecimal(0),
                math.toDecimal(1),
                places: 2,
                rounding: Rounding.HalfUp,
            )
        }
        return math.divide(
            math.toDecimal(sum(r in recommended): r.score),
            math.toDecimal(recommended.length()),
            places: 2,
            rounding: Rounding.HalfUp,
        )
    }
}
