use hearsay.absclient as client

// Here a 404 from ABS means the library, not a book.
conversion libraryErrorOfFault(fault: client.AbsFault) -> LibraryError {
    match fault {
        client.AbsFault.Missing -> LibraryError.LibraryNotFound
        client.AbsFault.Denied -> LibraryError.Unavailable("this server's Audiobookshelf token was refused; tell the server's admin")
        client.AbsFault.Down(detail) -> LibraryError.Unavailable(detail)
    }
}
