use hearsay.absclient
use hearsay.absclient.catalog
use hearsay.absclient.catalog.AbsCatalog
use hearsay.common

// A page of a library, A to Z. A 404 here means the library, not a book.
gateway fetchPage(abs: absclient.AbsTarget, libraryId: string, page: int, size: int) -> Result<catalog.BookPage, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.pageAsService(abs, libraryId, page, size)): apiErrorOfLibrary(e)
}
