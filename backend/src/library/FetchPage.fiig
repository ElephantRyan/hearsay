use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.common

// A page of a library, A to Z. A 404 here means the library, not a book.
gateway fetchPage(libraryId: string, page: int, size: int) -> Result<catalog.BookPage, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.pageAsService(libraryId, page, size)): apiErrorOfLibrary(e)
}
