use hearsay.absclient;
use hearsay.absclient.catalog;
use hearsay.absclient.catalog.AbsCatalog;

// A page of a library, in the order asked. A 404 here means the library, not a book.
gateway fetchPage(libraryId: string, page: int, size: int, order: catalog.BookOrder)
        -> Result<catalog.BookPage, absclient.AbsFault>
        requires AbsCatalog {
    return mapErr(e in AbsCatalog.pageAsService(libraryId, page, size, order)):
            absclient.faultOfAbs(e);
}
