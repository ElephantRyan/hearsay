use abs.recommendations.absclient
use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.common

gateway fetchLibraries(abs: absclient.AbsTarget) -> Result<List<catalog.AbsLibrary>, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.librariesAsService(abs)): apiErrorOfLibrary(e)
}
