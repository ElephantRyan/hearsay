// One page of a library, or the hits of a search when `typed` is given, with
// the viewer's own scores. The inputs are already checked by the workflow.
use abs.recommendations.absclient.catalog
use abs.recommendations.common
use abs.recommendations.ratings.rated
use abs.recommendations.ratings.rated.RatedBooks
use abs.recommendations.sessions

activity loadBrowseResult(session: string | None, libraryId: string, page: int, size: int, typed: string | None) -> Result<BrowseResult, common.ApiError> {
    me = sessions.currentUser(session)?
    found = fetchBooks(libraryId, page, size, typed)?
    mine = RatedBooks.byUser(me.userId)
    return Ok(
        BrowseResult(total: found.total, page: found.page, limit: found.limit, items: withMyScores(found.books, mine)),
    )
}

private {
    fetchBooks(libraryId: string, page: int, size: int, typed: string | None) -> Result<catalog.BookPage, common.ApiError> {
        match typed {
            None -> {
                return fetchPage(libraryId, page, size)
            }
            text -> {
                return fetchHits(libraryId, text, size)
            }
        }
    }

    // Marks each book with the viewer's own score, if they have one.
    withMyScores(books: List<catalog.Book>, mine: List<rated.RatingRow>) -> List<BrowseItem> {
        scores: Map<string, int> = [:]
        for row in mine {
            scores = scores.put(row.itemId, row.score)
        }
        items: List<BrowseItem> = []
        for book in books {
            items = append(
                items,
                BrowseItem(itemId: book.itemId, libraryId: book.libraryId, title: book.title, authors: book.authors, myScore: scores.atOrNone(book.itemId)),
            )
        }
        return items
    }
}
