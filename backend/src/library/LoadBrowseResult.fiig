// One page of a library (or of one author's or series' books), or the hits of a
// search when `typed` is given, in `order`, with the viewer's own scores. The
// inputs are already checked by the workflow.
use hearsay.absclient;
use hearsay.absclient.catalog;
use hearsay.ratings.rated;
use hearsay.ratings.rated.RatedBooks;
use hearsay.sessions;
use hearsay.settings;

activity loadBrowseResult(
    userId: string,
    libraryId: string,
    page: int,
    size: int,
    typed: string | None,
    order: catalog.BookOrder,
    scope: catalog.BookScope)
        -> Result<BrowseResult, absclient.AbsFault> {
    found = fetchBooks(libraryId, page, size, typed, order, scope)?;
    mine = RatedBooks.byUser(userId);
    return Ok(
        BrowseResult(
            total: found.page.total,
            page: found.page.page,
            limit: found.page.limit,
            items: withMyScores(found.page.books, mine),
            authors: map(a in found.authors): BrowseMatch(id: a.id, name: a.name, books: a.books),
            series: map(s in found.series): BrowseMatch(id: s.id, name: s.name, books: s.books),
        ),
    );
}

private {
    // A listing is a page with no author or series matches; a search, its hits
    // put in the order chosen.
    fetchBooks(
        libraryId: string,
        page: int,
        size: int,
        typed: string | None,
        order: catalog.BookOrder,
        scope: catalog.BookScope)
            -> Result<catalog.SearchHits, absclient.AbsFault> {
        return match (typed) {
            None -> {
                listed = fetchPage(libraryId, page, size, order, scope)?;
                return Ok(catalog.SearchHits(page: listed, authors: [], series: []));
            },

            text -> {
                hits = fetchHits(libraryId, text, size)?;
                return Ok(
                    catalog.SearchHits(
                        page: catalog.BookPage(
                            total: hits.page.total,
                            page: hits.page.page,
                            limit: hits.page.limit,
                            books: sortHits(hits.page.books, order),
                        ),
                        authors: hits.authors,
                        series: hits.series,
                    ),
                );
            },
        }
    }

    // Marks each book with the viewer's own score and recommendation, if they rated it.
    withMyScores(books: List<catalog.Book>, mine: List<rated.RatingRow>) -> List<BrowseItem> {
        ratings: Map<string, rated.RatingRow> = [:];
        for (row in mine) {
            ratings = ratings.put(row.itemId, row);
        }

        items: List<BrowseItem> = [];
        for (book in books) {
            rating = ratings.atOrNone(book.itemId);
            myScore: int | None = match (rating) {
                None -> None,
                row -> row.score,
            }

            myRecommended = match (rating) {
                None -> false,
                row -> row.recommended,
            }

            items = append(
                items,
                BrowseItem(
                    itemId: book.itemId,
                    libraryId: book.libraryId,
                    title: book.title,
                    authors: book.authors,
                    myScore: myScore,
                    myRecommended: myRecommended,
                ),
            );
        }

        return items;
    }
}
