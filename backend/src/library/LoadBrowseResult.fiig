// One page of a library, or the hits of a search when `typed` is given, with
// the viewer's own scores. The inputs are already checked by the workflow.
use hearsay.absclient
use hearsay.absclient.catalog
use hearsay.ratings.rated
use hearsay.ratings.rated.RatedBooks
use hearsay.sessions
use hearsay.settings

activity loadBrowseResult(
    userId: string,
    abs: absclient.AbsTarget,
    libraryId: string,
    page: int,
    size: int,
    typed: string | None,
) -> Result<BrowseResult, absclient.AbsFault> {
    found = fetchBooks(abs, libraryId, page, size, typed)?;
    mine = RatedBooks.byUser(userId);
    return Ok(
        BrowseResult(
            total: found.total,
            page: found.page,
            limit: found.limit,
            items: withMyScores(found.books, mine),
        ),
    );
}

private {
    fetchBooks(
        abs: absclient.AbsTarget,
        libraryId: string,
        page: int,
        size: int,
        typed: string | None,
    ) -> Result<catalog.BookPage, absclient.AbsFault> {
        return match (typed) {
            None -> {
                return fetchPage(abs, libraryId, page, size);
            }

            text -> {
                return fetchHits(abs, libraryId, text, size);
            }
        }
    }

    // Marks each book with the viewer's own score, if they have one.
    withMyScores(books: List<catalog.Book>, mine: List<rated.RatingRow>) -> List<BrowseItem> {
        scores: Map<string, int> = [:];
        for (row in mine) {
            scores = scores.put(row.itemId, row.score);
        }

        items: List<BrowseItem> = [];
        for (book in books) {
            items = append(
                items,
                BrowseItem(
                    itemId: book.itemId,
                    libraryId: book.libraryId,
                    title: book.title,
                    authors: book.authors,
                    myScore: scores.atOrNone(book.itemId),
                ),
            );
        }

        return items;
    }
}
