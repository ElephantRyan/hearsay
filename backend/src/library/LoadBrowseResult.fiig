// One page of a library, or the hits of a search when `typed` is given, in
// `order`, with the viewer's own scores. The inputs are already checked by the workflow.
use hearsay.absclient;
use hearsay.absclient.catalog;
use hearsay.ratings.rated;
use hearsay.ratings.rated.RatedBooks;
use hearsay.sessions;
use hearsay.settings;

activity loadBrowseResult(
    userId: string,
    libraryId: string,
    page: int,
    size: int,
    typed: string | None,
    order: catalog.BookOrder)
        -> Result<BrowseResult, absclient.AbsFault> {
    found = fetchBooks(libraryId, page, size, typed, order)?;
    mine = RatedBooks.byUser(userId);
    return Ok(
        BrowseResult(
            total: found.total,
            page: found.page,
            limit: found.limit,
            items: withMyScores(found.books, mine),
        ),
    );
}

private {
    fetchBooks(
        libraryId: string,
        page: int,
        size: int,
        typed: string | None,
        order: catalog.BookOrder)
            -> Result<catalog.BookPage, absclient.AbsFault> {
        return match (typed) {
            None -> {
                return fetchPage(libraryId, page, size, order);
            },

            text -> {
                hits = fetchHits(libraryId, text, size)?;
                return Ok(
                    catalog.BookPage(
                        total: hits.total,
                        page: hits.page,
                        limit: hits.limit,
                        books: sortHits(hits.books, order),
                    ),
                );
            },
        }
    }

    // Marks each book with the viewer's own score and recommendation, if they rated it.
    withMyScores(books: List<catalog.Book>, mine: List<rated.RatingRow>) -> List<BrowseItem> {
        ratings: Map<string, rated.RatingRow> = [:];
        for (row in mine) {
            ratings = ratings.put(row.itemId, row);
        }

        items: List<BrowseItem> = [];
        for (book in books) {
            rating = ratings.atOrNone(book.itemId);
            myScore: int | None = match (rating) {
                None -> None,
                row -> row.score,
            }

            myRecommended = match (rating) {
                None -> false,
                row -> row.recommended,
            }

            items = append(
                items,
                BrowseItem(
                    itemId: book.itemId,
                    libraryId: book.libraryId,
                    title: book.title,
                    authors: book.authors,
                    myScore: myScore,
                    myRecommended: myRecommended,
                ),
            );
        }

        return items;
    }
}
