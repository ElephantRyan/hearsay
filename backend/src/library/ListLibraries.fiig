// The libraries a person can browse. Only book libraries: podcasts have no
// place in a book-recommendation list.
use hearsay.absclient.catalog
use hearsay.common
use hearsay.sessions
use hearsay.settings

activity listLibraries(session: string | None) -> Result<List<catalog.AbsLibrary>, common.ApiError> {
    mapErr(e in sessions.currentUser(session)): sessions.apiErrorOfIdentity(e)?
    all = fetchLibraries(mapErr(e in settings.loadAbsTarget()): settings.apiErrorOfSettings(e)?)?
    return Ok(filter(library in all): library.mediaType == "book")
}
