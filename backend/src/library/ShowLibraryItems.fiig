use hearsay.accounts;
use hearsay.settings;

// Browse a library A to Z, or search it. What a page, a size and a search text
// may be is decided here, before Audiobookshelf is asked anything; the activity
// only fetches.
workflow showLibraryItems(
    me: accounts.Identity,
    libraryId: string,
    page: int | None,
    size: int | None,
    q: string | None)
        -> Result<BrowseResult, LibraryError> {
    pageNumber = checkPage(page)?;
    pageSize = checkSize(size)?;
    typed = searchText(q)?;
    return mapErr(e in loadBrowseResult(me.userId, libraryId, pageNumber, pageSize, typed)):
            libraryErrorOfFault(e);
}
