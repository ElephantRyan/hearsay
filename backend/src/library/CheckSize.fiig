// How many books a page holds: 24 unless asked, never more than 100.
rule checkSize(size: int | None) -> Result<int, LibraryError> {
    chosen = size ?? 24;
    if (chosen < 1 || chosen > 100) {
        return Err(LibraryError.Invalid("size", "must be from 1 to 100"));
    }

    return Ok(chosen);
}
