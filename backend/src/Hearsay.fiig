use hearsay.account;
use hearsay.admin;
use hearsay.health;
use hearsay.library;
use hearsay.links;
use hearsay.listening;
use hearsay.ratings;
use hearsay.ratings.rated;
use hearsay.recommendations;
use hearsay.refresh;
use hearsay.series;
use hearsay.sessions;
use hearsay.setup;
use hearsay.signin;
use hearsay.signin.oidc;
use hearsay.sync;
use hearsay.upnext;

// What Hearsay runs (fiig ADR 0132): the HTTP surface, linked servers' routes
// included, the hourly collections sync and linked-server fetch, and the
// daily refresh from Audiobookshelf.
application Hearsay {
    serve web {
        sessions.sessionsApi;
        account.accountApi;
        signin.signinApi;
        oidc.oidcApi;
        ratings.ratingsApi;
        rated.ratedApi;
        library.libraryApi;
        recommendations.recommendationsApi;
        series.seriesApi;
        sync.syncApi;
        listening.listeningApi;
        upnext.upNextApi;
        admin.adminApi;
        links.linksApi;
        links.federationApi;
        setup.setupApi;
        health.healthApi;
    }

    serve worker {
        sync.syncSchedule;
        links.linksSchedule;
        refresh.refreshSchedule;
    }
}
