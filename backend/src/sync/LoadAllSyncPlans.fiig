use hearsay.books;
use hearsay.books.BookSeriesIndex;
use hearsay.links;
use hearsay.recommendations;
use hearsay.series.SeriesRatings;
use hearsay.settings;

// What a full sync would do, for everyone, linked servers' people included
// (LINKED.md section 6), and the server-wide top collections first: the
// scheduled run's plan. A recommended series counts as one entry, its book 1.
// Before the standalones are worked out, the recommended books whose series
// aren't known yet are asked about, all in one call. Otherwise reads our tables
// and touches nothing.
activity loadAllSyncPlans() -> List<SyncPlan> {
    rows = syncRows();
    states = allSyncStates();
    people = planSync(rows, states, everyoneToSync(rows, states));
    picks = SeriesRatings.recommended();
    folded = recommendations.collapseSeries(
        links.everyRecommendation(),
        picks,
        SeriesRatings.books(),
    );
    recommendedIds = map(r in filter(r in folded): r.recommended): r.itemId;
    // If ABS can't be asked, the books not known stay out of the standalones.
    match (books.cachedBooks(recommendedIds)) {
        Ok(_) -> {
        },

        Err(_) -> {
        },
    }

    inSeries = map(b in BookSeriesIndex.all()): b.itemId;
    standalones = standalonesOf(folded, BookSeriesIndex.known(), inSeries);
    top = planTopSync(
        recommendations.sortRanked(recommendations.rankSeries(picks)),
        recommendations.sortRanked(recommendations.rankRecommendations(standalones)),
        states,
        settings.topSeries(),
        settings.topStandalones(),
    );
    return withTopFirst(top, people);
}
