// Carries out one planned change and records it. The only code in this app that
// writes to ABS. A collection we made that ABS no longer has (someone deleted
// it) is recreated; one that is already gone when we remove it is just forgotten.
use abs.recommendations.absclient as client
use abs.recommendations.absclient.collections.AbsCollections

activity applyPlan(plan: SyncPlan, now: int) -> SyncResult {
    match plan.collectionId {
        None -> {
            return createFor(plan, now)
        }
        existing -> {
            if plan.action == "remove" {
                return removeFor(plan, existing)
            }
            return updateFor(plan, existing, now)
        }
    }
}

private {
    remember(plan: SyncPlan, collectionId: string, now: int) -> int {
        return saveSyncState(
            SyncState(userId: plan.userId, libraryId: plan.libraryId, collectionId: collectionId, lastSyncedAt: now, lastError: None),
        )
    }

    createFor(plan: SyncPlan, now: int) -> SyncResult {
        match AbsCollections.createCollectionAsService(plan.libraryId, plan.name, plan.description, plan.bookIds) {
            Ok(id) -> {
                remember(plan, id, now)
                return syncResultOf(plan, "created", None)
            }
            Err(error) -> {
                return syncResultOf(plan, "failed", failedText(error))
            }
        }
    }

    updateFor(plan: SyncPlan, existing: string, now: int) -> SyncResult {
        match AbsCollections.updateCollectionAsService(existing, plan.name, plan.description, plan.bookIds) {
            Ok(_) -> {
                remember(plan, existing, now)
                return syncResultOf(plan, "updated", None)
            }
            Err(error) -> {
                if error == client.AbsError.NotFound {
                    deleteSyncState(plan.userId, plan.libraryId)
                    return createFor(plan, now)
                }
                return syncResultOf(plan, "failed", failedText(error))
            }
        }
    }

    removeFor(plan: SyncPlan, existing: string) -> SyncResult {
        match AbsCollections.deleteCollectionAsService(existing) {
            Ok(_) -> {
                deleteSyncState(plan.userId, plan.libraryId)
                return syncResultOf(plan, "removed", None)
            }
            Err(error) -> {
                if error == client.AbsError.NotFound {
                    deleteSyncState(plan.userId, plan.libraryId)
                    return syncResultOf(plan, "removed", None)
                }
                return syncResultOf(plan, "failed", failedText(error))
            }
        }
    }

    // Short, safe text for a failed collection write. Never a token or a body.
    failedText(error: client.AbsError) -> string {
        match error {
            client.AbsError.NotFound -> "Audiobookshelf has no such collection or library"
            client.AbsError.Unauthorized -> "Audiobookshelf refused the server's token"
            client.AbsError.Rejected(status) -> "Audiobookshelf answered ${status}"
            client.AbsError.Unreachable(failure) -> "Audiobookshelf is unreachable"
            client.AbsError.Unreadable(failure) -> "Audiobookshelf's reply was unreadable"
        }
    }

    syncResultOf(plan: SyncPlan, action: string, error: string | None) -> SyncResult {
        return SyncResult(
            userId: plan.userId,
            libraryId: plan.libraryId,
            action: action,
            books: plan.bookIds.length(),
            error: error,
        )
    }
}
