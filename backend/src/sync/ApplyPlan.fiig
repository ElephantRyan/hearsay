// Carries out one planned change and records it. The only code in this app that
// writes to ABS. A collection we made that ABS no longer has (someone deleted
// it) is recreated; one that is already gone when we remove it is just forgotten.
use hearsay.absclient as client;
use hearsay.absclient.collections.AbsCollections;

activity applyPlan(plan: SyncPlan, now: int) -> SyncResult {
    return match (plan.collectionId) {
        None -> {
            return createFor(plan, now);
        },

        existing -> {
            if (plan.action == SyncAction.Remove) {
                return removeFor(plan, existing);
            }

            if (plan.action == SyncAction.Recreate) {
                return recreateFor(plan, existing, now);
            }

            return updateFor(plan, existing, now);
        },
    }
}

private {
    remember(plan: SyncPlan, collectionId: string, now: int) -> int {
        return saveSyncState(
            SyncState(
                userId: plan.userId,
                libraryId: plan.libraryId,
                collectionId: collectionId,
                lastSyncedAt: now,
                lastError: None,
            ),
        );
    }

    createFor(plan: SyncPlan, now: int) -> SyncResult {
        return match (AbsCollections.createCollectionAsService(plan.libraryId, plan.name, plan.description, plan.bookIds)) {
            Ok(id) -> {
                remember(plan, id, now);
                return syncResultOf(plan, SyncOutcome.Created, None);
            },

            Err(error) -> {
                return syncResultOf(plan, SyncOutcome.Failed, failedText(error));
            },
        }
    }

    updateFor(plan: SyncPlan, existing: string, now: int) -> SyncResult {
        return match (AbsCollections.updateCollectionAsService(existing, plan.name, plan.description, plan.bookIds)) {
            Ok(_) -> {
                remember(plan, existing, now);
                return syncResultOf(plan, SyncOutcome.Updated, None);
            },

            Err(error) -> {
                if (error == client.AbsError.NotFound) {
                    deleteSyncState(plan.userId, plan.libraryId);
                    return createFor(plan, now);
                }

                return syncResultOf(plan, SyncOutcome.Failed, failedText(error));
            },
        }
    }

    // Deletes the collection and makes it again, so it is newer than a top
    // collection made before it (ABS lists the oldest first).
    recreateFor(plan: SyncPlan, existing: string, now: int) -> SyncResult {
        match (AbsCollections.deleteCollectionAsService(existing)) {
            Ok(_) -> {
            },

            Err(error) -> {
                // Already gone is fine: it is made again either way.
                if (error != client.AbsError.NotFound) {
                    return syncResultOf(plan, SyncOutcome.Failed, failedText(error));
                }
            },
        }

        deleteSyncState(plan.userId, plan.libraryId);
        made = createFor(plan, now);
        if (made.action == SyncOutcome.Created) {
            return copy(made, action: SyncOutcome.Recreated);
        }

        return made;
    }

    removeFor(plan: SyncPlan, existing: string) -> SyncResult {
        return match (AbsCollections.deleteCollectionAsService(existing)) {
            Ok(_) -> {
                deleteSyncState(plan.userId, plan.libraryId);
                return syncResultOf(plan, SyncOutcome.Removed, None);
            },

            Err(error) -> {
                if (error == client.AbsError.NotFound) {
                    deleteSyncState(plan.userId, plan.libraryId);
                    return syncResultOf(plan, SyncOutcome.Removed, None);
                }

                return syncResultOf(plan, SyncOutcome.Failed, failedText(error));
            },
        }
    }

    // Short, safe text for a failed collection write. Never a token or a body.
    failedText(error: client.AbsError) -> string {
        return match (client.faultOfAbs(error)) {
            client.AbsFault.Missing -> "Audiobookshelf has no such collection or library",
            client.AbsFault.Denied -> "Audiobookshelf refused the server's token",
            client.AbsFault.Down(detail) -> detail,
        }
    }

    syncResultOf(plan: SyncPlan, action: SyncOutcome, error: string | None) -> SyncResult {
        return SyncResult(
            userId: plan.userId,
            libraryId: plan.libraryId,
            action: action,
            books: plan.bookIds.length(),
            error: error,
        );
    }
}
