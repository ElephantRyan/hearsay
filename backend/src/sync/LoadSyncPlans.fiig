use hearsay.accounts
use hearsay.ratings.rated.RatedBooks

// What sync would do for whoever the caller may sync: reads tables and
// plans, and touches nothing.
activity loadSyncPlans(me: accounts.Identity, userId: string | None) -> Result<List<SyncPlan>, SyncError> {
    rows = RatedBooks.recommended()
    states = allSyncStates()
    targets = syncTargets(me, userId, everyoneToSync(rows, states))?
    return Ok(planSync(rows, states, targets))
}
