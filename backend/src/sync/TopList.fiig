// The server-wide collections, in the order they should come first in ABS.
// Each is kept in sync_state under its own id, as a person's collection is
// kept under their user id.
formulas topList {
    formula recommendedId() -> string {
        return "top-recommended";
    }

    formula ratedId() -> string {
        return "top-rated";
    }

    formula isTop(userId: string) -> bool {
        return userId == "top-recommended" || userId == "top-rated";
    }

    // How many books each one holds.
    formula size() -> int {
        return 25;
    }
}
