use hearsay.absclient as client
use hearsay.accounts
use hearsay.common

// Whose lists a sync touches: "admin or self" (PLAN.md section 4). A person
// syncs their own; an admin may name anyone, or leave it out for everyone who
// has recommendations or a collection of ours (everyoneToSync, from the caller).
conversion syncTargets(me: accounts.Identity, requested: string | None, everyone: List<string>) -> Result<List<string>, common.ApiError> {
    admin = client.canAdminister(me.userType)
    match requested {
        None -> {
            if not admin {
                return Ok([me.userId])
            }
            return Ok(everyone)
        }
        named -> {
            if named != me.userId and not admin {
                return Err(common.ApiError.Refused("only an admin can sync someone else's list"))
            }
            return Ok([named])
        }
    }
}
