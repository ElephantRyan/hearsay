use hearsay.absclient.roles
use hearsay.accounts

// Whose lists a sync touches: "admin or self" (PLAN.md section 4). A person
// syncs their own; an admin may name anyone, or leave it out for everyone who
// has recommendations or a collection of ours (everyoneToSync, from the caller).
rule syncTargets(
    me: accounts.Identity,
    requested: string | None,
    everyone: List<string>,
) -> Result<List<string>, SyncError> {
    admin = roles.canAdminister(me.userType);
    return match (requested) {
        None -> {
            if (!admin) {
                return Ok([me.userId]);
            }

            return Ok(everyone);
        }

        named -> {
            if (named != me.userId && !admin) {
                return Err(SyncError.NotAllowed);
            }

            return Ok([named]);
        }
    }
}
