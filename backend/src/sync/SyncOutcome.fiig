// What a sync did (or, in a dry run, would do) for one person in one
// library. The would-be forms are a dry run's, spelled as the API spells them.
enum SyncOutcome {
    WouldCreate from json "would-create",
    WouldUpdate from json "would-update",
    WouldRecreate from json "would-recreate",
    WouldRemove from json "would-remove",
    Created from json "created",
    Updated from json "updated",
    Recreated from json "recreated",
    Removed from json "removed",
    Failed from json "failed",
}
