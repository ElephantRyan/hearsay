use hearsay.accounts
use hearsay.settings

// POST /sync. Off unless the server enabled it, a preview unless the caller
// said `dryRun=false`, and only then does anything write to ABS.
workflow syncCollections(
    me: accounts.Identity,
    userId: string | None,
    dryRun: bool | None,
) -> Result<List<SyncResult>, SyncError> {
    if (!settings.mirrorEnabled()) {
        return Err(SyncError.MirroringOff);
    }

    plans = loadSyncPlans(me, userId)?;
    if (wantsDryRun(dryRun)) {
        return Ok(preview(plans));
    }

    abs = mapErr(e in settings.loadAbsTarget()): syncErrorOfSettings(e)?;
    return Ok(applyPlans(abs, plans));
}

private {
    // Anything but an explicit `dryRun=false` is a dry run: writing to ABS is
    // something a caller must say out loud.
    wantsDryRun(dryRun: bool | None) -> bool {
        return dryRun ?? true;
    }
}
