use hearsay.settings

// A server that is not set up has nowhere to write collections.
conversion syncErrorOfSettings(error: settings.SettingsError) -> SyncError {
    return match (error) {
        settings.SettingsError.NoAbsUrl -> SyncError.Unavailable(
            "this server isn't set up yet: an admin needs to enter the Audiobookshelf address",
        )
        settings.SettingsError.NoServiceToken -> SyncError.Unavailable(
            "this server isn't set up yet: an admin needs to enter its Audiobookshelf token",
        )
    }
}
