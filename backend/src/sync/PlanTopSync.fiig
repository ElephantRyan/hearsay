use hearsay.sync.once;
use hearsay.sync.topList;
use hearsay.recommendations;

// What the server-wide collections should become in each library: "Top 10
// Series" (recommended series, as each one's book 1) and "Top 25 Standalones"
// (recommended books in no series), each most recommended first. A library with
// nothing to list gets no collection; one of ours with nothing left, with its
// setting off, or of a kind no longer made, is a remove.
rule planTopSync(
    bySeries: List<recommendations.RecommendedBook>,
    standalones: List<recommendations.RecommendedBook>,
    states: List<SyncState>,
    seriesOn: bool,
    standalonesOn: bool)
        -> List<SyncPlan> {
    current = plansFor(topList.seriesId(), "Top ${topList.seriesSize()} Series", topList.seriesSize(), bySeries, states, seriesOn).concat(
        plansFor(
            topList.standalonesId(),
            "Top ${topList.standalonesSize()} Standalones",
            topList.standalonesSize(),
            standalones,
            states,
            standalonesOn
        )
    );
    retired = filter(s in states): topList.isTop(s.userId) && s.userId != topList.seriesId() && s.userId != topList.standalonesId();
    return current.concat(map(s in retired): removeOf(s));
}

private {
    plansFor(
        top: string,
        name: string,
        size: int,
        ranked: List<recommendations.RecommendedBook>,
        states: List<SyncState>,
        on: bool)
            -> List<SyncPlan> {
        byLibrary = groupBy(b in ranked): b.libraryId;
        theirs = filter(s in states): s.userId == top;
        plans: List<SyncPlan> = [];
        if (on) {
            for (libraryId, books in byLibrary) {
                existing = collectionIn(theirs, libraryId);
                plans = append(
                    plans,
                    SyncPlan(
                        userId: top,
                        libraryId: libraryId,
                        name: name,
                        description: "Maintained by Hearsay. Edits here are overwritten on the next sync.",
                        bookIds: once.unique(map(b in books): b.itemId).take(size),
                        collectionId: existing,
                        action: createOrUpdate(existing)
                    )
                );
            }
        }

        for (state in theirs) {
            if (!on || !byLibrary.containsKey(state.libraryId)) {
                plans = append(plans, removeOf(state));
            }
        }

        return plans;
    }

    removeOf(state: SyncState) -> SyncPlan {
        return SyncPlan(
            userId: state.userId,
            libraryId: state.libraryId,
            name: "",
            description: "",
            bookIds: [],
            collectionId: state.collectionId,
            action: SyncAction.Remove
        );
    }

    collectionIn(theirs: List<SyncState>, libraryId: string) -> string | None {
        found = filter(s in theirs): s.libraryId == libraryId;
        return match (found.firstOrNone()) {
            None -> None,
            state -> state.collectionId
        }
    }

    createOrUpdate(existing: string | None) -> SyncAction {
        return match (existing) {
            None -> SyncAction.Create,
            id -> SyncAction.Update
        }
    }
}
