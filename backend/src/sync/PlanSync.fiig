use hearsay.ratings.rated;

// Works out, without touching anything, what each named person's collections
// should become. One collection per person per library, "<name> Recommends",
// holding every book they recommend, best first (unscored ones last). A linked server's person gets
// one too, of the books matched here, and its description says where from. A library where they have
// recommendations and we have no collection is a create; both is an update;
// a collection of ours with nothing left to hold is a remove.
rule planSync(rows: List<rated.RatingRow>, states: List<SyncState>, userIds: List<string>)
        -> List<SyncPlan> {
    plans: List<SyncPlan> = [];
    for (userId in userIds) {
        mine = filter(r in rows): r.userId == userId && r.recommended;
        theirs = filter(s in states): s.userId == userId;
        byLibrary = groupBy(r in mine): r.libraryId;
        for (libraryId, group in byLibrary) {
            ordered = sorted(r in group): (r.score ?? 0) descending then r.updatedAt descending;
            existing = collectionIn(theirs, libraryId);
            plans = append(
                plans,
                SyncPlan(
                    userId: userId,
                    libraryId: libraryId,
                    name: "${group.at(0).username} Recommends",
                    description: descriptionFor(group.at(0).via),
                    bookIds: map(r in ordered): r.itemId,
                    collectionId: existing,
                    action: createOrUpdate(existing),
                ),
            );
        }

        for (state in theirs) {
            if (!byLibrary.containsKey(state.libraryId)) {
                plans = append(
                    plans,
                    SyncPlan(
                        userId: userId,
                        libraryId: state.libraryId,
                        name: "",
                        description: "",
                        bookIds: [],
                        collectionId: state.collectionId,
                        action: SyncAction.Remove,
                    ),
                );
            }
        }
    }

    return plans;
}

private {
    collectionIn(theirs: List<SyncState>, libraryId: string) -> string | None {
        found = filter(s in theirs): s.libraryId == libraryId;
        return match (found.firstOrNone()) {
            None -> None,
            state -> state.collectionId,
        }
    }

    descriptionFor(via: string | None) -> string {
        return match (via) {
            None -> "Maintained by Hearsay. Edits here are overwritten on the next sync.",
            server -> "Recommended on ${server}. Maintained by Hearsay. Edits here are overwritten on the next sync.",
        }
    }

    createOrUpdate(existing: string | None) -> SyncAction {
        return match (existing) {
            None -> SyncAction.Create,
            id -> SyncAction.Update,
        }
    }
}
