use hearsay.sessions;

// The sync routes of the HTTP surface; src/Hearsay.fiig serves every domain's
// adapter together.
adapter http syncApi {
    wire sessions.me;

    POST "/sync?userId={userId}&dryRun={dryRun}" -> syncCollections(
        me,
        userId: string | None,
        dryRun: bool | None
    )
            produces "application/json" {
        Ok(results) -> 200 results,
        Err(error) -> syncErrorResponse(error)
    }
}
