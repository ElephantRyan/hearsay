use hearsay.common

// The sessions routes of the HTTP surface (PLAN.md section 4); serve-dev.sh serves
// every domain's adapter together.
adapter http sessionsApi {
    DELETE "/session" -> endSession(session: string | None from cookie "sid")
        produces "application/json"
    {
        _ -> signedOut()
    }
    GET "/me" -> whoAmI(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(identity) -> 200 identity
        Err(error) -> common.apiErrorResponse(error)
    }
}
