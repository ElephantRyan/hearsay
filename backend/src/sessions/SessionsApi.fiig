// The sessions routes of the HTTP surface; src/Hearsay.fiig serves every
// domain's adapter together.
adapter http sessionsApi {
    wire me

    // Logging out with no session is fine, so this route settles no principal.
    DELETE "/session" public -> endSession(session: string | None from cookie "sid")
        produces "application/json"
    {
        _ -> signedOut()
    }
    GET "/me" -> whoAmI(me)
        produces "application/json"
    {
        identity -> 200 identity
    }
}
