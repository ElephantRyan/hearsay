use abs.recommendations.signin
use abs.recommendations.common

conversion apiErrorOfSignIn(error: signin.SignInError) -> common.ApiError {
    match error {
        signin.SignInError.WrongMethod -> common.ApiError.Refused("this server does not sign people in that way")
        signin.SignInError.NoAccount -> common.ApiError.Refused("no Audiobookshelf account has your email; sign in to Audiobookshelf once first")
        signin.SignInError.Refused(reason) -> common.ApiError.Refused(reason)
        signin.SignInError.Unavailable(detail) -> common.ApiError.Unavailable(detail)
    }
}
