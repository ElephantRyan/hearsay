// Who the session cookie belongs to. Every route that needs a signed-in
// person starts here.
use hearsay.accounts

activity currentUser(token: string | None) -> Result<accounts.Identity, IdentityError> {
    match token {
        None -> {
            return Err(IdentityError.NotSignedIn)
        }
        found -> {
            match findSession(tokenHash(found), Clock.now()) {
                None -> {
                    return Err(IdentityError.NotSignedIn)
                }
                identity -> {
                    return Ok(identity)
                }
            }
        }
    }
}
