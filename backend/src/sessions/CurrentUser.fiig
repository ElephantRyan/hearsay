// Who the session cookie belongs to. Every route that needs a signed-in
// person starts here.
use hearsay.accounts
use hearsay.common

activity currentUser(token: string | None) -> Result<accounts.Identity, common.ApiError> {
    match token {
        None -> {
            return Err(common.ApiError.Unauthenticated)
        }
        found -> {
            match findSession(tokenHash(found), Clock.now()) {
                None -> {
                    return Err(common.ApiError.Unauthenticated)
                }
                identity -> {
                    return Ok(identity)
                }
            }
        }
    }
}
