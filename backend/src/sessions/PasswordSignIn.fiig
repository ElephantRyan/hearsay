use abs.recommendations.signin
use abs.recommendations.common

// Password sign-in exists unless the server is Authentik-only; then this
// route doesn't, as far as a caller can tell.
workflow passwordSignIn(input: PasswordLogin) -> Result<Session, common.ApiError> {
    modes = loadSignInModes()
    if not modes.password {
        return Err(common.ApiError.NotFound("password sign-in on this server"))
    }
    identity = mapErr(e in signIn(signin.SignInAttempt.Password(input.username, input.password))): apiErrorOfSignIn(e)?
    return Ok(startSession(identity))
}
