// The up_next table: one person's list, read and changed only through here.
capability UpNextRows {
    // The person's list, in their order.
    gateway listOf(userId: string) -> List<UpNextBook> requires Database idempotent {
        return Database.queryMany(
            "SELECT u.item_id, b.library_id, b.title, b.authors, u.position, u.added_at FROM up_next u JOIN book b ON b.item_id = u.item_id WHERE u.user_id = ? ORDER BY u.position, u.added_at",
            userId,
        );
    }

    // Adds a book at the end; one already on the list stays where it is.
    gateway add(userId: string, itemId: string, now: int) -> int requires Database {
        return Database.execute(
            "INSERT INTO up_next (user_id, item_id, position, added_at) VALUES (?, ?, (SELECT COALESCE(MAX(position) + 1, 0) FROM up_next WHERE user_id = ?), ?) ON CONFLICT (user_id, item_id) DO NOTHING",
            userId,
            itemId,
            userId,
            now,
        );
    }

    gateway remove(userId: string, itemId: string) -> int requires Database {
        return Database.execute(
            "DELETE FROM up_next WHERE user_id = ? AND item_id = ?",
            userId,
            itemId,
        );
    }

    gateway place(userId: string, itemId: string, position: int) -> int requires Database {
        return Database.execute(
            "UPDATE up_next SET position = ? WHERE user_id = ? AND item_id = ?",
            position,
            userId,
            itemId,
        );
    }
}
