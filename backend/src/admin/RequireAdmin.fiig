// Who is asking, if they are an Audiobookshelf admin or its owner (root). The
// admin screen and its routes are theirs only.
use hearsay.absclient as client
use hearsay.accounts
use hearsay.sessions

activity requireAdmin(session: string | None) -> Result<accounts.Identity, AdminError> {
    me = mapErr(e in sessions.currentUser(session)): adminErrorOfIdentity(e)?
    if not client.canAdminister(me.userType) {
        return Err(AdminError.NotAdmin)
    }
    return Ok(me)
}
