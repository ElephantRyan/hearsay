use hearsay.settings

// The admin routes of the HTTP surface: settings and a status check, for
// Audiobookshelf admins only. src/Hearsay.fiig serves every domain's adapter together.
adapter http adminApi {
    GET "/admin/settings" -> showSettings(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(view) -> 200 view
        Err(error) -> adminErrorResponse(error)
    }
    PUT "/admin/settings" -> changeSettings(
        session: string | None from cookie "sid",
        change: settings.SettingsChange,
    )
        consumes "application/json"
        produces "application/json"
    {
        Ok(view) -> 200 view
        Err(error) -> adminErrorResponse(error)
    }
    DELETE "/admin/settings/{name}" -> resetSetting(
        session: string | None from cookie "sid",
        name: string,
    )
        produces "application/json"
    {
        Ok(view) -> 200 view
        Err(error) -> adminErrorResponse(error)
    }
    POST "/admin/library-index" -> rebuildIndex(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(summary) -> 200 summary
        Err(error) -> adminErrorResponse(error)
    }
    GET "/admin/status" -> showStatus(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(status) -> 200 status
        Err(error) -> adminErrorResponse(error)
    }
}
