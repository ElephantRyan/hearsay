use hearsay.accounts
use hearsay.settings

// DELETE /admin/settings/{name}: back to the environment's value.
workflow resetSetting(
    admin: accounts.Admin,
    name: string,
) -> Result<settings.SettingsView, AdminError> {
    mapErr(e in settings.forgetSetting(name, admin.identity.userId)): adminErrorOfChange(e)?;
    return Ok(settings.describeSettings());
}
