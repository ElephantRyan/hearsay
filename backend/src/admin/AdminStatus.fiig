// What the admin screen says about Audiobookshelf. `abs` is "reachable",
// "unreachable" or "not set up". The service account is who this server's token
// belongs to; `problem` says in words why it couldn't be checked.
model AdminStatus {
    abs: string
    serviceAccount: string | None
    serviceAccountType: string | None
    problem: string | None
}
