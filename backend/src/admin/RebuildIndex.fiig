use hearsay.accounts
use hearsay.matching
use hearsay.settings

// POST /admin/library-index: rebuild the index linked servers' books are
// matched against, and say how many books can be recognised and how.
workflow rebuildIndex(admin: accounts.Admin) -> Result<matching.IndexSummary, AdminError> {
    return mapErr(e in matching.indexLibrary()): adminErrorOfFault(e);
}
