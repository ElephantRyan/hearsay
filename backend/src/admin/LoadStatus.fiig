use hearsay.absclient as client;
use hearsay.absclient.AbsServer;
use hearsay.absclient.members.AbsMembers;
use hearsay.settings;
use hearsay.signin.authentik.AuthentikSignIn;

// Is Audiobookshelf there, does this server's token work, and does Authentik
// answer? Asks each of them every time.
activity loadStatus() -> AdminStatus {
    return withAuthentik(absStatus(), authentikStatus());
}

private {
    absStatus() -> AdminStatus {
        return match (settings.absUrl()) {
            None -> {
                return status("not set up", None, None, "No Audiobookshelf address is set.");
            },

            url -> {
                return match (AbsServer.status(url)) {
                    Err(_) -> {
                        return status(
                            "unreachable",
                            None,
                            None,
                            "Audiobookshelf didn't answer at that address."
                        );
                    },

                    Ok(_) -> {
                        return withAccount(url);
                    }
                }
            }
        }
    }

    withAccount(url: string) -> AdminStatus {
        return match (settings.serviceToken()) {
            None -> {
                return status("reachable", None, None, "No Audiobookshelf token is set.");
            },

            token -> {
                return match (AbsMembers.meAsService()) {
                    Ok(user) -> {
                        return status("reachable", user.username, user.type, None);
                    },

                    Err(error) -> {
                        return status("reachable", None, None, tokenProblem(error));
                    }
                }
            }
        }
    }

    authentikStatus() -> string {
        return match (settings.oidcSettingsOf()) {
            None -> {
                return "not set up";
            },

            oidc -> {
                return match (AuthentikSignIn.discover(oidc)) {
                    Ok(_) -> {
                        return "answering";
                    },

                    Err(_) -> {
                        return "not answering";
                    }
                }
            }
        }
    }

    status(
        abs: string,
        account: string | None,
        accountType: client.AbsUserType | None,
        problem: string | None)
            -> AdminStatus {
        return AdminStatus(
            abs: abs,
            authentik: "not set up",
            serviceAccount: account,
            serviceAccountType: accountType,
            problem: problem
        );
    }

    withAuthentik(found: AdminStatus, authentik: string) -> AdminStatus {
        return AdminStatus(
            abs: found.abs,
            authentik: authentik,
            serviceAccount: found.serviceAccount,
            serviceAccountType: found.serviceAccountType,
            problem: found.problem
        );
    }

    // Short, safe words for a failed token check. Never the token or a body.
    tokenProblem(error: client.AbsError) -> string {
        return match (error) {
            client.AbsError.NotFound -> "Audiobookshelf answered 404 to /api/me.",
            client.AbsError.Unauthorized -> "Audiobookshelf refused the token.",
            client.AbsError.Rejected(status) -> "Audiobookshelf answered ${status} to the token.",
            client.AbsError.Unreachable(failure) -> "Audiobookshelf stopped answering.",
            client.AbsError.Unreadable(failure) -> "Audiobookshelf's answer couldn't be read.",
            client.AbsError.NotSetUp(missing) -> "No Audiobookshelf token is set."
        }
    }
}
