use abs.recommendations.absclient as client

// A step several features need. It knows nothing about why it was called:
// what a missing book means is the workflow's to say.
activity loadUserAndBook(session: string | None, itemId: string) -> Result<UserAndBook, ApiError> {
    me = currentUser(session)?
    book = fetchBook(itemId)?
    return Ok(UserAndBook(user: me, book: book))
}
