use abs.recommendations.signin

// The identity behind a live session, or None if the token is unknown or past
// its expiry.
gateway findSession(tokenHash: string, now: int) -> signin.Identity | None
    requires Database
    idempotent
{
    return Database.queryOne(
        "SELECT user_id AS userId, username, user_type AS userType FROM session WHERE token_hash = ? AND expires_at > ?",
        tokenHash,
        now,
    )
}
