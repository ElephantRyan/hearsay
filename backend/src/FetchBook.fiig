// One book from ABS, with the server's token. ABS's failures become the app's
// errors here, once: a 404 is "no such book", anything else is "unavailable".
use abs.recommendations.absclient as client
use abs.recommendations.absclient.AbsApi

gateway fetchBook(itemId: string) -> Result<client.Book, ApiError>
    requires AbsApi
{
    return mapErr(e in AbsApi.itemAsService(itemId)): apiErrorOfAbs(e)
}
