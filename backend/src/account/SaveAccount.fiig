use hearsay.accounts;

// Saves a person's settings, making their app_user row if they have none yet.
// Their username is kept as ABS has it.
gateway saveAccount(user: accounts.Identity, account: Account) -> int requires Database {
    return Database.execute(
        "INSERT INTO app_user (user_id, username, display_name, last_seen_at, share_notes_default, skip_rated_series) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT (user_id) DO UPDATE SET display_name = excluded.display_name, share_notes_default = excluded.share_notes_default, skip_rated_series = excluded.skip_rated_series",
        user.userId,
        user.username,
        account.displayName,
        Clock.now(),
        account.shareNotesByDefault,
        account.skipRatedSeriesBooks,
    );
}
