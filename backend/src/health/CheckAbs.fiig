// M3's exit check: sign in, ask ABS who we are, and look up one book.
use abs.recommendations.absclient as client
use abs.recommendations.absclient.AbsCatalog
use abs.recommendations.absclient.AbsMembers

activity checkAbs(username: string, password: string, itemId: string) -> Result<AbsCheck, client.AbsError> {
    session = AbsMembers.login(username, password)?
    user = AbsMembers.me(session.accessToken)?
    book = AbsCatalog.item(session.accessToken, itemId)?
    return Ok(AbsCheck(username: user.username, userType: user.type, title: book.title))
}
