use hearsay.absclient;

// Reads every cached series from ABS again: its name, author line, and books in
// order (so its book 1 too). One ABS no longer has is forgotten, ratings and
// all; if ABS can't be asked at all, the refresh stops there.
activity refreshSeries() -> Result<SeriesRefreshed, absclient.AbsFault> {
    read: int = 0;
    removed: int = 0;
    for (seriesId in cachedSeriesIds()) {
        match (fetchSeries(seriesId)) {
            Ok(series) -> {
                saveSeriesCache(series, Clock.now());
                read = read + 1;
            },

            Err(absclient.AbsFault.Missing) -> {
                forgetSeries(seriesId);
                removed = removed + 1;
            },

            Err(fault) -> {
                return Err(fault);
            }
        }
    }

    return Ok(SeriesRefreshed(read: read, removed: removed));
}
