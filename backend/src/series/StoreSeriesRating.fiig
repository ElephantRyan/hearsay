use hearsay.absclient.catalog;
use hearsay.accounts;
use hearsay.ratings;

// Stores a checked rating of a series and returns what is now stored. The
// person, the series (with its books, to fold them into it) and the rating are
// written in one transaction.
activity storeSeriesRating(
    user: accounts.Identity,
    series: catalog.CatalogSeries,
    checked: ratings.CheckedRating)
        -> SeriesRating {
    now = Clock.now();
    rating = SeriesRating(
        userId: user.userId,
        seriesId: series.seriesId,
        score: checked.score,
        note: checked.note,
        noteShared: checked.noteShared,
        recommended: checked.recommended,
        createdAt: now,
        updatedAt: now,
    );
    transaction Database {
        upsertSeriesUser(user.userId, user.username, now);
        saveSeriesCache(series, now);
        saveSeriesRating(rating);
    }

    return findSeriesRating(user.userId, series.seriesId) ?? rating;
}
