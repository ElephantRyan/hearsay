// The first run: proves the person is an admin of the Audiobookshelf at that
// address, then saves the address. Nothing is saved for anyone else.
use hearsay.absclient as client
use hearsay.absclient.members.AbsMembers
use hearsay.accounts
use hearsay.common
use hearsay.settings
use hearsay.signin.password as passwordSignIn

activity claimServer(url: string, username: string, password: string) -> Result<accounts.Identity, common.ApiError> {
    if settings.absUrl() != None {
        return Err(common.ApiError.Refused("this server is already set up; sign in instead"))
    }
    session = mapErr(e in AbsMembers.login(url, username, password)): setupErrorOfAbs(e)?
    identity = passwordSignIn.identityOfSession(session)
    if not client.canAdminister(identity.userType) {
        return Err(common.ApiError.Refused("only an Audiobookshelf admin can set up this server"))
    }
    settings.rememberSetting("abs.url", url, identity.userId)
    return Ok(identity)
}

private {
    // What went wrong, in words for the setup page. Never a password or a body.
    setupErrorOfAbs(error: client.AbsError) -> common.ApiError {
        match error {
            client.AbsError.Unauthorized -> common.ApiError.Refused("that username or password wasn't right")
            client.AbsError.NotFound -> common.ApiError.Invalid("absUrl", "doesn't look like an Audiobookshelf server")
            client.AbsError.Rejected(status) -> common.ApiError.Invalid("absUrl", "answered ${status}")
            client.AbsError.Unreachable(failure) -> common.ApiError.Invalid("absUrl", "didn't answer")
            client.AbsError.Unreadable(failure) -> common.ApiError.Invalid("absUrl", "doesn't look like an Audiobookshelf server")
        }
    }
}
