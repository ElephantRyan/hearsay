// Who ABS says this username and password belong to. Nothing is saved.
use hearsay.absclient as client;
use hearsay.absclient.members.AbsMembers;
use hearsay.accounts;
use hearsay.signin.password as passwordSignIn;

activity loginToAbs(
    url: string,
    username: string,
    password: string,
) -> Result<accounts.Identity, client.AbsFault> {
    session = mapErr(e in AbsMembers.login(url, username, password)): client.faultOfAbs(e)?;
    return Ok(passwordSignIn.identityOfSession(session));
}
