// The HTTP surface (PLAN.md section 4).
// fiig serve -workspace .. -caps caps.json -env-file .env . api   (see serve-dev.sh)
adapter http api {
    GET "/health" -> healthCheck()
        produces "application/json"
    {
        Ok(status) -> 200 status
        Err(error) -> apiErrorResponse(error)
    }
    GET "/auth/modes" -> showSignInModes()
        produces "application/json"
    {
        Ok(modes) -> 200 modes
        Err(error) -> apiErrorResponse(error)
    }
    GET "/auth/login" -> startOidc()
        produces "application/json"
    {
        Ok(start) -> redirectToIdp(start)
        Err(error) -> apiErrorResponse(error)
    }
    GET "/auth/callback?code={code}&state={state}&error={error}" -> finishOidc(
        code: string | None,
        state: string | None,
        error: string | None,
        pending: string | None from cookie "oidc",
    )
        produces "application/json"
    {
        landing -> landed(landing)
    }
    POST "/session" -> passwordSignIn(input: PasswordLogin)
        consumes "application/json"
        produces "application/json"
    {
        Ok(session) -> signedIn(session)
        Err(error) -> apiErrorResponse(error)
    }
    DELETE "/session" -> endSession(session: string | None from cookie "sid")
        produces "application/json"
    {
        _ -> signedOut()
    }
    GET "/me" -> whoAmI(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(identity) -> 200 identity
        Err(error) -> apiErrorResponse(error)
    }
    PUT "/ratings/{itemId}" -> putRating(
        session: string | None from cookie "sid",
        itemId: string,
        input: RatingInput,
    )
        consumes "application/json"
        produces "application/json"
    {
        Ok(rating) -> 200 rating
        Err(error) -> apiErrorResponse(error)
    }
    DELETE "/ratings/{itemId}" -> deleteMyRating(
        session: string | None from cookie "sid",
        itemId: string,
    )
        produces "application/json"
    {
        Ok(_) -> 204
        Err(error) -> apiErrorResponse(error)
    }
    GET "/ratings/mine?sort={sort}" -> listMyRatings(
        session: string | None from cookie "sid",
        sort: string | None,
    )
        produces "application/json"
    {
        Ok(rows) -> 200 rows
        Err(error) -> apiErrorResponse(error)
    }
    GET "/recommendations?userId={userId}&libraryId={libraryId}&minScore={minScore}" -> listRecommendations(
        session: string | None from cookie "sid",
        userId: string | None,
        libraryId: string | None,
        minScore: int | None,
    )
        produces "application/json"
    {
        Ok(books) -> 200 books
        Err(error) -> apiErrorResponse(error)
    }
    GET "/recommendations/users" -> listRecommenderUsers(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(people) -> 200 people
        Err(error) -> apiErrorResponse(error)
    }
    GET "/recommendations/users/{userId}" -> listPicksOf(
        session: string | None from cookie "sid",
        userId: string,
    )
        produces "application/json"
    {
        Ok(rows) -> 200 rows
        Err(error) -> apiErrorResponse(error)
    }
    GET "/libraries" -> showLibraries(session: string | None from cookie "sid")
        produces "application/json"
    {
        Ok(libraries) -> 200 libraries
        Err(error) -> apiErrorResponse(error)
    }
    GET "/libraries/{libraryId}/items?page={page}&size={size}&q={q}" -> showLibraryItems(
        session: string | None from cookie "sid",
        libraryId: string,
        page: int | None,
        size: int | None,
        q: string | None,
    )
        produces "application/json"
    {
        Ok(result) -> 200 result
        Err(error) -> apiErrorResponse(error)
    }
    POST "/sync?userId={userId}&dryRun={dryRun}" -> syncCollections(
        session: string | None from cookie "sid",
        userId: string | None,
        dryRun: bool | None,
    )
        produces "application/json"
    {
        Ok(results) -> 200 results
        Err(error) -> apiErrorResponse(error)
    }
    GET "/items/{itemId}" -> showItem(session: string | None from cookie "sid", itemId: string)
        produces "application/json"
    {
        Ok(detail) -> 200 detail
        Err(error) -> apiErrorResponse(error)
    }
}
