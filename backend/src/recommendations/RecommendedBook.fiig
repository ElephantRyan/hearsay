// A book's standing across everyone who recommended it: how many did, and the
// average of the scores they gave (None when nobody gave one). A recommended
// series is one too: seriesId is set, itemId is its book 1 (whose cover stands
// for it), title the series' name, and seriesBooks how many books it has.
model RecommendedBook {
    itemId: string;
    libraryId: string;
    title: string;
    authors: string;
    average: decimal | None;
    count: int;
    latest: int;
    seriesId: string | None;
    seriesBooks: int;
}
