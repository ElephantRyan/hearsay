use hearsay.ratings.rated;

// One person's list ("Ryan Recommends"): their recommended books, best first.
rule bestFirst(rows: List<rated.RatingRow>, userId: string) -> List<rated.RatingRow> {
    theirs = filter(r in rows): r.userId == userId && r.recommended;
    return sorted(r in theirs): r.score descending then r.updatedAt descending;
}
