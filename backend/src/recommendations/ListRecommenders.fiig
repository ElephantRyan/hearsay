use hearsay.links;
use hearsay.series.SeriesRatings;

// Everyone with published recommendations, books and series counted together.
activity listRecommenders() -> List<Recommender> {
    picks = SeriesRatings.recommended();
    folded = collapseSeries(links.everyRecommendation(), picks, SeriesRatings.books());
    return recommendersOf(folded, picks);
}
