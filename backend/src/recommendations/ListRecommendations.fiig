use hearsay.sessions

workflow listRecommendations(session: string | None, userId: string | None, libraryId: string | None, minScore: int | None) -> Result<List<RecommendedBook>, RecommendationError> {
    mapErr(e in sessions.currentUser(session)): recommendationErrorOfIdentity(e)?
    return Ok(recommendations(userId, libraryId, minScore))
}
