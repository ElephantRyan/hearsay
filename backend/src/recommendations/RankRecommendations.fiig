use hearsay.ratings.rated;
use hearsay.ratings.rated.scores;

// Ranks books by how many people recommend them, most first. Ties go to the
// higher average score (a book nobody scored after any that were), then to the
// most recently rated. Private ratings are not counted (PLAN.md section 4).
// This is the one rule to change if the order should.
rule rankRecommendations(rows: List<rated.RatingRow>) -> List<RecommendedBook> {
    recommended = filter(r in rows): r.recommended;
    groups = groupBy(r in recommended): r.itemId;
    books: List<RecommendedBook> = [];
    for (itemId, group in groups) {
        first = group.at(0);
        books = append(
            books,
            RecommendedBook(
                itemId: itemId,
                libraryId: first.libraryId,
                title: first.title,
                authors: first.authors,
                average: scores.average(group),
                count: group.length(),
                latest: max(r in group): r.updatedAt,
            ),
        );
    }

    return sorted(book in books): book.count descending then (book.average ?? math.toDecimal(0)) descending then book.latest descending;
}
