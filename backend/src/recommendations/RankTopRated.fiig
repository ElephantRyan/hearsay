use hearsay.ratings.rated;
use hearsay.ratings.rated.scores;

// Ranks books by the average score of their recommended ratings, highest first,
// for "Top 25 Rated". A book needs at least two scores, so one person's 10
// can't top it. Ties go to the book more people scored, then to the most
// recently rated. Private ratings are not counted, as everywhere else.
rule rankTopRated(rows: List<rated.RatingRow>) -> List<RecommendedBook> {
    scored = filter(r in rows): r.recommended && r.score != None;
    groups = groupBy(r in scored): r.itemId;
    books: List<RecommendedBook> = [];
    for (itemId, group in groups) {
        if (group.length() >= 2) {
            first = group.at(0);
            books = append(
                books,
                RecommendedBook(
                    itemId: itemId,
                    libraryId: first.libraryId,
                    title: first.title,
                    authors: first.authors,
                    average: scores.average(group),
                    count: group.length(),
                    latest: max(r in group): r.updatedAt,
                ),
            );
        }
    }

    return sorted(book in books): (book.average ?? math.toDecimal(0)) descending then book.count descending then book.latest descending;
}
