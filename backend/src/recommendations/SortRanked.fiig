// Books and series together in the ranked list's order: most recommended first,
// then the higher average (none after any), then the most recent.
rule sortRanked(entries: List<RecommendedBook>) -> List<RecommendedBook> {
    return sorted(e in entries): e.count descending then (e.average ?? math.toDecimal(0)) descending then e.latest descending;
}
