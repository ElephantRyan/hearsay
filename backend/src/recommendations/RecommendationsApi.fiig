use hearsay.accounts
use hearsay.sessions

// The recommendations routes of the HTTP surface; src/Hearsay.fiig serves every
// domain's adapter together. All of them need a signed-in person.
adapter http recommendationsApi {
    principal me: accounts.Identity from cookie "sid" by sessions.signedIn else sessions.identityErrorResponse

    GET "/recommendations?userId={userId}&libraryId={libraryId}&minScore={minScore}" -> listRecommendations(
        me,
        userId: string | None,
        libraryId: string | None,
        minScore: int | None,
    )
        produces "application/json"
    {
        books -> 200 books
    }
    GET "/recommendations/users" -> listRecommenderUsers(me)
        produces "application/json"
    {
        people -> 200 people
    }
    GET "/recommendations/users/{userId}" -> listPicksOf(me, userId: string)
        produces "application/json"
    {
        rows -> 200 rows
    }
    GET "/recommendations/users/{userId}/missing" -> listMissingOf(me, userId: string)
        produces "application/json"
    {
        books -> 200 books
    }
}
