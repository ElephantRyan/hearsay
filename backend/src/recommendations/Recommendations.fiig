use hearsay.common
use hearsay.ratings.rated.RatedBooks
use hearsay.sessions

activity recommendations(session: string | None, userId: string | None, libraryId: string | None, minScore: int | None) -> Result<List<RecommendedBook>, common.ApiError> {
    sessions.currentUser(session)?
    rows = filterRows(RatedBooks.recommended(), userId, libraryId)
    return Ok(atLeast(rankRecommendations(rows), minScore))
}
