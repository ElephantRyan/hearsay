// One recommendation as it crosses to a linked server (LINKED.md section 2):
// what recognises the book, the rating, and who made it. personId is opaque:
// the same person gets the same one each time, but it isn't their ABS id.
model SharedRating {
    personId: string;
    username: string;
    asin: string | None;
    isbn: string | None;
    title: string;
    authors: string;
    score: int | None;
    note: string;
    updatedAt: int;
}
