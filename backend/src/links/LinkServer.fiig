use hearsay.accounts;
use hearsay.settings;

// POST /admin/links: takes up another server's invite with its link code, then
// fetches its recommendations and asks it to fetch this server's, so both
// show the other's straight away. The library index is made ready before the
// other server is contacted, so a link is never made that can't match books.
workflow linkServer(
    admin: accounts.Admin,
    request: LinkRequest,
) -> Result<LinkedServer, LinkError> {
    return match (settings.serverName()) {
        None -> {
            return Err(LinkError.NoServerName);
        },

        name -> {
            invite = inviteCodeOf(request.code)?;
            readyIndex()?;
            link = takeUpInvite(invite, name, admin.identity.userId)?;
            return fetchNewLink(link.id);
        },
    }
}
