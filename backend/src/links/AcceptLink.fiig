use hearsay.settings

// POST /federation/link: another server takes up this server's invite. The
// invite is checked and spent before anything else, so a caller without one
// learns nothing more.
workflow acceptLink(offer: LinkOffer) -> Result<LinkAcceptance, FederationError> {
    if not spendInvite(offer.secret) {
        return Err(FederationError.BadInvite)
    }
    match settings.serverName() {
        None -> {
            return Err(FederationError.NoServerName)
        }
        name -> {
            return keepLink(checkOffer(offer)?, name)
        }
    }
}
