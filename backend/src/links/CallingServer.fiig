// Which linked server is calling, from the key in its "Authorization: Bearer
// <key>" header: settled once per request, by the adapter, before the request
// is read. The runtime strips the scheme (ADR 0144), so a header that is
// missing or isn't a bearer key arrives as None and is refused before any lookup.
workflow callingServer(key: string | None) -> Result<LinkedServer, PeerRefusal> {
    return match (key) {
        None -> {
            return Err(PeerRefusal.NoKey);
        },

        given -> {
            return match (linkWithKey(given)) {
                None -> {
                    return Err(PeerRefusal.UnknownKey);
                },

                link -> {
                    return Ok(link);
                }
            }
        }
    }
}
