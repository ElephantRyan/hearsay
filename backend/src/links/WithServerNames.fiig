use hearsay.ratings.rated

// A linked server's person keeps their name unless someone else among
// `everyone` has it too, here or on another linked server: then their server's
// name goes after it, "ryan · Alex's library" (LINKED.md section 6). This
// server's own people are never marked.
rule withServerNames(
    rows: List<rated.RatingRow>,
    everyone: List<rated.RatingRow>,
) -> List<rated.RatingRow> {
    byName = groupBy(r in everyone): r.username.lowercase();
    return map(row in rows): named(row, byName.atOrNone(row.username.lowercase()));
}

private {
    named(row: rated.RatingRow, sameName: List<rated.RatingRow> | None) -> rated.RatingRow {
        return match (row.via) {
            None -> {
                return row;
            }

            server -> {
                return match (sameName) {
                    None -> {
                        return row;
                    }

                    others -> {
                        if ((filter(o in others): o.userId != row.userId).length() == 0) {
                            return row;
                        }

                        return copy(row, username: "${row.username} · ${server}");
                    }
                }
            }
        }
    }
}
