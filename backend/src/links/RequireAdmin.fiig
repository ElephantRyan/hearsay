// Who is asking, if they are an Audiobookshelf admin or its owner (root).
// Linking servers is theirs only.
use hearsay.absclient as client
use hearsay.accounts
use hearsay.sessions

activity requireAdmin(session: string | None) -> Result<accounts.Identity, LinkError> {
    me = mapErr(e in sessions.currentUser(session)): linkErrorOfIdentity(e)?
    if not client.canAdminister(me.userType) {
        return Err(LinkError.NotAdmin)
    }
    return Ok(me)
}
