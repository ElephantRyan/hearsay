// The linked server that calls with the key behind this hash, if any.
gateway linkOfKeyHash(keyInHash: string) -> LinkedServer | None
    requires Database
    idempotent
{
    return Database.queryOne(
        "SELECT id, name, address, linked_at, linked_by, last_fetched_at, ratings, matched, not_answering_since, problem FROM linked_server WHERE key_in_hash = ?",
        keyInHash,
    )
}
