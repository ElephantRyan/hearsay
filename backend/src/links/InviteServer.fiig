use hearsay.settings

// POST /admin/links/invite: a link code for another server's admin, good once
// and for 24 hours. Linking waits for this server to have a name, and for its
// library index, built now if it never has been: the other server asks this
// one to fetch as soon as it links, and that fetch has to be quick.
workflow inviteServer(session: string | None) -> Result<LinkInvite, LinkError> {
    me = requireAdmin(session)?
    if settings.serverName() == None {
        return Err(LinkError.NoServerName)
    }
    readyIndex()?
    return Ok(openInvite(me.userId))
}
