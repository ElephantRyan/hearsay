use hearsay.matching;
use hearsay.settings;

// Rebuilds the library index from Audiobookshelf, so new books can be matched.
// On failure the old index stays, and this says why in words.
activity rebuildIndex() -> Result<matching.IndexSummary, string> {
    return mapErr(e in matching.indexLibrary()): indexProblemOfFault(e);
}
