// Which linked server is calling, from its "Authorization: Bearer <key>"
// header. Every federation route but taking up an invite starts here.
activity linkOfKey(authorization: string | None) -> Result<LinkedServer, FederationError> {
    match authorization {
        None -> {
            return Err(FederationError.NoKey)
        }
        given -> {
            if not given.startsWith("Bearer ") {
                return Err(FederationError.NoKey)
            }
            match linkOfKeyHash(keyHash(given.removePrefix("Bearer ").trim())) {
                None -> {
                    return Err(FederationError.UnknownKey)
                }
                link -> {
                    return Ok(link)
                }
            }
        }
    }
}
