// Every way an admin's linking request can be refused, as values the caller
// must handle. The Peer* ones are the other server's answer, or its silence;
// IndexUnavailable is this server's own library index, which matching needs.
// Who is asking, and whether they may administer, are the adapter's to settle.
enum LinkError {
    NoServerName,
    Invalid(field: string, reason: string),
    AlreadyLinked(name: string),
    UnknownLink,
    PeerUnreachable,
    PeerLoginPage,
    PeerRefused(reason: string),
    IndexUnavailable(detail: string),
}
