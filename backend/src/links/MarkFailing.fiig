// A fetch that didn't work. What was fetched before is kept; the first failure
// in a row sets since when the server hasn't answered.
gateway markFailing(id: string, now: int, problem: string) -> int requires Database {
    return Database.execute(
        "UPDATE linked_server SET not_answering_since = COALESCE(not_answering_since, ?), problem = ? WHERE id = ?",
        now,
        problem,
        id
    );
}
