use hearsay.ratings.rated
use hearsay.ratings.rated.RatedBooks

// Every recommended rating, this server's and linked servers' alike (those of
// books this library has), with linked names marked where they clash. What
// averages, the ranked list, recommenders and picks are made from.
activity everyRecommendation() -> List<rated.RatingRow> {
    everyone = RatedBooks.recommended().concat(LinkedRatings.matched());
    return withServerNames(everyone, everyone);
}
