// Whether this server may write collections into ABS at all (PLAN.md section 8):
// saved in the app, or else MIRROR_ENABLED. topCollections adds the server-wide
// "Top 25 Recommended" and "Top 25 Rated" collections to every library.
wire SyncConfig {
    mirrorEnabled: bool from setting "sync.mirrorEnabled" ?? env "MIRROR_ENABLED" = false;
    topCollections: bool from setting "sync.topCollections" ?? env "TOP_COLLECTIONS" = false;
}
