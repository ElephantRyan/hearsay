// How people sign in, from the environment (PLAN.md section 8). authMode is
// which sign-in routes answer. frontendUrl is where a
// finished Authentik sign-in lands. A value an admin saves in the app wins
// (authMode, frontendUrl).
wire SignInConfig {
    authMode: AuthMode from env "AUTH_MODE" = AuthMode.Both
    frontendUrl: string from env "FRONTEND_URL" = "http://localhost:5173"
}
