// How people sign in (PLAN.md section 8), saved in the app or else from the
// environment. authMode is which sign-in routes answer. frontendUrl is where a
// finished Authentik sign-in lands.
wire SignInConfig {
    authMode: AuthMode from setting "signin.authMode" ?? env "AUTH_MODE" = AuthMode.Both;
    frontendUrl: string from setting "signin.frontendUrl" ?? env "FRONTEND_URL" = "http://localhost:5173";
}
