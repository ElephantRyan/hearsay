// The settings as they stand, and where each comes from. Never a secret's value.
activity describeSettings() -> SettingsView {
    return SettingsView(
        absUrl: textSetting(storedText("abs.url"), Abs.url),
        serviceToken: secretSetting(storedText("abs.serviceToken"), "abs.serviceToken"),
        mirrorEnabled: textSetting(storedText("sync.mirrorEnabled"), boolText(SyncConfig.mirrorEnabled)),
        authMode: textSetting(storedText("signin.authMode"), SignInConfig.authMode),
        frontendUrl: textSetting(storedText("signin.frontendUrl"), SignInConfig.frontendUrl),
        oidcIssuer: textSetting(storedText("oidc.issuer"), Oidc.issuer),
        oidcClientId: textSetting(storedText("oidc.clientId"), Oidc.clientId),
        oidcClientSecret: secretSetting(storedText("oidc.clientSecret"), "oidc.clientSecret"),
        oidcRedirectUri: textSetting(storedText("oidc.redirectUri"), Oidc.redirectUri),
    )
}

private {
    textSetting(saved: string | None, env: string | None) -> SettingValue {
        match saved {
            None -> {
                match env {
                    None -> {
                        return SettingValue(value: None, source: "unset")
                    }
                    given -> {
                        return SettingValue(value: given, source: "environment")
                    }
                }
            }
            given -> {
                return SettingValue(value: given, source: "saved")
            }
        }
    }

    // The environment is read only when nothing is saved.
    secretSetting(saved: string | None, name: string) -> SettingValue {
        match saved {
            None -> {
                if envSecretSet(name) {
                    return SettingValue(value: None, source: "environment")
                }
                return SettingValue(value: None, source: "unset")
            }
            given -> {
                return SettingValue(value: None, source: "saved")
            }
        }
    }

    envSecretSet(name: string) -> bool {
        if name == "abs.serviceToken" {
            match AbsService.token {
                None -> {
                    return false
                }
                given -> {
                    return true
                }
            }
        }
        match Oidc.clientSecret {
            None -> {
                return false
            }
            given -> {
                return true
            }
        }
    }

    boolText(on: bool) -> string {
        if on {
            return "true"
        }
        return "false"
    }
}
