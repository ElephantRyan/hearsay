// The settings as they stand, and where each comes from. Never a secret's value.
activity describeSettings() -> SettingsView {
    return SettingsView(
        absUrl: shown(Abs.url, SettingName.AbsUrl),
        serviceToken: hidden(SettingName.ServiceToken),
        mirrorEnabled: shown(boolText(SyncConfig.mirrorEnabled), SettingName.MirrorEnabled),
        topSeries: shown(boolText(SyncConfig.topSeries), SettingName.TopSeries),
        topStandalones: shown(boolText(SyncConfig.topStandalones), SettingName.TopStandalones),
        refreshHourUtc: shown("${SyncConfig.refreshHourUtc}", SettingName.RefreshHourUtc),
        authMode: shown(authModeText(SignInConfig.authMode), SettingName.AuthMode),
        frontendUrl: shown(SignInConfig.frontendUrl, SettingName.FrontendUrl),
        oidcIssuer: shown(Oidc.issuer, SettingName.OidcIssuer),
        oidcClientId: shown(Oidc.clientId, SettingName.OidcClientId),
        oidcClientSecret: hidden(SettingName.OidcClientSecret),
        oidcRedirectUri: shown(Oidc.redirectUri, SettingName.OidcRedirectUri),
        serverName: shown(ServerConfig.name, SettingName.ServerName),
    );
}

private {
    shown(value: string | None, name: SettingName) -> SettingValue {
        return SettingValue(value: value, source: sourceText(settingSourceOf(name)));
    }

    hidden(name: SettingName) -> SettingValue {
        return SettingValue(value: None, source: sourceText(settingSourceOf(name)));
    }

    boolText(on: bool) -> string {
        if (on) {
            return "true";
        }

        return "false";
    }
}
