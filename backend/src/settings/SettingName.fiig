// Each setting an admin can save in the app, as the admin screen names it.
enum SettingName {
    AbsUrl,
    ServiceToken,
    MirrorEnabled,
    TopSeries,
    TopStandalones,
    RefreshHourUtc,
    AuthMode,
    FrontendUrl,
    OidcIssuer,
    OidcClientId,
    OidcClientSecret,
    OidcRedirectUri,
    ServerName
}
