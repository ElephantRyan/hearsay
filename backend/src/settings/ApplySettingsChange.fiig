// Saves every setting a checked change gives; `by` is the admin's user id.
activity applySettingsChange(change: SettingsChange, by: string)
        -> Result<None, SettingsChangeError> {
    mapErr(e in saveGiven(SettingName.AbsUrl, change.absUrl, by)):
            settingsChangeErrorOf("absUrl", e)?;
    mapErr(e in saveGiven(SettingName.ServiceToken, change.serviceToken, by)):
            settingsChangeErrorOf("serviceToken", e)?;
    mapErr(e in saveGiven(SettingName.MirrorEnabled, boolText(change.mirrorEnabled), by)):
            settingsChangeErrorOf("mirrorEnabled", e)?;
    mapErr(e in saveGiven(SettingName.TopSeries, boolText(change.topSeries), by)):
            settingsChangeErrorOf("topSeries", e)?;
    mapErr(e in saveGiven(SettingName.TopStandalones, boolText(change.topStandalones), by)):
            settingsChangeErrorOf("topStandalones", e)?;
    mapErr(e in saveGiven(SettingName.RefreshHourUtc, hourText(change.refreshHourUtc), by)):
            settingsChangeErrorOf("refreshHourUtc", e)?;
    mapErr(e in saveGiven(SettingName.AuthMode, modeText(change.authMode), by)):
            settingsChangeErrorOf("authMode", e)?;
    mapErr(e in saveGiven(SettingName.FrontendUrl, change.frontendUrl, by)):
            settingsChangeErrorOf("frontendUrl", e)?;
    mapErr(e in saveGiven(SettingName.OidcIssuer, change.oidcIssuer, by)):
            settingsChangeErrorOf("oidcIssuer", e)?;
    mapErr(e in saveGiven(SettingName.OidcClientId, change.oidcClientId, by)):
            settingsChangeErrorOf("oidcClientId", e)?;
    mapErr(e in saveGiven(SettingName.OidcClientSecret, change.oidcClientSecret, by)):
            settingsChangeErrorOf("oidcClientSecret", e)?;
    mapErr(e in saveGiven(SettingName.OidcRedirectUri, change.oidcRedirectUri, by)):
            settingsChangeErrorOf("oidcRedirectUri", e)?;
    mapErr(e in saveGiven(SettingName.ServerName, change.serverName, by)):
            settingsChangeErrorOf("serverName", e)?;
    return Ok(None);
}

private {
    hourText(hour: int | None) -> string | None {
        return match (hour) {
            None -> None,
            given -> "${given}",
        }
    }

    saveGiven(name: SettingName, text: string | None, by: string) -> Result<None, SettingError> {
        return match (text) {
            None -> Ok(None),
            given -> saveSetting(name, given, by),
        }
    }

    boolText(on: bool | None) -> string | None {
        return match (on) {
            None -> None,
            true -> "true",
            false -> "false",
        }
    }

    modeText(mode: AuthMode | None) -> string | None {
        return match (mode) {
            None -> None,
            given -> authModeText(given),
        }
    }
}
