// The mode a saved setting spells, or None if it spells none.
conversion authModeOfText(text: string) -> AuthMode | None {
    if (text == "abs") {
        return AuthMode.Abs;
    }

    if (text == "oidc") {
        return AuthMode.Oidc;
    }

    if (text == "both") {
        return AuthMode.Both;
    }

    return None;
}
