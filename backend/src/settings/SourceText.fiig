// A setting's source as the admin screen shows it. A default counts as the
// environment's: nothing was saved and the deployment left it as shipped.
conversion sourceText(source: SettingSource) -> string {
    return match (source) {
        SettingSource.Saved -> "saved"
        SettingSource.Pending -> "saved"
        SettingSource.Deployment -> "environment"
        SettingSource.Default -> "environment"
        SettingSource.Unset -> "unset"
    }
}
