// Authentik-only sign-in can't be chosen until every Authentik setting is there,
// counting the change itself: otherwise nobody could sign in to finish it.
activity checkSignInStaysPossible(change: SettingsChange) -> Result<int, SettingsChangeError> {
    mode = change.authMode ?? currentAuthMode();
    if (mode != AuthMode.Oidc) {
        return Ok(0);
    }

    issuer = change.oidcIssuer ?? storedText("oidc.issuer") ?? Oidc.issuer;
    clientId = change.oidcClientId ?? storedText("oidc.clientId") ?? Oidc.clientId;
    redirectUri = change.oidcRedirectUri ?? storedText("oidc.redirectUri") ?? Oidc.redirectUri;
    if (issuer == None || clientId == None || redirectUri == None || !secretThere(change)) {
        return Err(
            SettingsChangeError.Invalid(
                "authMode",
                "can be Authentik only once every Authentik setting is filled in",
            ),
        );
    }

    return Ok(0);
}

private {
    secretThere(change: SettingsChange) -> bool {
        if (change.oidcClientSecret != None) {
            return true;
        }

        return match (storedSecret("oidc.clientSecret") ?? Oidc.clientSecret) {
            None -> {
                return false;
            }

            given -> {
                return true;
            }
        }
    }
}
