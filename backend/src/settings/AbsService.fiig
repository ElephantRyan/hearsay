// The ABS token this server uses for its own calls: looking up books, reading
// listening progress, writing collections, and (when AUTH_MODE allows Authentik)
// finding a person's account by email. Saved in the app, or else
// ABS_SERVICE_TOKEN. The *AsService gateways read it (absclient.targetOf).
wire AbsService {
    token: Secret | None from setting "abs.serviceToken" ?? env "ABS_SERVICE_TOKEN"
}
