use hearsay.absclient

// Audiobookshelf and this server's own token for it, or the error for a server
// that isn't set up yet.
activity loadAbsTarget() -> Result<absclient.AbsTarget, SettingsError> {
    url = loadAbsUrl()?;
    return match (serviceToken()) {
        None -> {
            return Err(SettingsError.NoServiceToken);
        }

        token -> {
            return Ok(absclient.AbsTarget(url: url, token: token));
        }
    }
}
