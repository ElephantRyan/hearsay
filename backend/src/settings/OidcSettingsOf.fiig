use hearsay.accounts

// The Authentik application, each part saved in the app or else from its
// OIDC_* variable; None until all four are there.
activity oidcSettingsOf() -> accounts.OidcSettings | None {
    return match (storedText("oidc.issuer") ?? Oidc.issuer) {
        None -> {
            return None;
        }

        issuer -> {
            return match (storedText("oidc.clientId") ?? Oidc.clientId) {
                None -> {
                    return None;
                }

                clientId -> {
                    return match (storedText("oidc.redirectUri") ?? Oidc.redirectUri) {
                        None -> {
                            return None;
                        }

                        redirectUri -> {
                            return match (storedSecret("oidc.clientSecret") ?? Oidc.clientSecret) {
                                None -> {
                                    return None;
                                }

                                clientSecret -> {
                                    return accounts.OidcSettings(
                                        issuer: issuer,
                                        clientId: clientId,
                                        clientSecret: clientSecret,
                                        redirectUri: redirectUri,
                                    );
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
