use hearsay.accounts;

// The Authentik application; None until all four parts are there.
activity oidcSettingsOf() -> accounts.OidcSettings | None {
    return match (Oidc.issuer) {
        None -> None,
        issuer -> {
            return match (Oidc.clientId) {
                None -> None,
                clientId -> {
                    return match (Oidc.redirectUri) {
                        None -> None,
                        redirectUri -> {
                            return match (Oidc.clientSecret) {
                                None -> None,
                                clientSecret -> accounts.OidcSettings(
                                    issuer: issuer,
                                    clientId: clientId,
                                    clientSecret: clientSecret,
                                    redirectUri: redirectUri
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}
