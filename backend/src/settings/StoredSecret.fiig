// A saved credential, read back as a Secret so it can't be shown or logged from
// here on (fiig ADR 0126). It prints as Secret(<name>).
gateway storedSecret(name: string) -> Secret | None
    requires Database
    idempotent
{
    found: StoredValue | None = Database.queryOne("SELECT value FROM setting WHERE name = ?", name)
    match found {
        None -> {
            return None
        }
        row -> {
            return row.value.toSecret(name)
        }
    }
}
