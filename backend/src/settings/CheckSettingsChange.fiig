use hearsay.common

// Tidies and checks a change before anything is saved: addresses are http(s)
// URLs with no trailing slash, and no text is blank.
rule checkSettingsChange(change: SettingsChange) -> Result<SettingsChange, common.ApiError> {
    return Ok(
        SettingsChange(
            absUrl: checkUrl("absUrl", change.absUrl)?,
            serviceToken: checkText("serviceToken", change.serviceToken)?,
            mirrorEnabled: change.mirrorEnabled,
            authMode: change.authMode,
            frontendUrl: checkUrl("frontendUrl", change.frontendUrl)?,
            oidcIssuer: checkUrl("oidcIssuer", change.oidcIssuer)?,
            oidcClientId: checkText("oidcClientId", change.oidcClientId)?,
            oidcClientSecret: checkText("oidcClientSecret", change.oidcClientSecret)?,
            oidcRedirectUri: checkUrl("oidcRedirectUri", change.oidcRedirectUri)?,
        ),
    )
}

private {
    checkUrl(field: string, given: string | None) -> Result<string | None, common.ApiError> {
        match given {
            None -> {
                return Ok(None)
            }
            text -> {
                url = text.trim().removeSuffix("/")
                if not url.startsWith("https://") and not url.startsWith("http://") {
                    return Err(common.ApiError.Invalid(field, "must start with https:// or http://"))
                }
                if url.contains(" ") or url.length() < 9 {
                    return Err(common.ApiError.Invalid(field, "isn't a web address"))
                }
                return Ok(url)
            }
        }
    }

    checkText(field: string, given: string | None) -> Result<string | None, common.ApiError> {
        match given {
            None -> {
                return Ok(None)
            }
            text -> {
                if text.isBlank() {
                    return Err(common.ApiError.Invalid(field, "is blank"))
                }
                return Ok(text.trim())
            }
        }
    }
}
