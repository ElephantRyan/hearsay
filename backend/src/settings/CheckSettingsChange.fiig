// Tidies and checks a change before anything is saved: addresses are http(s)
// URLs with no trailing slash, and no text is blank.
rule checkSettingsChange(change: SettingsChange) -> Result<SettingsChange, SettingsChangeError> {
    return Ok(
        SettingsChange(
            absUrl: checkUrl("absUrl", change.absUrl)?,
            serviceToken: checkText("serviceToken", change.serviceToken)?,
            mirrorEnabled: change.mirrorEnabled,
            topSeries: change.topSeries,
            topStandalones: change.topStandalones,
            refreshHourUtc: checkHour("refreshHourUtc", change.refreshHourUtc)?,
            authMode: change.authMode,
            frontendUrl: checkUrl("frontendUrl", change.frontendUrl)?,
            oidcIssuer: checkUrl("oidcIssuer", change.oidcIssuer)?,
            oidcClientId: checkText("oidcClientId", change.oidcClientId)?,
            oidcClientSecret: checkText("oidcClientSecret", change.oidcClientSecret)?,
            oidcRedirectUri: checkUrl("oidcRedirectUri", change.oidcRedirectUri)?,
            serverName: checkText("serverName", change.serverName)?
        )
    );
}

private {
    checkHour(field: string, given: int | None) -> Result<int | None, SettingsChangeError> {
        return match (given) {
            None -> Ok(None),
            hour -> {
                if (hour < 0 || hour > 23) {
                    return Err(
                        SettingsChangeError.Invalid(
                            field: field,
                            reason: "must be an hour from 0 to 23"
                        )
                    );
                }

                return Ok(hour);
            }
        }
    }

    checkUrl(field: string, given: string | None) -> Result<string | None, SettingsChangeError> {
        return match (given) {
            None -> Ok(None),
            text -> {
                url = text.trim().removeSuffix("/");
                if (!url.startsWith("https://") && !url.startsWith("http://")) {
                    return Err(
                        SettingsChangeError.Invalid(field, "must start with https:// or http://")
                    );
                }

                if (url.contains(" ") || url.length() < 9) {
                    return Err(SettingsChangeError.Invalid(field, "isn't a web address"));
                }

                return Ok(url);
            }
        }
    }

    checkText(field: string, given: string | None) -> Result<string | None, SettingsChangeError> {
        return match (given) {
            None -> Ok(None),
            text -> {
                if (text.isBlank()) {
                    return Err(SettingsChangeError.Invalid(field, "is blank"));
                }

                return Ok(text.trim());
            }
        }
    }
}
