use hearsay.absclient as client
use fiig.http

// absReply's answer, with its error turned into a SignInError, so a gateway
// can write `reply = signInAbs(absReply(HttpClient.send(...)))?`.
conversion signInAbs(answer: Result<http.Reply, client.AbsError>) -> Result<http.Reply, SignInError> {
    match answer {
        Err(error) -> Err(signInErrorOfAbs(error))
        Ok(reply) -> Ok(reply)
    }
}
