use abs.recommendations.signin

conversion apiErrorOfSignIn(error: signin.SignInError) -> ApiError {
    match error {
        signin.SignInError.WrongMethod -> ApiError.Refused("this server does not sign people in that way")
        signin.SignInError.NoAccount -> ApiError.Refused("no Audiobookshelf account has your email; sign in to Audiobookshelf once first")
        signin.SignInError.Refused(reason) -> ApiError.Refused(reason)
        signin.SignInError.Unavailable(detail) -> ApiError.Unavailable(detail)
    }
}
