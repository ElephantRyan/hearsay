// Checks what a person sent, before anything else is asked of anyone: a bad
// rating is refused without a round trip to Audiobookshelf.
rule checkRating(itemId: string, input: RatingInput) -> Result<CheckedRating, RatingError> {
    note = input.note ?? "";
    match (input.score) {
        None -> {
            // A note alone is a private line about the book; with nothing at all there's nothing to save.
            if (!input.recommended && note.isBlank()) {
                return Err(
                    RatingError.Invalid(
                        "score",
                        "is needed unless the book is recommended or has a note",
                    ),
                );
            }
        },

        score -> {
            if (score < 1 || score > 10) {
                return Err(RatingError.Invalid("score", "must be from 1 to 10"));
            }
        },
    }

    if (note.length() > 280) {
        return Err(RatingError.Invalid("note", "must be at most 280 characters"));
    }

    if (itemId.isBlank()) {
        return Err(RatingError.Invalid("itemId", "must not be blank"));
    }

    return Ok(
        CheckedRating(
            itemId: itemId,
            score: input.score,
            note: note,
            noteShared: input.noteShared ?? false,
            recommended: input.recommended,
        ),
    );
}
