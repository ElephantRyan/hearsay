// A recommended rating as linked servers are shown it, from the shared_rating
// view (migrations/0001_initial_schema.sql). userId stays on this server: the
// links package sends an opaque id instead.
model SharedRow {
    userId: string;
    username: string;
    title: string;
    authors: string;
    asin: string | None;
    isbn: string | None;
    score: int | None;
    note: string;
    updatedAt: int;
}
