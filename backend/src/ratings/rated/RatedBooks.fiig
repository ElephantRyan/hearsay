// What has been rated, read from the rating_row view (a rating with its book).
// The view is ratings' own; other domains read it only through this group
// (ADR 0079 §6a), and a test can fake it.
capability RatedBooks {
    // All of one user's ratings, private ones included; the caller only asks for
    // the signed-in user's own.
    gateway byUser(userId: string) -> List<RatingRow> requires Database idempotent {
        return Database.queryMany(
            "SELECT * FROM rating_row WHERE user_id = ? ORDER BY updated_at DESC",
            userId
        );
    }

    // Every recommended rating with its book, for ranking and for the list of
    // recommenders. Private ratings never leave the database through here, and
    // a note only when its writer shared it.
    gateway recommended() -> List<RatingRow> requires Database idempotent {
        return Database.queryMany(
            "SELECT user_id, username, item_id, library_id, title, authors, score, CASE WHEN note_shared = 1 THEN note ELSE '' END AS note, recommended, created_at, updated_at, via, matched_by, note_shared FROM rating_row WHERE recommended = 1"
        );
    }

    // Every recommended rating with what recognises its book on another server
    // (LINKED.md section 2). Private ratings never leave through here either.
    gateway shared() -> List<SharedRow> requires Database idempotent {
        return Database.queryMany("SELECT * FROM shared_rating");
    }

    // What a viewer may see of one book: everyone's recommended ratings, plus
    // their own whether recommended or not, and anyone's shared note on a book
    // they didn't recommend (the note alone: its score stays theirs). Others'
    // notes only when shared.
    gateway visibleFor(itemId: string, viewerId: string) -> List<RatingRow>
            requires Database
            idempotent {
        return Database.queryMany(
            "SELECT user_id, username, item_id, library_id, title, authors, CASE WHEN recommended = 1 OR user_id = ? THEN score ELSE NULL END AS score, CASE WHEN note_shared = 1 OR user_id = ? THEN note ELSE '' END AS note, recommended, created_at, updated_at, via, matched_by, note_shared FROM rating_row WHERE item_id = ? AND (recommended = 1 OR user_id = ? OR (note_shared = 1 AND note <> '')) ORDER BY updated_at DESC",
            viewerId,
            viewerId,
            itemId,
            viewerId
        );
    }
}
