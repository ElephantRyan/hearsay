rule sortRatings(rows: List<RatingRow>, order: RatingOrder) -> List<RatingRow> {
    return match (order) {
        RatingOrder.Score -> sorted(r in rows): r.score descending then r.updatedAt descending
        RatingOrder.Newest -> sorted(r in rows): r.updatedAt descending
        RatingOrder.Title -> sorted(r in rows): r.title
    }
}
