use abs.recommendations.common

// Who is asking comes first (a stranger learns nothing about valid sorts),
// then the sort: an unknown one is the caller's mistake.
workflow listMyRatings(session: string | None, sort: string | None) -> Result<List<RatingRow>, common.ApiError> {
    rows = loadMyRatings(session)?
    match parseOrder(sort) {
        None -> {
            return Err(common.ApiError.Invalid("sort", "must be score, newest or title"))
        }
        order -> {
            return Ok(sortRatings(rows, order))
        }
    }
}

private {
    parseOrder(text: string | None) -> RatingOrder | None {
        return orderNamed(text or "newest")
    }

    orderNamed(name: string) -> RatingOrder | None {
        if name == "score" {
            return RatingOrder.Score
        }
        if name == "newest" {
            return RatingOrder.Newest
        }
        if name == "title" {
            return RatingOrder.Title
        }
        return None
    }
}
