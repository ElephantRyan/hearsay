// A rating joined with who made it and the book it is about, as the
// rating_row view returns it (migrations/0003_rating_row_columns.sql).
model RatingRow {
    userId: string
    username: string
    itemId: string
    libraryId: string
    title: string
    authors: string
    score: int
    note: string
    recommended: bool
    createdAt: int
    updatedAt: int
}
