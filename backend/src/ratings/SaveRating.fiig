// Creates or updates a user's rating of an item. An update keeps the
// original created_at.
gateway saveRating(rating: Rating) -> int
    requires Database
{
    return Database.execute(
        "INSERT INTO rating (user_id, item_id, score, note, recommended, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?) ON CONFLICT (user_id, item_id) DO UPDATE SET score = excluded.score, note = excluded.note, recommended = excluded.recommended, updated_at = excluded.updated_at",
        rating.userId,
        rating.itemId,
        rating.score,
        rating.note,
        rating.recommended,
        rating.createdAt,
        rating.updatedAt,
    )
}
