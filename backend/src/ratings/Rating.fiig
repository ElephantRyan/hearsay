// One user's rating of one ABS library item. Times are Unix milliseconds. A
// recommendation, or a rating that is only a note, may go without a score.
// The note is the writer's own unless noteShared.
model Rating {
    userId: string;
    itemId: string;
    score: int | None;
    note: string;
    noteShared: bool;
    recommended: bool;
    createdAt: int;
    updatedAt: int;
}
