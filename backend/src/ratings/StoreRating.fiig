use hearsay.books.BookCache
use hearsay.common

// Validates, stores, and returns what is now stored (an update keeps the
// original created_at, so the stored row can differ from the one made here).
// The book is cached on every write so lists need no ABS call per card.
// The user, the book and the rating are written in one transaction, so a
// fault midway leaves none of them.
activity storeRating(found: UserAndBook, input: RatingInput) -> Result<Rating, common.ApiError> {
    now = Clock.now()
    rating = createRating(found.user.userId, found.book.itemId, input, now)?
    transaction Database {
        upsertUser(found.user.userId, found.user.username, now)
        BookCache.save(found.book, now)
        saveRating(rating)
        stored = findRating(found.user.userId, found.book.itemId)
        match stored {
            None -> {
                return Ok(rating)
            }
            saved -> {
                return Ok(saved)
            }
        }
    }
}
