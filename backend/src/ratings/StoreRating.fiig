use hearsay.absclient.catalog;
use hearsay.accounts;
use hearsay.books.BookCache;

// Stores a checked rating and returns what is now stored (an update keeps the
// original created_at, so the stored row can differ from the one made here).
// The book is cached on every write so lists need no ABS call per card.
// The user, the book and the rating are written in one transaction, so a
// fault midway leaves none of them.
activity storeRating(user: accounts.Identity, book: catalog.Book, checked: CheckedRating)
        -> Rating {
    now = Clock.now();
    rating = Rating(
        userId: user.userId,
        itemId: book.itemId,
        score: checked.score,
        note: checked.note,
        noteShared: checked.noteShared,
        recommended: checked.recommended,
        createdAt: now,
        updatedAt: now
    );
    transaction Database {
        upsertUser(user.userId, user.username, now);
        BookCache.save(book, now);
        saveRating(rating);
        stored = findRating(user.userId, book.itemId);
        match (stored) {
            None -> {
                return rating;
            },

            saved -> {
                return saved;
            }
        }
    }
}
