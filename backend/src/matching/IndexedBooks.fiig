// The library_index table's row count.
gateway indexedBooks() -> int
    requires Database
    idempotent
{
    found: IndexCount | None = Database.queryOne("SELECT COUNT(*) AS books FROM library_index")
    match found {
        None -> {
            return 0
        }
        counted -> {
            return counted.books
        }
    }
}

private {
    model IndexCount {
        books: int
    }
}
