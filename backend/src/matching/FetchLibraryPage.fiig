use abs.recommendations.absclient
use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.common

// One page of a library's books, ASIN and ISBN included, for an index rebuild.
gateway fetchLibraryPage(abs: absclient.AbsTarget, libraryId: string, page: int, size: int) -> Result<catalog.BookPage, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.pageAsService(abs, libraryId, page, size)): common.apiErrorOfAbs(e)
}
