use hearsay.absclient.catalog;

// A cached book whose series ABS was asked about; None otherwise, so the caller
// fetches it again.
gateway findBookWithSeries(itemId: string) -> catalog.Book | None requires Database idempotent {
    row: CachedBookRow | None = Database.queryOne(
        "SELECT item_id, library_id, title, authors, asin, isbn FROM book WHERE item_id = ? AND series_known = 1",
        itemId,
    );
    return match (row) {
        None -> None,
        found -> bookOfRow(found),
    }
}
