use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.common

// Many books from ABS in one call, with the server's token.
gateway fetchBooks(itemIds: List<string>) -> Result<List<catalog.Book>, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.itemsAsService(itemIds)): common.apiErrorOfAbs(e)
}
