// Every book we keep a copy of, and each cached series' book 1 (which may be
// new since the series was last read), for the refresh to fetch again.
gateway booksToRefresh() -> List<string> requires Database idempotent {
    rows: List<BookId> = Database.queryMany(
        "SELECT item_id FROM book UNION SELECT item_id FROM series_book WHERE position = 0"
    );
    return map(r in rows): r.itemId;
}
