use hearsay.absclient.catalog;

gateway findBook(itemId: string) -> catalog.Book | None requires Database idempotent {
    row: CachedBookRow | None = Database.queryOne(
        "SELECT item_id, library_id, title, authors, asin, isbn FROM book WHERE item_id = ?",
        itemId,
    );
    return match (row) {
        None -> None,
        found -> bookOfRow(found),
    }
}
