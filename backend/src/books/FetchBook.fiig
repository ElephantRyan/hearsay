// One book from ABS, with the server's token. ABS's failures become the app's
// errors here, once: a 404 is "no such book", anything else is "unavailable".
use hearsay.absclient
use hearsay.absclient.catalog
use hearsay.absclient.catalog.AbsCatalog
use hearsay.common

gateway fetchBook(abs: absclient.AbsTarget, itemId: string) -> Result<catalog.Book, common.ApiError>
    requires AbsCatalog
{
    return mapErr(e in AbsCatalog.itemAsService(abs, itemId)): common.apiErrorOfAbs(e)
}
