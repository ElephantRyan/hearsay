use hearsay.absclient.catalog
use hearsay.common
use hearsay.settings

// A book from our cached copy, or from ABS when nobody has rated it yet.
activity cachedBook(itemId: string) -> Result<catalog.Book, common.ApiError> {
    match findBook(itemId) {
        None -> {
            return fetchBook(settings.loadAbsTarget()?, itemId)
        }
        cached -> {
            return Ok(cached)
        }
    }
}
