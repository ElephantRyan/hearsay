// Makes the Rating to store from what a user sent. Rules are pure, so the
// user and the time come in as arguments.
rule createRating(userId: string, input: NewRating, now: int) -> Result<Rating, RatingError> {
    if input.score < 1 or input.score > 10 {
        return Err(RatingError.Invalid("score", "must be from 1 to 10"))
    }
    if input.note.length() > 280 {
        return Err(RatingError.Invalid("note", "must be at most 280 characters"))
    }
    if input.itemId.isBlank() {
        return Err(RatingError.Invalid("itemId", "must not be blank"))
    }
    return Ok(
        Rating(userId: userId, itemId: input.itemId, score: input.score, note: input.note, recommended: input.recommended, createdAt: now, updatedAt: now),
    )
}
