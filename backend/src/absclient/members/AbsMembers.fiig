use hearsay.absclient;
use hearsay.settings.Abs;
use hearsay.settings.AbsService;
use fiig.http;
use fiig.http.HttpClient;

// ABS accounts: signing in with a password, and who a token belongs to.
capability AbsMembers {
    gateway login(
        url: string,
        username: string,
        password: string,
    ) -> Result<AbsSession, absclient.AbsError> requires HttpClient {
        reply = absclient.absReply(HttpClient.send(absLoginRequest(url, username, password)))?;
        return sessionOfLoginReply(reply.body);
    }

    gateway me(url: string, accessToken: string) -> Result<AbsUser, absclient.AbsError>
            requires HttpClient {
        reply = absclient.absReply(HttpClient.send(absclient.absGet(url, "/api/me", accessToken)))?;
        user: AbsUser = mapErr(e in json.decode(reply.body)): absclient.AbsError.Unreadable(
            failure: e,
        )?;
        return Ok(user);
    }

    // Who this server's own token belongs to: the admin screen's check that the token works.
    gateway meAsService() -> Result<AbsUser, absclient.AbsError> requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        reply = absclient.absReply(
            HttpClient.send(absclient.absGet(abs.url, "/api/me", abs.token.reveal())),
        )?;
        user: AbsUser = mapErr(e in json.decode(reply.body)): absclient.AbsError.Unreadable(
            failure: e,
        )?;
        return Ok(user);
    }
}
