use hearsay.absclient;

// POST /login's body as the session it gives us.
conversion sessionOfLoginReply(body: bytes) -> Result<AbsSession, absclient.AbsError> {
    reply: AbsLoginReply = mapErr(e in json.decode(body)):
            absclient.AbsError.Unreadable(failure: e)?;
    return Ok(
        AbsSession(
            userId: reply.user.id,
            username: reply.user.username,
            userType: reply.user.type,
            accessToken: reply.user.accessToken,
            refreshToken: reply.user.refreshToken
        )
    );
}

private {
    model AbsLoginReply {
        user: AbsLoginUser;
    }

    // The part of `user` this app reads (ABS 2.37.2). Members it doesn't
    // declare, such as the legacy never-expiring `token`, are ignored on
    // decode.
    model AbsLoginUser {
        id: string;
        username: string;
        type: absclient.AbsUserType;
        accessToken: string;
        refreshToken: string;
    }
}
