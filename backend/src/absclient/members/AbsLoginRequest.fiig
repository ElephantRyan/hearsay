// POST /login. The x-return-tokens header makes ABS 2.37 put the access and
// refresh tokens in the body.
use fiig.http;

rule absLoginRequest(base: string, username: string, password: string) -> http.Request {
    return http.Request(
        method: http.Method.Post,
        url: "${base}/login",
        headers: [
            http.Header(name: "Content-Type", value: "application/json"),
            http.Header(name: "Accept", value: "application/json"),
            http.Header(name: "x-return-tokens", value: "true"),
        ],
        body: json.encode(AbsLoginBody(username: username, password: password)),
        timeoutMillis: 10000,
    );
}

private {
    model AbsLoginBody {
        username: string;
        password: string;
    }
}
