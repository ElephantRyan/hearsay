// A GET to ABS carrying the user's access token. This client sends nothing
// else but login (see abs_login_request.fiig), so it can't write to ABS.
use fiig.http

rule absGet(base: string, path: string, accessToken: string) -> http.Request {
    return http.Request(
        method: http.Method.Get,
        url: "${base}${path}",
        headers: [http.Header(name: "Authorization", value: "Bearer ${accessToken}"), http.Header(name: "Accept", value: "application/json")],
        timeoutMillis: 10000,
    )
}
