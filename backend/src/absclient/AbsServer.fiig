use fiig.http
use fiig.http.HttpClient

// Whether ABS answers at all: its public /status, no token.
capability AbsServer {
    gateway status(url: string) -> Result<int, AbsError> requires HttpClient {
        reply = absReply(HttpClient.send(absGet(url, "/status", "")))?;
        return Ok(reply.status);
    }
}
