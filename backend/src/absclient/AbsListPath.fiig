use fiig.http

// GET /api/libraries/{id}/items for one page, titles A to Z. The caller has
// already checked the id with validId; the rest are integers.
conversion absListPath(libraryId: string, page: int, size: int) -> string {
    return "/api/libraries/${libraryId}/items?sort=media.metadata.title&minified=1&page=${page}&limit=${size}"
}
