use hearsay.absclient
use hearsay.settings.Abs
use hearsay.settings.AbsService
use fiig.http
use fiig.http.HttpClient

// What ABS knows about a person's listening. Read with this server's own token:
// GET /api/users/{id} is admin-only, and it is the one place ABS lists another
// account's progress.
capability AbsProgress {
    gateway progressAsService(userId: string) -> Result<List<Progress>, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        userIdSegment = absclient.absPathId(userId)?;
        reply = absclient.absReply(
            HttpClient.send(
                absclient.absGet(abs.url, "/api/users/${userIdSegment}", abs.token.reveal()),
            ),
        )?;
        return progressOfUserReply(reply.body);
    }
}
