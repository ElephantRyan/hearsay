use hearsay.absclient;
use hearsay.settings.Abs;
use hearsay.settings.AbsService;
use fiig.http;
use fiig.http.HttpClient;

// The only writes this client makes to ABS: the collections that mirror
// recommendations (PLAN.md M6). Every id is checked before a path is built.
capability AbsCollections {
    gateway createCollectionAsService(
        libraryId: string,
        name: string,
        description: string,
        bookIds: List<string>)
            -> Result<string, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        if (!absclient.validId(libraryId) || !all(id in bookIds): absclient.validId(id)) {
            return Err(absclient.AbsError.NotFound);
        }

        body = json.encode(
            AbsCollectionBody(
                libraryId: libraryId,
                name: name,
                description: description,
                books: bookIds
            )
        );
        reply = absclient.absReply(
            HttpClient.send(
                absWrite(http.Method.Post, "${abs.url}/api/collections", abs.token.reveal(), body)
            )
        )?;
        created: AbsCollection = mapErr(e in json.decode(reply.body)):
                absclient.AbsError.Unreadable(failure: e)?;
        return Ok(created.id);
    }

    gateway updateCollectionAsService(
        collectionId: string,
        name: string,
        description: string,
        bookIds: List<string>)
            -> Result<int, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        collectionIdSegment = absclient.absPathId(collectionId)?;
        if (!all(id in bookIds): absclient.validId(id)) {
            return Err(absclient.AbsError.NotFound);
        }

        // PATCH only reorders the books already there, so books are added and
        // removed first, then the PATCH sets the name, description and order.
        base = "${abs.url}/api/collections/${collectionIdSegment}";
        current = absclient.absReply(
            HttpClient.send(
                absclient.absGet(
                    abs.url,
                    "/api/collections/${collectionIdSegment}",
                    abs.token.reveal()
                )
            )
        )?;
        held: AbsCollectionBooks = mapErr(e in json.decode(current.body)):
                absclient.AbsError.Unreadable(failure: e)?;
        heldIds = map(b in held.books): b.id;
        toAdd = filter(id in bookIds): !heldIds.contains(id);
        toRemove = filter(id in heldIds): !bookIds.contains(id);
        if (toAdd.length() > 0) {
            absclient.absReply(
                HttpClient.send(
                    absWrite(
                        http.Method.Post,
                        "${base}/batch/add",
                        abs.token.reveal(),
                        json.encode(AbsBookIds(books: toAdd))
                    )
                )
            )?;
        }

        if (toRemove.length() > 0) {
            absclient.absReply(
                HttpClient.send(
                    absWrite(
                        http.Method.Post,
                        "${base}/batch/remove",
                        abs.token.reveal(),
                        json.encode(AbsBookIds(books: toRemove))
                    )
                )
            )?;
        }

        body = json.encode(
            AbsCollectionPatch(name: name, description: description, books: bookIds)
        );
        reply = absclient.absReply(
            HttpClient.send(
                absWrite(
                    http.Method.Patch,
                    "${abs.url}/api/collections/${collectionIdSegment}",
                    abs.token.reveal(),
                    body
                )
            )
        )?;
        return Ok(reply.status);
    }

    gateway deleteCollectionAsService(collectionId: string) -> Result<int, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        collectionIdSegment = absclient.absPathId(collectionId)?;
        reply = absclient.absReply(
            HttpClient.send(
                absWrite(
                    http.Method.Delete,
                    "${abs.url}/api/collections/${collectionIdSegment}",
                    abs.token.reveal(),
                    None
                )
            )
        )?;
        return Ok(reply.status);
    }
}
