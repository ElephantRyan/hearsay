use hearsay.absclient
use fiig.http
use fiig.http.HttpClient

// The only writes this client makes to ABS: the collections that mirror
// recommendations (PLAN.md M6). Every id is checked before a path is built.
capability AbsCollections {
    gateway createCollectionAsService(
        abs: absclient.AbsTarget,
        libraryId: string,
        name: string,
        description: string,
        bookIds: List<string>,
    ) -> Result<string, absclient.AbsError> requires HttpClient {
        if (!absclient.validId(libraryId) || !all(id in bookIds): absclient.validId(id)) {
            return Err(absclient.AbsError.NotFound);
        }

        body = json.encode(
            AbsCollectionBody(
                libraryId: libraryId,
                name: name,
                description: description,
                books: bookIds,
            ),
        );
        reply = absclient.absReply(
            HttpClient.send(
                absWrite(http.Method.Post, "${abs.url}/api/collections", abs.token.reveal(), body),
            ),
        )?;
        created: AbsCollection = mapErr(e in json.decode(reply.body)): absclient.AbsError.Unreadable(
            failure: e,
        )?;
        return Ok(created.id);
    }

    gateway updateCollectionAsService(
        abs: absclient.AbsTarget,
        collectionId: string,
        name: string,
        description: string,
        bookIds: List<string>,
    ) -> Result<int, absclient.AbsError> requires HttpClient {
        collectionIdSegment = absclient.absPathId(collectionId)?;
        if (!all(id in bookIds): absclient.validId(id)) {
            return Err(absclient.AbsError.NotFound);
        }

        body = json.encode(
            AbsCollectionPatch(name: name, description: description, books: bookIds),
        );
        reply = absclient.absReply(
            HttpClient.send(
                absWrite(
                    http.Method.Patch,
                    "${abs.url}/api/collections/${collectionIdSegment}",
                    abs.token.reveal(),
                    body,
                ),
            ),
        )?;
        return Ok(reply.status);
    }

    gateway deleteCollectionAsService(
        abs: absclient.AbsTarget,
        collectionId: string,
    ) -> Result<int, absclient.AbsError> requires HttpClient {
        collectionIdSegment = absclient.absPathId(collectionId)?;
        reply = absclient.absReply(
            HttpClient.send(
                absWrite(
                    http.Method.Delete,
                    "${abs.url}/api/collections/${collectionIdSegment}",
                    abs.token.reveal(),
                    None,
                ),
            ),
        )?;
        return Ok(reply.status);
    }
}
