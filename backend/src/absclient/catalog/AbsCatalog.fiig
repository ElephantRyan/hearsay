use hearsay.absclient;
use hearsay.settings.Abs;
use hearsay.settings.AbsService;
use fiig.http;
use fiig.http.HttpClient;

// What is in ABS: one book or many, the libraries, a page of one, and search.
// The *AsService gateways use this server's own token.
capability AbsCatalog {
    gateway item(url: string, accessToken: string, itemId: string)
            -> Result<Book, absclient.AbsError>
            requires HttpClient {
        itemIdSegment = absclient.absPathId(itemId)?;
        reply = absclient.absReply(
            HttpClient.send(absclient.absGet(url, "/api/items/${itemIdSegment}", accessToken)),
        )?;
        return bookOfItemReply(reply.body);
    }

    gateway itemAsService(itemId: string) -> Result<Book, absclient.AbsError> requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        itemIdSegment = absclient.absPathId(itemId)?;
        reply = absclient.absReply(
            HttpClient.send(
                absclient.absGet(abs.url, "/api/items/${itemIdSegment}", abs.token.reveal()),
            ),
        )?;
        return bookOfItemReply(reply.body);
    }

    // Many books in one call. Every id is checked first; ABS leaves out the ones it doesn't have.
    gateway itemsAsService(itemIds: List<string>) -> Result<List<Book>, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        if (!all(id in itemIds): absclient.validId(id)) {
            return Err(absclient.AbsError.NotFound);
        }

        reply = absclient.absReply(
            HttpClient.send(absBatchGet(abs.url, itemIds, abs.token.reveal())),
        )?;
        return booksOfBatchReply(reply.body);
    }

    gateway librariesAsService() -> Result<List<AbsLibrary>, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        reply = absclient.absReply(
            HttpClient.send(absclient.absGet(abs.url, "/api/libraries", abs.token.reveal())),
        )?;
        found: AbsLibrariesReply = mapErr(e in json.decode(reply.body)):
                absclient.AbsError.Unreadable(failure: e)?;
        return Ok(found.libraries);
    }

    gateway pageAsService(
        libraryId: string,
        page: int,
        size: int,
        order: BookOrder,
        scope: BookScope)
            -> Result<BookPage, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        libraryIdSegment = absclient.absPathId(libraryId)?;
        // A scope's id goes into the URL too, so it must be one ABS could have made.
        scopeId = match (scope) {
            BookScope.All -> "all",
            BookScope.Author(id) -> id,
            BookScope.Series(id) -> id,
        }

        if (!absclient.validId(scopeId)) {
            return Err(absclient.AbsError.NotFound);
        }

        reply = absclient.absReply(
            HttpClient.send(
                absclient.absGet(
                    abs.url,
                    absListPath(libraryIdSegment, page, size, order, scope),
                    abs.token.reveal(),
                ),
            ),
        )?;
        return bookPageOfListing(reply.body);
    }

    gateway searchAsService(libraryId: string, query: string, size: int)
            -> Result<SearchHits, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        libraryIdSegment = absclient.absPathId(libraryId)?;
        reply = absclient.absReply(
            HttpClient.send(
                absclient.absGet(
                    abs.url,
                    absSearchPath(libraryIdSegment, query, size),
                    abs.token.reveal(),
                ),
            ),
        )?;
        return searchHitsOf(reply.body, size);
    }

    // The series a book is in, with its number in each.
    gateway itemSeriesAsService(itemId: string) -> Result<List<SeriesRef>, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        itemIdSegment = absclient.absPathId(itemId)?;
        reply = absclient.absReply(
            HttpClient.send(
                absclient.absGet(abs.url, "/api/items/${itemIdSegment}", abs.token.reveal()),
            ),
        )?;
        return seriesRefsOfItemReply(reply.body);
    }

    // A series: its name and library (GET /api/series/{id}), and its books in
    // series order (the library listing filtered to it), at most 100.
    gateway seriesAsService(seriesId: string) -> Result<CatalogSeries, absclient.AbsError>
            requires HttpClient {
        abs = absclient.targetOf(Abs.url, AbsService.token)?;
        seriesIdSegment = absclient.absPathId(seriesId)?;
        found = absclient.absReply(
            HttpClient.send(
                absclient.absGet(abs.url, "/api/series/${seriesIdSegment}", abs.token.reveal()),
            ),
        )?;
        series: AbsSeriesReply = mapErr(e in json.decode(found.body)):
                absclient.AbsError.Unreadable(failure: e)?;
        libraryIdSegment = absclient.absPathId(series.libraryId)?;
        listed = absclient.absReply(
            HttpClient.send(
                absclient.absGet(
                    abs.url,
                    absListPath(
                        libraryIdSegment,
                        0,
                        100,
                        BookOrder.SeriesOrder,
                        BookScope.Series(series.id),
                    ),
                    abs.token.reveal(),
                ),
            ),
        )?;
        page = bookPageOfListing(listed.body)?;
        authors = match (page.books.firstOrNone()) {
            None -> "",
            first -> first.authors,
        }

        return Ok(
            CatalogSeries(
                seriesId: series.id,
                libraryId: series.libraryId,
                name: series.name,
                authors: authors,
                bookIds: map(b in page.books): b.itemId,
            ),
        );
    }
}
