use abs.recommendations.absclient
use abs.recommendations.absclient.Abs
use abs.recommendations.absclient.AbsService
use fiig.http
use fiig.http.HttpClient

// What is in ABS: one book, the libraries, a page of one, and search.
// The *AsService gateways use this server's own token.
capability AbsCatalog {
    gateway item(accessToken: string, itemId: string) -> Result<Book, absclient.AbsError>
        requires HttpClient
    {
        itemIdSegment = absclient.absPathId(itemId)?
        reply = absclient.absReply(HttpClient.send(absclient.absGet(Abs.url, "/api/items/${itemIdSegment}", accessToken)))?
        return bookOfItemReply(reply.body)
    }

    gateway itemAsService(itemId: string) -> Result<Book, absclient.AbsError>
        requires HttpClient
    {
        itemIdSegment = absclient.absPathId(itemId)?
        reply = absclient.absReply(HttpClient.send(absclient.absGet(Abs.url, "/api/items/${itemIdSegment}", AbsService.token.reveal())))?
        return bookOfItemReply(reply.body)
    }

    gateway librariesAsService() -> Result<List<AbsLibrary>, absclient.AbsError>
        requires HttpClient
    {
        reply = absclient.absReply(HttpClient.send(absclient.absGet(Abs.url, "/api/libraries", AbsService.token.reveal())))?
        found: AbsLibrariesReply = mapErr(e in json.decode(reply.body)): absclient.AbsError.Unreadable(failure: e)?
        return Ok(found.libraries)
    }

    gateway pageAsService(libraryId: string, page: int, size: int) -> Result<BookPage, absclient.AbsError>
        requires HttpClient
    {
        libraryIdSegment = absclient.absPathId(libraryId)?
        reply = absclient.absReply(HttpClient.send(absclient.absGet(Abs.url, absListPath(libraryIdSegment, page, size), AbsService.token.reveal())))?
        return bookPageOfListing(reply.body)
    }

    gateway searchAsService(libraryId: string, query: string, size: int) -> Result<BookPage, absclient.AbsError>
        requires HttpClient
    {
        libraryIdSegment = absclient.absPathId(libraryId)?
        reply = absclient.absReply(HttpClient.send(absclient.absGet(Abs.url, absSearchPath(libraryIdSegment, query, size), AbsService.token.reveal())))?
        return bookPageOfSearch(reply.body, size)
    }
}
