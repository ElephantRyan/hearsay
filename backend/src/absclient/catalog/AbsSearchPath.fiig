use fiig.http;

// GET /api/libraries/{id}/search. `q` is whatever a person typed, so it is
// percent-encoded; the id is made one path segment by the caller with absPathId.
conversion absSearchPath(libraryId: string, query: string, size: int) -> string {
    return "/api/libraries/${libraryId}/search?${queryString(http.formEncode([http.Header(name: "q", value: query), http.Header(name: "limit", value: "${size}")]))}";
}

private {
    queryString(encoded: bytes) -> string {
        return match (encoded.utf8()) {
            None -> "",
            text -> text
        }
    }
}
