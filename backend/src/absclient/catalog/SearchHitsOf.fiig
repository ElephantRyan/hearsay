use hearsay.absclient;

// GET /api/libraries/{id}/search as SearchHits: the `book` hits (at most `size`)
// as a BookPage, and the `authors` and `series` hits with their book counts.
// Narrators, tags and genres are ignored.
conversion searchHitsOf(body: bytes, size: int) -> Result<SearchHits, absclient.AbsError> {
    found: AbsSearchReply = mapErr(e in json.decode(body)):
            absclient.AbsError.Unreadable(failure: e)?;
    return Ok(
        SearchHits(
            page: BookPage(
                total: found.book.length(),
                page: 0,
                limit: size,
                books: map(hit in found.book): bookOfListed(hit.libraryItem)
            ),
            authors: map(a in found.authors ?? []):
                    CatalogMatch(id: a.id, name: a.name, books: a.numBooks ?? 0),
            series: map(s in found.series ?? []):
                    CatalogMatch(id: s.series.id, name: s.series.name, books: s.books.length())
        )
    );
}

private {
    model AbsSearchReply {
        book: List<AbsSearchHit>;
        authors: List<AbsAuthorHit> | None;
        series: List<AbsSeriesHit> | None;
    }

    model AbsSearchHit {
        libraryItem: AbsListedItem;
    }

    model AbsAuthorHit {
        id: string;
        name: string;
        numBooks: int | None;
    }

    model AbsSeriesHit {
        series: AbsSeriesName;
        books: List<AbsBookId>;
    }

    model AbsSeriesName {
        id: string;
        name: string;
    }

    model AbsBookId {
        id: string;
    }
}
