use fiig.http;

// An id from our callers' URLs, made one segment of an ABS path. validId keeps
// it to ABS's own id shape; http.pathSegment (ADR 0101) is what makes the path
// safe, so a looser validId could never let "../users" reach ABS. Anything
// that isn't an ABS id is NotFound.
conversion absPathId(id: string) -> Result<string, AbsError> {
    if (!validId(id)) {
        return Err(AbsError.NotFound);
    }

    return match (http.pathSegment(id)) {
        None -> Err(AbsError.NotFound),
        safe -> Ok(safe)
    }
}
