// What an Audiobookshelf account may do. A formula, so a rule can ask it.
formulas roles {
    // Whether an account may administer: the owner (root) and admins. The one
    // place that says so.
    formula canAdminister(type: AbsUserType) -> bool {
        return match (type) {
            AbsUserType.Root -> true
            AbsUserType.Admin -> true
            AbsUserType.User -> false
            AbsUserType.Guest -> false
        }
    }
}
