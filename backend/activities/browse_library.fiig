// Browse a library A to Z, or search it when `q` is given. Reads ABS with this
// server's token, so everyone sees every library the server's account can see
// (PLAN.md open question 9); the ratings shown are the viewer's own.
use abs.client
use abs.client.AbsApi

activity browseLibrary(session: string | None, libraryId: string, page: int | None, size: int | None, q: string | None) -> Result<BrowseResult, ApiError> {
    me = currentUser(session)?
    pageNumber = checkPage(page)?
    pageSize = checkSize(size)?
    typed = searchText(q)?
    found = fetchBooks(libraryId, pageNumber, pageSize, typed)?
    mine = ratingRowsByUser(me.userId)
    return Ok(BrowseResult(
        total: found.total,
        page: found.page,
        limit: found.limit,
        items: withMyScores(found.books, mine),
    ))
}

private {
    fetchBooks(libraryId: string, page: int, size: int, typed: string | None) -> Result<client.BookPage, ApiError> {
        match typed {
            None -> {
                return mapErr(e in AbsApi.pageAsService(libraryId, page, size)): apiErrorOfLibrary(e)
            }
            text -> {
                return mapErr(e in AbsApi.searchAsService(libraryId, text, size)): apiErrorOfLibrary(e)
            }
        }
    }
}
