use abs.signin

activity logInWithPassword(username: string, password: string) -> Result<Session, ApiError> {
    if Server.authMode == "oidc" {
        return Err(ApiError.NotFound("password sign-in on this server"))
    }
    identity = mapErr(e in signIn(signin.SignInAttempt.Password(username, password))): apiErrorOfSignIn(e)?
    return Ok(startSession(identity))
}
