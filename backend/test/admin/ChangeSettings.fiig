use hearsay.absclient as client
use hearsay.accounts
use hearsay.sessions
use hearsay.sessions.SessionConfig
use hearsay.settings
use hearsay.settings.Abs
use hearsay.settings.Oidc
use hearsay.settings.ServerConfig
use hearsay.settings.SignInConfig
use hearsay.settings.SyncConfig
use hearsay.signin

test onlyAnAdminSeesOrChangesSettings {
    fake SessionConfig {
        sessionMaxAge: 3600
    }

    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)).token
    change = settings.SettingsChange(
        absUrl: "https://elsewhere.test",
        serviceToken: None,
        mirrorEnabled: None,
    )
    expect showSettings(None) is Err(AdminError.NotSignedIn)
    expect showSettings(ann) is Err(AdminError.NotAdmin)
    expect changeSettings(ann, change) is Err(AdminError.NotAdmin)
    expect resetSetting(ann, "absUrl") is Err(AdminError.NotAdmin)
}

test anAdminSavesSettingsOverTheEnvironmentAndCanGoBack {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SignInConfig {
        authMode: settings.AuthMode.Abs
        frontendUrl: "https://app.test"
    }
    fake Oidc {
        issuer: "https://idp.test/application/o/abs/"
        clientId: "cid"
        redirectUri: "https://app.test/api/auth/callback"
    }
    fake Abs {
        url: "https://from-env.test"
    }
    fake SyncConfig {
        mirrorEnabled: false
    }
    fake ServerConfig {
        name: None
    }

    // A saved token first: a test can't leave ABS_SERVICE_TOKEN unset (GAPS G53, G54).
    settings.rememberSetting("abs.serviceToken", "old-token", "test")
    settings.rememberSetting("oidc.clientSecret", "csec", "test")
    root = sessions.startSession(accounts.Identity(userId: "r1", username: "owner", userType: client.AbsUserType.Root)).token
    expect showSettings(root) is Ok(before)
    expect before.absUrl == settings.SettingValue(value: "https://from-env.test", source: "environment")
    expect before.mirrorEnabled == settings.SettingValue(value: "false", source: "environment")
    expect before.serverName == settings.SettingValue(value: None, source: "unset")
    change = settings.SettingsChange(
        absUrl: "  https://abs.home.test/ ",
        serviceToken: "new-token",
        mirrorEnabled: true,
        serverName: " Ryan's library ",
    )
    expect changeSettings(root, change) is Ok(after)
    expect after.absUrl == settings.SettingValue(value: "https://abs.home.test", source: "saved")
    expect after.serviceToken == settings.SettingValue(value: None, source: "saved")
    expect after.mirrorEnabled == settings.SettingValue(value: "true", source: "saved")
    expect after.serverName == settings.SettingValue(value: "Ryan's library", source: "saved")
    expect settings.serverName() == "Ryan's library"
    expect settings.loadAbsTarget() is Ok(target)
    expect target.url == "https://abs.home.test"
    expect target.token.matches("new-token")
    expect settings.mirrorEnabled()
    expect resetSetting(root, "absUrl") is Ok(reset)
    expect reset.absUrl == settings.SettingValue(value: "https://from-env.test", source: "environment")
    expect resetSetting(root, "password") is Err(AdminError.UnknownSetting(_))
}

test aBadChangeSavesNothing {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SignInConfig {
        authMode: settings.AuthMode.Abs
        frontendUrl: "https://app.test"
    }
    fake Oidc {
        issuer: "https://idp.test/application/o/abs/"
        clientId: "cid"
        redirectUri: "https://app.test/api/auth/callback"
    }
    fake Abs {
        url: "https://from-env.test"
    }
    fake SyncConfig {
        mirrorEnabled: false
    }
    fake ServerConfig {
        name: None
    }

    settings.rememberSetting("abs.serviceToken", "old-token", "test")
    settings.rememberSetting("oidc.clientSecret", "csec", "test")
    admin = sessions.startSession(accounts.Identity(userId: "a1", username: "boss", userType: client.AbsUserType.Admin)).token
    expect changeSettings(admin, settings.SettingsChange(absUrl: "ftp://abs.test", serviceToken: "fine", mirrorEnabled: None)) is Err(AdminError.Invalid(field, _))
    expect field == "absUrl"
    expect changeSettings(admin, settings.SettingsChange(absUrl: None, serviceToken: "   ", mirrorEnabled: None)) is Err(AdminError.Invalid(blank, _))
    expect blank == "serviceToken"
    expect showSettings(admin) is Ok(view)
    expect view.absUrl == settings.SettingValue(value: "https://from-env.test", source: "environment")
    expect settings.loadAbsTarget() is Ok(target)
    expect target.token.matches("old-token")
}

test switchingToAuthentikTurnsPasswordSignInOff {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SignInConfig {
        authMode: settings.AuthMode.Abs
        frontendUrl: "https://app.test"
    }
    fake Oidc {
        issuer: "https://idp.test/application/o/abs/"
        clientId: "cid"
        redirectUri: "https://app.test/api/auth/callback"
    }
    fake Abs {
        url: "https://abs.test"
    }
    fake SyncConfig {
        mirrorEnabled: false
    }
    fake ServerConfig {
        name: None
    }

    settings.rememberSetting("abs.serviceToken", "old-token", "test")
    admin = sessions.startSession(accounts.Identity(userId: "a1", username: "boss", userType: client.AbsUserType.Admin)).token
    expect signin.loadSignInModes() == signin.SignInModes(password: true, oidc: false)
    change = settings.SettingsChange(
        authMode: settings.AuthMode.Oidc,
        oidcClientSecret: "new-secret",
        oidcRedirectUri: "https://app.home.test/api/auth/callback/",
    )
    expect changeSettings(admin, change) is Ok(view)
    expect view.authMode == settings.SettingValue(value: "oidc", source: "saved")
    expect view.oidcClientSecret == settings.SettingValue(value: None, source: "saved")
    expect view.oidcRedirectUri == settings.SettingValue(value: "https://app.home.test/api/auth/callback", source: "saved")
    expect signin.loadSignInModes() == signin.SignInModes(password: false, oidc: true)
    expect settings.loadAbsTarget() is Ok(_)
    expect resetSetting(admin, "authMode") is Ok(back)
    expect back.authMode == settings.SettingValue(value: "abs", source: "environment")
    expect signin.loadSignInModes() == signin.SignInModes(password: true, oidc: false)
}

test authentikOnlyWaitsForEveryAuthentikSetting {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SignInConfig {
        authMode: settings.AuthMode.Oidc
        frontendUrl: "https://app.test"
    }
    fake Oidc {
        issuer: None
        clientId: "cid"
        redirectUri: "https://app.test/api/auth/callback"
    }
    fake Abs {
        url: "https://abs.test"
    }
    fake SyncConfig {
        mirrorEnabled: false
    }
    fake ServerConfig {
        name: None
    }

    // AUTH_MODE=oidc with no issuer: password sign-in stays on rather than lock everyone out.
    settings.rememberSetting("abs.serviceToken", "svc", "test")
    settings.rememberSetting("oidc.clientSecret", "csec", "test")
    expect signin.loadSignInModes() == signin.SignInModes(password: true, oidc: false)
    admin = sessions.startSession(accounts.Identity(userId: "a1", username: "boss", userType: client.AbsUserType.Admin)).token
    expect changeSettings(admin, settings.SettingsChange(authMode: settings.AuthMode.Oidc)) is Err(AdminError.Invalid(field, _))
    expect field == "authMode"
    expect changeSettings(admin, settings.SettingsChange(authMode: settings.AuthMode.Oidc, oidcIssuer: "https://idp.test/application/o/abs/")) is Ok(view)
    expect view.authMode.value == "oidc"
    expect signin.loadSignInModes() == signin.SignInModes(password: false, oidc: true)
}
