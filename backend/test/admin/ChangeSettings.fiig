use hearsay.absclient as client
use hearsay.accounts
use hearsay.settings
use hearsay.settings.SignInConfig
use hearsay.signin

// A fake pins a setting's value, so these tests fake nothing an admin saves:
// with no environment, each starts unset (or at its default) and is saved.
test anAdminSavesSettingsAndCanForgetThem {
    root = accounts.Admin(
        identity: accounts.Identity(
            userId: "r1",
            username: "owner",
            userType: client.AbsUserType.Root,
        ),
    );
    before = showSettings(root);
    expect before.absUrl == settings.SettingValue(value: None, source: "unset");
    expect before.serviceToken == settings.SettingValue(value: None, source: "unset");
    expect before.mirrorEnabled == settings.SettingValue(value: "false", source: "environment");
    expect before.serverName == settings.SettingValue(value: None, source: "unset");
    expect settings.loadAbsTarget() is Err(settings.SettingsError.NoAbsUrl);
    change = settings.SettingsChange(
        absUrl: "  https://abs.home.test/ ",
        serviceToken: "new-token",
        mirrorEnabled: true,
        serverName: " Ryan's library ",
    );
    expect changeSettings(root, change) is Ok(after);
    expect after.absUrl == settings.SettingValue(value: "https://abs.home.test", source: "saved");
    expect after.serviceToken == settings.SettingValue(value: None, source: "saved");
    expect after.mirrorEnabled == settings.SettingValue(value: "true", source: "saved");
    expect after.serverName == settings.SettingValue(value: "Ryan's library", source: "saved");
    expect settings.serverName() == "Ryan's library";
    expect settings.loadAbsTarget() is Ok(target);
    expect target.url == "https://abs.home.test";
    expect target.token.matches("new-token");
    expect settings.mirrorEnabled();
    expect resetSetting(root, "absUrl") is Ok(reset);
    expect reset.absUrl == settings.SettingValue(value: None, source: "unset");
    expect resetSetting(root, "mirrorEnabled") is Ok(off);
    expect off.mirrorEnabled == settings.SettingValue(value: "false", source: "environment");
    expect resetSetting(root, "password") is Err(AdminError.UnknownSetting(_));
}

test aBadChangeSavesNothing {
    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "boss",
            userType: client.AbsUserType.Admin,
        ),
    );
    expect changeSettings(admin, settings.SettingsChange(absUrl: "https://abs.test", serviceToken: "old-token")) is Ok(_);
    expect changeSettings(admin, settings.SettingsChange(absUrl: "ftp://abs.test", serviceToken: "fine", mirrorEnabled: None)) is Err(AdminError.Invalid("absUrl", _));
    expect changeSettings(admin, settings.SettingsChange(absUrl: None, serviceToken: "   ", mirrorEnabled: None)) is Err(AdminError.Invalid("serviceToken", _));
    view = showSettings(admin);
    expect view.absUrl == settings.SettingValue(value: "https://abs.test", source: "saved");
    expect settings.loadAbsTarget() is Ok(target);
    expect target.token.matches("old-token");
}

test switchingToAuthentikTurnsPasswordSignInOff {
    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "boss",
            userType: client.AbsUserType.Admin,
        ),
    );
    authentik = settings.SettingsChange(
        oidcIssuer: "https://idp.test/application/o/abs/",
        oidcClientId: "cid",
    );
    expect changeSettings(admin, authentik) is Ok(_);
    expect signin.loadSignInModes() == signin.SignInModes(password: true, oidc: false);
    change = settings.SettingsChange(
        authMode: settings.AuthMode.Oidc,
        oidcClientSecret: "new-secret",
        oidcRedirectUri: "https://app.home.test/api/auth/callback/",
    );
    expect changeSettings(admin, change) is Ok(view);
    expect view.authMode == settings.SettingValue(value: "oidc", source: "saved");
    expect view.oidcClientSecret == settings.SettingValue(value: None, source: "saved");
    expect view.oidcRedirectUri == settings.SettingValue(value: "https://app.home.test/api/auth/callback", source: "saved");
    expect signin.loadSignInModes() == signin.SignInModes(password: false, oidc: true);
    expect resetSetting(admin, "authMode") is Ok(back);
    expect back.authMode == settings.SettingValue(value: "both", source: "environment");
    expect signin.loadSignInModes() == signin.SignInModes(password: true, oidc: true);
}

test authentikOnlyWaitsForEveryAuthentikSetting {
    fake SignInConfig {
        authMode: settings.AuthMode.Oidc
        frontendUrl: "https://app.test"
    }

    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "boss",
            userType: client.AbsUserType.Admin,
        ),
    );
    // AUTH_MODE=oidc with nothing for Authentik: password sign-in stays on rather than lock everyone out.
    expect signin.loadSignInModes() == signin.SignInModes(password: true, oidc: false);
    allButIssuer = settings.SettingsChange(
        oidcClientId: "cid",
        oidcClientSecret: "csec",
        oidcRedirectUri: "https://app.test/api/auth/callback",
    );
    expect changeSettings(admin, allButIssuer) is Err(AdminError.Invalid("authMode", _));
    expect showSettings(admin).oidcClientId == settings.SettingValue(value: None, source: "unset");
    every = settings.SettingsChange(
        oidcIssuer: "https://idp.test/application/o/abs/",
        oidcClientId: "cid",
        oidcClientSecret: "csec",
        oidcRedirectUri: "https://app.test/api/auth/callback",
    );
    expect changeSettings(admin, every) is Ok(_);
    expect signin.loadSignInModes() == signin.SignInModes(password: false, oidc: true);
}

// Every Authentik setting but the client secret: Authentik-only is refused, so
// nobody is locked out, until a change brings the secret too.
test authentikOnlyWaitsForTheClientSecret {
    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "boss",
            userType: client.AbsUserType.Admin,
        ),
    );
    allButSecret = settings.SettingsChange(
        oidcIssuer: "https://idp.test/application/o/abs/",
        oidcClientId: "cid",
        oidcRedirectUri: "https://app.test/api/auth/callback",
    );
    expect changeSettings(admin, allButSecret) is Ok(_);
    expect changeSettings(admin, settings.SettingsChange(authMode: settings.AuthMode.Oidc)) is Err(AdminError.Invalid("authMode", _));
    expect signin.loadSignInModes() == signin.SignInModes(password: true, oidc: false);
    expect changeSettings(admin, settings.SettingsChange(authMode: settings.AuthMode.Oidc, oidcClientSecret: "csec")) is Ok(view);
    expect view.oidcClientSecret == settings.SettingValue(value: None, source: "saved");
    expect signin.loadSignInModes() == signin.SignInModes(password: false, oidc: true);
}
