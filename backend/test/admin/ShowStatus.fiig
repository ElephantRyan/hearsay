use hearsay.absclient as client
use hearsay.absclient.AbsServer
use hearsay.absclient.members
use hearsay.absclient.members.AbsMembers
use hearsay.accounts
use hearsay.settings
use hearsay.settings.Abs
use hearsay.settings.Oidc
use hearsay.signin.authentik.AuthentikSignIn

test statusSaysWhoTheTokenBelongsTo {
    fake Abs {
        url: "https://abs.test"
    }
    fake Oidc {
        issuer: "https://idp.test/application/o/abs/"
        clientId: "cid"
        redirectUri: "https://app.test/api/auth/callback"
    }
    fake AuthentikSignIn {
        gateway discover(oidc: accounts.OidcSettings) -> Result<int, accounts.SignInError> {
            expect oidc.clientId == "cid"
            return Ok(200)
        }
    }
    fake AbsServer {
        gateway status(url: string) -> Result<int, client.AbsError> {
            expect url == "https://abs.test"
            return Ok(200)
        }
    }
    fake AbsMembers {
        gateway meAsService(abs: client.AbsTarget) -> Result<members.AbsUser, client.AbsError> {
            if abs.token.matches("good") {
                return Ok(members.AbsUser(id: "bot", username: "recommendation-bot", type: client.AbsUserType.Admin))
            }
            return Err(client.AbsError.Unauthorized)
        }
    }

    // "No token set" can't be tested: a test can't leave ABS_SERVICE_TOKEN unset (GAPS G53, G54).
    admin = accounts.Admin(identity: accounts.Identity(userId: "a1", username: "boss", userType: client.AbsUserType.Admin))
    settings.rememberSetting("oidc.clientSecret", "csec", "a1")
    settings.rememberSetting("abs.serviceToken", "good", "a1")
    good = showStatus(admin)
    expect good == AdminStatus(abs: "reachable", authentik: "answering", serviceAccount: "recommendation-bot", serviceAccountType: client.AbsUserType.Admin, problem: None)

    settings.rememberSetting("abs.serviceToken", "stale", "a1")
    refused = showStatus(admin)
    expect refused.problem == "Audiobookshelf refused the token."
}
