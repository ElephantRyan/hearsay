use abs.recommendations.absclient as client
use abs.recommendations.absclient.AbsServer
use abs.recommendations.absclient.members
use abs.recommendations.absclient.members.AbsMembers
use abs.recommendations.accounts
use abs.recommendations.sessions
use abs.recommendations.sessions.SessionConfig
use abs.recommendations.settings
use abs.recommendations.settings.Abs

test statusSaysWhoTheTokenBelongsTo {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsServer {
        gateway status(url: string) -> Result<int, client.AbsError> {
            expect url == "https://abs.test"
            return Ok(200)
        }
    }
    fake AbsMembers {
        gateway meAsService(abs: client.AbsTarget) -> Result<members.AbsUser, client.AbsError> {
            if abs.token.matches("good") {
                return Ok(members.AbsUser(id: "bot", username: "recommendation-bot", type: "admin"))
            }
            return Err(client.AbsError.Unauthorized)
        }
    }

    // "No token set" can't be tested: a test can't leave ABS_SERVICE_TOKEN unset (GAPS G53, G54).
    admin = sessions.startSession(accounts.Identity(userId: "a1", username: "boss", userType: "admin")).token
    settings.rememberSetting("abs.serviceToken", "good", "a1")
    expect showStatus(admin) is Ok(good)
    expect good == AdminStatus(abs: "reachable", serviceAccount: "recommendation-bot", serviceAccountType: "admin", problem: None)

    settings.rememberSetting("abs.serviceToken", "stale", "a1")
    expect showStatus(admin) is Ok(refused)
    expect refused.problem == "Audiobookshelf refused the token."
}
