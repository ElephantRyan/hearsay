use hearsay.absclient as client;
use hearsay.absclient.AbsServer;
use hearsay.absclient.members;
use hearsay.absclient.members.AbsMembers;
use hearsay.accounts;
use hearsay.settings;
use hearsay.settings.Abs;
use hearsay.settings.AbsService;
use hearsay.settings.Oidc;
use hearsay.signin.authentik.AuthentikSignIn;

test statusSaysWhoTheTokenBelongsTo {
    fake Abs {
        url: "https://abs.test";
    }

    fake AbsService {
        token: "good";
    }

    fake Oidc {
        issuer: "https://idp.test/application/o/abs/";
        clientId: "cid";
        clientSecret: "csec";
        redirectUri: "https://app.test/api/auth/callback";
    }

    fake AuthentikSignIn {
        gateway discover(oidc: accounts.OidcSettings) -> Result<int, accounts.SignInError> {
            expect oidc.clientId == "cid";
            return Ok(200);
        }
    }

    fake AbsServer {
        gateway status(url: string) -> Result<int, client.AbsError> {
            expect url == "https://abs.test";
            return Ok(200);
        }
    }

    fake AbsMembers {
        // The token the real gateway would send: saved in the app, or else the variable.
        gateway meAsService() -> Result<members.AbsUser, client.AbsError> {
            return match (AbsService.token) {
                None -> Err(client.AbsError.Unauthorized),
                token -> {
                    if (!token.matches("good")) {
                        return Err(client.AbsError.Unauthorized);
                    }

                    return Ok(
                        members.AbsUser(
                            id: "bot",
                            username: "recommendation-bot",
                            type: client.AbsUserType.Admin
                        )
                    );
                }
            }
        }
    }

    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "boss",
            userType: client.AbsUserType.Admin
        )
    );
    good = showStatus(admin);
    expect good == AdminStatus(abs: "reachable", authentik: "answering", serviceAccount: "recommendation-bot", serviceAccountType: client.AbsUserType.Admin, problem: None);
    // A token saved in the app wins over ABS_SERVICE_TOKEN.
    expect settings.applySettingsChange(settings.SettingsChange(serviceToken: "stale"), "a1") is Ok(_);
    refused = showStatus(admin);
    expect refused.problem == "Audiobookshelf refused the token.";
}

// A new server: Audiobookshelf answers, but no token is set anywhere and
// Authentik has no client secret, so the card says what is missing.
test statusSaysWhenNoTokenIsSet {
    fake Abs {
        url: "https://abs.test";
    }

    fake AbsService {
        token: None;
    }

    fake Oidc {
        issuer: "https://idp.test/application/o/abs/";
        clientId: "cid";
        clientSecret: None;
        redirectUri: "https://app.test/api/auth/callback";
    }

    fake AbsServer {
        gateway status(url: string) -> Result<int, client.AbsError> {
            return Ok(200);
        }
    }

    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "boss",
            userType: client.AbsUserType.Admin
        )
    );
    expect showStatus(admin) == AdminStatus(abs: "reachable", authentik: "not set up", serviceAccount: None, serviceAccountType: None, problem: "No Audiobookshelf token is set.");
}
