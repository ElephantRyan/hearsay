test searchTextIsTrimmedAndBounded {
    expect searchText(None) is Ok(None)
    expect searchText("   ") is Ok(None)
    expect searchText("  dune  ") is Ok(typed)
    expect typed == "dune"
    ten = "0123456789"
    hundred = "${ten}${ten}${ten}${ten}${ten}${ten}${ten}${ten}${ten}${ten}"
    expect searchText("${hundred}x") is Err(ApiError.Invalid(qField, qReason))
}
