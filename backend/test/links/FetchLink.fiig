use hearsay.absclient as client;
use hearsay.absclient.catalog;
use hearsay.absclient.catalog.AbsCatalog;
use hearsay.accounts;
use fiig.http;
use fiig.http.HttpClient;
use hearsay.settings;
use hearsay.settings.Abs;
use hearsay.settings.ServerConfig;
use hearsay.settings.SignInConfig;

// The fetching side, against a fake of the other server: its first answer has
// a book matched by ASIN, one by title and one this library hasn't (fetched as
// it is linked); its second
// only one; then it refuses the key, as after it unlinked this server.
test aFetchMatchesEachBookAndReplacesWhatWasHeld {
    fake ServerConfig {
        name: "Alex's library";
    }

    fake SignInConfig {
        authMode: settings.AuthMode.Abs;
        frontendUrl: "https://alex.test";
    }

    fake AbsCatalog {
        gateway librariesAsService() -> Result<List<catalog.AbsLibrary>, client.AbsError> {
            return Ok([catalog.AbsLibrary(id: "lib-1", name: "Audiobooks", mediaType: "book")]);
        }

        gateway pageAsService(libraryId: string, page: int, size: int, order: catalog.BookOrder)
                -> Result<catalog.BookPage, client.AbsError> {
            return Ok(
                catalog.BookPage(
                    total: 2,
                    page: 0,
                    limit: size,
                    books: [
                        catalog.Book(
                            itemId: "dune-here",
                            libraryId: "lib-1",
                            title: "Dune",
                            authors: "Frank Herbert",
                            asin: "B0DUNE",
                            isbn: None,
                        ),
                        catalog.Book(
                            itemId: "hobbit-here",
                            libraryId: "lib-1",
                            title: "The Hobbit",
                            authors: "J. R. R. Tolkien",
                            asin: None,
                            isbn: None,
                        ),
                    ],
                ),
            );
        }
    }

    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if (request.url == "https://ryan.test/api/federation/link" && request.method == http.Method.Post) {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: json.encode(
                            LinkAcceptance(name: "Ryan's library", key: "k".padRight(43, "k")),
                        ),
                    ),
                );
            }

            if (request.url == "https://ryan.test/api/federation/fetch") {
                return Ok(http.Reply(status: 204, headers: [], body: "".utf8()));
            }

            if (request.method == http.Method.Delete) {
                return Err(http.HttpError.InvalidRequest(reason: "gone"));
            }

            expect request.url == "https://ryan.test/api/federation/recommendations";
            expect http.headerValue(request.headers, "authorization") == "Bearer ${"k".padRight(43, "k")}";
            if (calls(HttpClient.send) == 2) {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: json.encode(
                            [
                                SharedRating(
                                    personId: "p1",
                                    username: "ryan",
                                    asin: "b0dune",
                                    isbn: None,
                                    title: "Dune: Book One",
                                    authors: "Frank Herbert",
                                    score: 9,
                                    note: "great",
                                    updatedAt: 1,
                                ),
                                SharedRating(
                                    personId: "p1",
                                    username: "ryan",
                                    asin: "B0OTHER-REGION",
                                    isbn: None,
                                    title: "The Hobbit",
                                    authors: "J.R.R. Tolkien",
                                    score: None,
                                    note: "",
                                    updatedAt: 2,
                                ),
                                SharedRating(
                                    personId: "p2",
                                    username: "sam",
                                    asin: "B0NOTHERE",
                                    isbn: None,
                                    title: "Not Here",
                                    authors: "Nobody",
                                    score: 7,
                                    note: "",
                                    updatedAt: 3,
                                ),
                            ],
                        ),
                    ),
                );
            }

            if (calls(HttpClient.send) == 4) {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: json.encode(
                            [
                                SharedRating(
                                    personId: "p1",
                                    username: "ryan",
                                    asin: "B0DUNE",
                                    isbn: None,
                                    title: "Dune",
                                    authors: "Frank Herbert",
                                    score: 10,
                                    note: "even better",
                                    updatedAt: 4,
                                ),
                            ],
                        ),
                    ),
                );
            }

            return Ok(
                http.Reply(
                    status: 401,
                    headers: [http.Header(name: "Content-Type", value: "text/plain")],
                    body: "that key belongs to no linked server".utf8(),
                ),
            );
        }
    }

    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "alex",
            userType: client.AbsUserType.Admin,
        ),
    );
    expect linkServer(admin, LinkRequest(code: "https://ryan.test#${"s".padRight(43, "s")}")) is Ok(link);
    // Linking builds the empty index, then fetches at once.
    first = link;
    expect calls(AbsCatalog.pageAsService) == 1;
    expect first.ratings == 3;
    expect first.matched == 2;
    expect first.problem == None;
    expect first.lastFetchedAt != None;
    held = linkedRatingsOf(link.id);
    expect held.length() == 3;
    expect (filter(r in held): r.title == "Dune: Book One").first().itemId == "dune-here";
    expect (filter(r in held): r.title == "Dune: Book One").first().matchedBy == "asin";
    expect (filter(r in held): r.title == "The Hobbit").first().matchedBy == "title";
    // A recommendation can cross without a score.
    expect (filter(r in held): r.title == "The Hobbit").first().score == None;
    expect (filter(r in held): r.title == "Not Here").first().itemId == None;
    // A second fetch replaces the first; the index isn't rebuilt.
    expect refreshLink(admin, link.id) is Ok(second);
    expect calls(AbsCatalog.pageAsService) == 1;
    expect second.ratings == 1;
    expect linkedRatingsOf(link.id).length() == 1;
    expect linkedRatingsOf(link.id).first().score == 10;
    // Refused: what was held stays, and the screen says why and since when.
    expect refreshLink(admin, link.id) is Ok(refused);
    expect refused.ratings == 1;
    expect refused.notAnsweringSince != None;
    match (refused.problem) {
        None -> {
            expect false;
        },

        problem -> {
            expect problem.contains("may have unlinked");
        },
    }

    expect linkedRatingsOf(link.id).length() == 1;
    expect refreshLink(admin, link.id) is Ok(again);
    expect again.notAnsweringSince == refused.notAnsweringSince;
    // Unlinking forgets what was fetched, even when the other side can't be told.
    expect unlinkServer(admin, link.id) is Ok(_);
    expect linkedRatingsOf(link.id).length() == 0;
    expect refreshLink(admin, link.id) is Err(LinkError.UnknownLink);
}

// With no links the scheduled fetch does nothing. With one, a library index
// that can't be rebuilt is logged, but the fetch still runs on the old index:
// ABS answers the listing once, when linking builds the index, then fails.
test theScheduledFetchRunsEvenWhenTheIndexCantBeRebuilt {
    fake ServerConfig {
        name: "Alex's library";
    }

    fake SignInConfig {
        authMode: settings.AuthMode.Abs;
        frontendUrl: "https://alex.test";
    }

    fake AbsCatalog {
        gateway librariesAsService() -> Result<List<catalog.AbsLibrary>, client.AbsError> {
            if (calls(AbsCatalog.librariesAsService) == 1) {
                return Ok([catalog.AbsLibrary(id: "lib-1", name: "Audiobooks", mediaType: "book")]);
            }

            return Err(client.AbsError.Rejected(status: 502));
        }

        gateway pageAsService(libraryId: string, page: int, size: int, order: catalog.BookOrder)
                -> Result<catalog.BookPage, client.AbsError> {
            return Ok(
                catalog.BookPage(
                    total: 1,
                    page: 0,
                    limit: size,
                    books: [
                        catalog.Book(
                            itemId: "dune-here",
                            libraryId: "lib-1",
                            title: "Dune",
                            authors: "Frank Herbert",
                            asin: "B0DUNE",
                            isbn: None,
                        ),
                    ],
                ),
            );
        }
    }

    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if (request.url == "https://ryan.test/api/federation/link") {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: json.encode(
                            LinkAcceptance(name: "Ryan's library", key: "k".padRight(43, "k")),
                        ),
                    ),
                );
            }

            if (request.url == "https://ryan.test/api/federation/fetch") {
                return Ok(http.Reply(status: 204, headers: [], body: "".utf8()));
            }

            return Ok(
                http.Reply(
                    status: 200,
                    headers: [],
                    body: json.encode(
                        [
                            SharedRating(
                                personId: "p1",
                                username: "ryan",
                                asin: "B0DUNE",
                                isbn: None,
                                title: "Dune",
                                authors: "Frank Herbert",
                                score: 9,
                                note: "",
                                updatedAt: 1,
                            ),
                        ],
                    ),
                ),
            );
        }
    }

    expect fetchOnSchedule() is Ok(0);
    expect calls(HttpClient.send) == 0;
    expect calls(AbsCatalog.librariesAsService) == 0;
    admin = accounts.Admin(
        identity: accounts.Identity(
            userId: "a1",
            username: "alex",
            userType: client.AbsUserType.Admin,
        ),
    );
    expect linkServer(admin, LinkRequest(code: "https://ryan.test#${"s".padRight(43, "s")}")) is Ok(link);
    expect fetchOnSchedule() is Err(FetchError.IndexNotRebuilt(problem));
    expect problem == "Audiobookshelf answered 502";
    expect calls(AbsCatalog.librariesAsService) == 2;
    expect calls(HttpClient.send) == 4;
    held = linkedRatingsOf(link.id);
    expect held.length() == 1;
    expect held.first().itemId == "dune-here";
}
