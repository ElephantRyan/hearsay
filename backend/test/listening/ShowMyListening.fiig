use abs.recommendations.absclient as client
use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.absclient.progress
use abs.recommendations.absclient.progress.AbsProgress
use abs.recommendations.accounts
use abs.recommendations.common
use abs.recommendations.ratings
use abs.recommendations.sessions
use abs.recommendations.sessions.SessionConfig

test myListeningIsMostRecentFirstWithMyScores {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsProgress {
        gateway progressAsService(userId: string) -> Result<List<progress.Progress>, client.AbsError> {
            expect userId == "u1"
            return Ok(
                [progress.Progress(itemId: "a", finished: true, percent: 100, lastListenedAt: 100), progress.Progress(itemId: "b", finished: false, percent: 25, lastListenedAt: 300), progress.Progress(itemId: "gone", finished: false, percent: 50, lastListenedAt: 200)],
            )
        }
    }
    fake AbsCatalog {
        gateway itemAsService(itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(
                catalog.Book(itemId: itemId, libraryId: "lib-1", title: "Alpha", authors: "A. Author"),
            )
        }

        gateway itemsAsService(itemIds: List<string>) -> Result<List<catalog.Book>, client.AbsError> {
            expect itemIds == ["b", "gone"]
            return Ok(
                [catalog.Book(itemId: "b", libraryId: "lib-1", title: "Beta", authors: "B. Author")],
            )
        }
    }

    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: "user")).token
    expect ratings.putRating(ann, "a", ratings.RatingInput(score: 8, note: None, recommended: true)) is Ok(_)
    expect showMyListening(None) is Err(common.ApiError.Unauthenticated)
    expect showMyListening(ann) is Ok(listened)
    expect listened == [ListenedBook(itemId: "b", libraryId: "lib-1", title: "Beta", authors: "B. Author", finished: false, percent: 25, lastListenedAt: 300, myScore: None, recommended: false), ListenedBook(itemId: "a", libraryId: "lib-1", title: "Alpha", authors: "A. Author", finished: true, percent: 100, lastListenedAt: 100, myScore: 8, recommended: true)]
}

test myListeningCachesWhatItLooksUp {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsProgress {
        gateway progressAsService(userId: string) -> Result<List<progress.Progress>, client.AbsError> {
            return Ok(
                [progress.Progress(itemId: "b", finished: false, percent: 25, lastListenedAt: 300)],
            )
        }
    }
    fake AbsCatalog {
        gateway itemsAsService(itemIds: List<string>) -> Result<List<catalog.Book>, client.AbsError> {
            expect calls(AbsCatalog.itemsAsService) == 1
            return Ok(
                [catalog.Book(itemId: "b", libraryId: "lib-1", title: "Beta", authors: "B. Author")],
            )
        }
    }

    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: "user")).token
    expect showMyListening(ann) is Ok(first)
    expect showMyListening(ann) is Ok(second)
    expect second == first
}

test myListeningSaysWhenAbsIsDown {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsProgress {
        gateway progressAsService(userId: string) -> Result<List<progress.Progress>, client.AbsError> {
            return Err(client.AbsError.Unauthorized)
        }
    }

    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: "user")).token
    expect showMyListening(ann) is Err(common.ApiError.Unavailable(why))
    expect why == "this server's Audiobookshelf token was refused; tell the server's admin"
}
