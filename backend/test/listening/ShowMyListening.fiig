use hearsay.absclient as client
use hearsay.absclient.catalog
use hearsay.absclient.catalog.AbsCatalog
use hearsay.absclient.progress
use hearsay.absclient.progress.AbsProgress
use hearsay.accounts
use hearsay.ratings
use hearsay.sessions
use hearsay.sessions.SessionConfig
use hearsay.settings
use hearsay.settings.Abs

test myListeningIsMostRecentFirstWithMyScores {
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsProgress {
        gateway progressAsService(abs: client.AbsTarget, userId: string) -> Result<List<progress.Progress>, client.AbsError> {
            expect userId == "u1"
            return Ok(
                [progress.Progress(itemId: "a", finished: true, percent: 100, lastListenedAt: 100), progress.Progress(itemId: "b", finished: false, percent: 25, lastListenedAt: 300), progress.Progress(itemId: "gone", finished: false, percent: 50, lastListenedAt: 200)],
            )
        }
    }
    fake AbsCatalog {
        gateway itemAsService(abs: client.AbsTarget, itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(
                catalog.Book(itemId: itemId, libraryId: "lib-1", title: "Alpha", authors: "A. Author"),
            )
        }

        gateway itemsAsService(abs: client.AbsTarget, itemIds: List<string>) -> Result<List<catalog.Book>, client.AbsError> {
            expect itemIds == ["b", "gone"]
            return Ok(
                [catalog.Book(itemId: "b", libraryId: "lib-1", title: "Beta", authors: "B. Author")],
            )
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)).token
    expect ratings.putRating(ann, "a", ratings.RatingInput(score: 8, note: None, recommended: true)) is Ok(_)
    expect showMyListening(None) is Err(ListeningError.NotSignedIn)
    expect showMyListening(ann) is Ok(listened)
    expect listened == [ListenedBook(itemId: "b", libraryId: "lib-1", title: "Beta", authors: "B. Author", finished: false, percent: 25, lastListenedAt: 300, myScore: None, recommended: false), ListenedBook(itemId: "a", libraryId: "lib-1", title: "Alpha", authors: "A. Author", finished: true, percent: 100, lastListenedAt: 100, myScore: 8, recommended: true)]
}

test myListeningCachesWhatItLooksUp {
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsProgress {
        gateway progressAsService(abs: client.AbsTarget, userId: string) -> Result<List<progress.Progress>, client.AbsError> {
            return Ok(
                [progress.Progress(itemId: "b", finished: false, percent: 25, lastListenedAt: 300)],
            )
        }
    }
    fake AbsCatalog {
        gateway itemsAsService(abs: client.AbsTarget, itemIds: List<string>) -> Result<List<catalog.Book>, client.AbsError> {
            expect calls(AbsCatalog.itemsAsService) == 1
            return Ok(
                [catalog.Book(itemId: "b", libraryId: "lib-1", title: "Beta", authors: "B. Author")],
            )
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)).token
    expect showMyListening(ann) is Ok(first)
    expect showMyListening(ann) is Ok(second)
    expect second == first
}

test myListeningSaysWhenAbsIsDown {
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsProgress {
        gateway progressAsService(abs: client.AbsTarget, userId: string) -> Result<List<progress.Progress>, client.AbsError> {
            return Err(client.AbsError.Unauthorized)
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)).token
    expect showMyListening(ann) is Err(ListeningError.Unavailable(why))
    expect why == "this server's Audiobookshelf token was refused; tell the server's admin"
}

test myListeningSaysWhenAbsHasNoAccountForMe {
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsProgress {
        gateway progressAsService(abs: client.AbsTarget, userId: string) -> Result<List<progress.Progress>, client.AbsError> {
            return Err(client.AbsError.NotFound)
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)).token
    expect showMyListening(ann) is Err(ListeningError.AccountNotFound)
}
