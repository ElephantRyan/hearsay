use hearsay.ratings.rated;

// Most recommended first; then the higher average, a book nobody scored after
// any that were; then the most recently rated.
test rankingOrdersByRecommendationsThenAverageThenRecency {
    rows = [
        row("u1", "dune", 9, true, 1),
        row("u2", "dune", 8, true, 2),
        row("u1", "emma", 9, true, 3),
        row("u1", "ubik", 9, true, 4),
        row("u2", "ubik", 8, true, 5),
        row("u3", "ubik", 9, true, 6),
        row("u1", "kim", 8, true, 7),
        row("u2", "kim", 9, true, 8),
        row("u1", "secret", 10, false, 9),
        row("u1", "wool", None, true, 10),
        row("u2", "wool", None, true, 11),
        row("u3", "wool", None, true, 12),
        row("u4", "silo", None, true, 13),
        row("u1", "lamb", 6, true, 14),
        row("u2", "lamb", None, true, 15)
    ];
    ranked = rankRecommendations(rows);
    order = map(b in ranked): b.itemId;
    expect order == ["ubik", "wool", "kim", "dune", "lamb", "emma", "silo"];
    expect ranked.at(0).average == 8.67;
    expect ranked.at(0).count == 3;
    expect ranked.at(1).average == None;
    expect ranked.at(1).count == 3;
    // lamb's one score is its average; the unscored recommendation still counts
    expect ranked.at(2).average == 8.5;
    expect ranked.at(4).average == 6.00;
    expect ranked.at(4).count == 2;
    expect ranked.at(0).title == "Title of ubik";
}

private {
    row(userId: string, itemId: string, score: int | None, recommended: bool, at: int)
            -> rated.RatingRow {
        return rated.RatingRow(
            userId: userId,
            username: "name-${userId}",
            itemId: itemId,
            libraryId: "lib-1",
            title: "Title of ${itemId}",
            authors: "An Author",
            score: score,
            note: "",
            recommended: recommended,
            createdAt: at,
            updatedAt: at,
            noteShared: false
        );
    }
}
