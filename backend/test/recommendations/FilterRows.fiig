use hearsay.ratings.rated;

test filtersAndMinScore {
    rows = [
        rated.RatingRow(
            userId: "u1",
            username: "ann",
            itemId: "a",
            libraryId: "lib-1",
            title: "A",
            authors: "x",
            score: 9,
            note: "",
            recommended: true,
            createdAt: 1,
            updatedAt: 1,
            noteShared: false,
        ),
        rated.RatingRow(
            userId: "u2",
            username: "bob",
            itemId: "b",
            libraryId: "lib-2",
            title: "B",
            authors: "x",
            score: 6,
            note: "",
            recommended: true,
            createdAt: 2,
            updatedAt: 2,
            noteShared: false,
        ),
    ];
    expect filterRows(rows, None, None).length() == 2;
    expect filterRows(rows, "u1", None).length() == 1;
    expect filterRows(rows, None, "lib-2").at(0).itemId == "b";
    expect filterRows(rows, "u1", "lib-2").length() == 0;
    ranked = rankRecommendations(rows);
    expect atLeast(ranked, None).length() == 2;
    expect atLeast(ranked, 7).length() == 1;
    expect atLeast(ranked, 7).at(0).itemId == "a";
    expect recommendersOf(rows).length() == 2;
    expect bestFirst(rows, "u2").at(0).itemId == "b";
}
