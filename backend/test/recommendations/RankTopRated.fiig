use hearsay.ratings.rated;

// Highest average first, among books with at least two scores; a lone 10 and
// private or unscored ratings don't count.
test topRatedNeedsTwoScoresAndIgnoresPrivateOnes {
    rows = [
        row("u1", "dune", 9, true, 1),
        row("u2", "dune", 8, true, 2),
        row("u1", "emma", 10, true, 3),
        row("u1", "ubik", 9, true, 4),
        row("u2", "ubik", 10, true, 5),
        row("u1", "kim", 7, true, 6),
        row("u2", "kim", 7, true, 7),
        row("u3", "kim", 2, false, 8),
        row("u1", "wool", None, true, 9),
        row("u2", "wool", 6, true, 10),
    ];
    ranked = rankTopRated(rows);
    order = map(b in ranked): b.itemId;
    expect order == ["ubik", "dune", "kim"];
    expect ranked.at(0).average == 9.50;
    expect ranked.at(2).average == 7.00;
    expect ranked.at(2).count == 2;
}

private {
    row(userId: string, itemId: string, score: int | None, recommended: bool, at: int)
            -> rated.RatingRow {
        return rated.RatingRow(
            userId: userId,
            username: "name-${userId}",
            itemId: itemId,
            libraryId: "lib-1",
            title: "Title of ${itemId}",
            authors: "An Author",
            score: score,
            note: "",
            recommended: recommended,
            createdAt: at,
            updatedAt: at,
        );
    }
}
