use hearsay.absclient as client
use hearsay.accounts
use hearsay.common

test sessionsExpireAndEndWithLogOut {
    fake SessionConfig {
        sessionMaxAge: 3600
    }

    identity = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)
    session = startSession(identity)
    expect currentUser(session.token) is Ok(found)
    expect found == identity
    expect currentUser("not-a-token") is Err(common.ApiError.Unauthenticated)
    expect currentUser(None) is Err(common.ApiError.Unauthenticated)
    saveSession(tokenHash("old"), identity, 1)
    expect currentUser("old") is Err(common.ApiError.Unauthenticated)
    expect logOut(session.token) == 1
    expect currentUser(session.token) is Err(common.ApiError.Unauthenticated)
    expect logOut(None) == 0
}
