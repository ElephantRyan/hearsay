use hearsay.absclient as client;
use hearsay.absclient.catalog;
use hearsay.absclient.catalog.AbsCatalog;
use hearsay.absclient.collections.AbsCollections;
use hearsay.accounts;
use hearsay.ratings;
use hearsay.series;
use hearsay.settings;
use hearsay.settings.Abs;
use hearsay.settings.AbsService;
use hearsay.settings.SyncConfig;
use hearsay.sync;

// "Top 10 Series" holds each recommended series as its book 1; "Top 25
// Standalones" the recommended books in no series, most recommended first.
// Turning them on makes them first in ABS (oldest first): they are made, then
// everyone's own collections are made again after them. After that a sync only
// updates; each one's setting turns it off on its own.
test topSeriesAndStandalonesComeFirstAndGoWhenTurnedOff {
    fake AbsService {
        token: "svc";
    }

    fake Abs {
        url: "https://abs.test";
    }

    fake SyncConfig {
        mirrorEnabled: true;
        topSeries: false;
        topStandalones: false;
    }

    fake AbsCatalog {
        gateway itemAsService(itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(
                catalog.Book(
                    itemId: itemId,
                    libraryId: "lib-1",
                    title: "T",
                    authors: "A",
                    series: [],
                ),
            );
        }

        gateway itemsAsService(itemIds: List<string>)
                -> Result<List<catalog.Book>, client.AbsError> {
            return Ok(
                map(id in itemIds):
                        catalog.Book(
                            itemId: id,
                            libraryId: "lib-1",
                            title: "T",
                            authors: "A",
                            series: [],
                        ),
            );
        }

        gateway seriesAsService(seriesId: string)
                -> Result<catalog.CatalogSeries, client.AbsError> {
            return Ok(
                catalog.CatalogSeries(
                    seriesId: "dcc",
                    libraryId: "lib-1",
                    name: "Dungeon Crawler Carl",
                    authors: "Matt Dinniman",
                    bookIds: ["dcc-1", "dcc-2"],
                ),
            );
        }
    }

    fake AbsCollections {
        gateway createCollectionAsService(
            libraryId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<string, client.AbsError> {
            n = calls(AbsCollections.createCollectionAsService);
            // 1-2: everyone's own; 3-4: the two tops, in order; 5-6: everyone's own again.
            if (n == 3) {
                expect name == "Top 10 Series";
                expect bookIds == ["dcc-1"];
            } else if (n == 4) {
                expect name == "Top 25 Standalones";
                expect bookIds == ["a", "b"];
            } else {
                expect name.endsWith(" Recommends");
            }

            return Ok("col-${n}");
        }

        gateway updateCollectionAsService(
            collectionId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<int, client.AbsError> {
            return Ok(200);
        }

        gateway deleteCollectionAsService(collectionId: string) -> Result<int, client.AbsError> {
            return Ok(200);
        }
    }

    ann = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User);
    bob = accounts.Identity(userId: "u2", username: "bob", userType: client.AbsUserType.User);
    expect ratings.putRating(ann, "a", ratings.RatingInput(score: 9, note: None, recommended: true)) is Ok(_);
    expect ratings.putRating(ann, "b", ratings.RatingInput(score: 7, note: None, recommended: true)) is Ok(_);
    expect ratings.putRating(bob, "a", ratings.RatingInput(score: 8, note: None, recommended: true)) is Ok(_);
    expect series.putSeriesRating(ann, "dcc", ratings.RatingInput(score: 9, note: None, recommended: true)) is Ok(_);
    expect sync.syncOnSchedule() is Ok(2);
    expect calls(AbsCollections.createCollectionAsService) == 2;
    expect settings.applySettingsChange(settings.SettingsChange(topSeries: true, topStandalones: true), "a1") is Ok(_);
    expect sync.syncOnSchedule() is Ok(4);
    expect calls(AbsCollections.createCollectionAsService) == 6;
    expect calls(AbsCollections.deleteCollectionAsService) == 2;
    // In order now: nothing is made or deleted again.
    expect sync.syncOnSchedule() is Ok(4);
    expect calls(AbsCollections.createCollectionAsService) == 6;
    expect calls(AbsCollections.deleteCollectionAsService) == 2;
    // Standalones off on its own: only that one goes.
    expect settings.applySettingsChange(settings.SettingsChange(topStandalones: false), "a1") is Ok(_);
    expect sync.syncOnSchedule() is Ok(4);
    expect calls(AbsCollections.deleteCollectionAsService) == 3;
    expect calls(AbsCollections.createCollectionAsService) == 6;
}
