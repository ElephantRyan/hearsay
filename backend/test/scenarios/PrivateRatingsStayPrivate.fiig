use hearsay.absclient as client
use hearsay.absclient.catalog
use hearsay.absclient.catalog.AbsCatalog
use hearsay.accounts
use hearsay.library
use hearsay.ratings
use hearsay.recommendations
use hearsay.sessions
use hearsay.sessions.SessionConfig
use hearsay.settings
use hearsay.settings.Abs

test privateRatingsStayPrivate {
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsCatalog {
        gateway itemAsService(abs: client.AbsTarget, itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(
                catalog.Book(itemId: itemId, libraryId: "lib-1", title: "Dune", authors: "Frank Herbert"),
            )
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: "user")).token
    bob = sessions.startSession(accounts.Identity(userId: "u2", username: "bob", userType: "user")).token
    expect ratings.putRating(ann, "dune", ratings.RatingInput(score: 10, note: "secret love", recommended: false)) is Ok(_)
    expect ratings.putRating(bob, "dune", ratings.RatingInput(score: 6, note: "fine", recommended: true)) is Ok(_)
    expect library.loadItemDetail(bob, "dune") is Ok(bobSees)
    expect bobSees.ratings.length() == 1
    expect bobSees.count == 1
    expect bobSees.average == 6.00
    expect library.loadItemDetail(ann, "dune") is Ok(annSees)
    expect annSees.ratings.length() == 2
    expect annSees.count == 1
    expect annSees.average == 6.00
    expect recommendations.recommendations(bob, None, None, None) is Ok(listed)
    expect listed.length() == 1
    expect listed.at(0).average == 6.00
    expect recommendations.listRecommenders(bob) is Ok(people)
    expect people.length() == 1
    expect people.at(0).username == "bob"
    expect recommendations.picksOf(bob, "u1") is Ok(annsPicks)
    expect annsPicks.length() == 0
}
