use abs.recommendations.absclient as client
use abs.recommendations.absclient.AbsApi
use abs.recommendations.accounts
use abs.recommendations.ratings
use abs.recommendations.recommendations
use abs.recommendations.sessions
use abs.recommendations.sessions.SessionConfig

test privateRatingsStayPrivate {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsApi {
        gateway itemAsService(itemId: string) -> Result<client.Book, client.AbsError> {
            return Ok(
                client.Book(itemId: itemId, libraryId: "lib-1", title: "Dune", authors: "Frank Herbert"),
            )
        }
    }

    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: "user")).token
    bob = sessions.startSession(accounts.Identity(userId: "u2", username: "bob", userType: "user")).token
    // ratings are stored through putRating's two steps: another package's workflow is out of a test's reach (ADR 0079 §1)
    expect ratings.loadUserAndBook(ann, "dune") is Ok(annDune)
    expect ratings.storeRating(annDune, ratings.RatingInput(score: 10, note: "secret love", recommended: false)) is Ok(_)
    expect ratings.loadUserAndBook(bob, "dune") is Ok(bobDune)
    expect ratings.storeRating(bobDune, ratings.RatingInput(score: 6, note: "fine", recommended: true)) is Ok(_)
    expect ratings.loadItemDetail(bob, "dune") is Ok(bobSees)
    expect bobSees.ratings.length() == 1
    expect bobSees.count == 1
    expect bobSees.average == 6.00
    expect ratings.loadItemDetail(ann, "dune") is Ok(annSees)
    expect annSees.ratings.length() == 2
    expect annSees.count == 1
    expect annSees.average == 6.00
    expect recommendations.recommendations(bob, None, None, None) is Ok(listed)
    expect listed.length() == 1
    expect listed.at(0).average == 6.00
    expect recommendations.listRecommenders(bob) is Ok(people)
    expect people.length() == 1
    expect people.at(0).username == "bob"
    expect recommendations.picksOf(bob, "u1") is Ok(annsPicks)
    expect annsPicks.length() == 0
}
