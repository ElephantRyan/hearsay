use abs.recommendations.ratings.rated

test planSyncCreatesUpdatesAndRemoves {
    rows = [
        rated.RatingRow(userId: "u1", username: "Ann", itemId: "a", libraryId: "lib-1", title: "A", authors: "x", score: 7, note: "", recommended: true, createdAt: 1, updatedAt: 1),
        rated.RatingRow(userId: "u1", username: "Ann", itemId: "b", libraryId: "lib-1", title: "B", authors: "x", score: 9, note: "", recommended: true, createdAt: 2, updatedAt: 2),
        rated.RatingRow(userId: "u1", username: "Ann", itemId: "c", libraryId: "lib-1", title: "C", authors: "x", score: 10, note: "", recommended: false, createdAt: 3, updatedAt: 3),
        rated.RatingRow(userId: "u1", username: "Ann", itemId: "d", libraryId: "lib-2", title: "D", authors: "x", score: 8, note: "", recommended: true, createdAt: 4, updatedAt: 4),
    ]
    states = [
        SyncState(userId: "u1", libraryId: "lib-2", collectionId: "col-2", lastSyncedAt: 1, lastError: None),
        SyncState(userId: "u1", libraryId: "lib-3", collectionId: "col-3", lastSyncedAt: 1, lastError: None),
        SyncState(userId: "u9", libraryId: "lib-1", collectionId: "col-9", lastSyncedAt: 1, lastError: None),
    ]
    plans = planSync(rows, states, ["u1"])
    expect plans.length() == 3
    first = plans.at(0)
    expect first.libraryId == "lib-1"
    expect first.action == "create"
    expect first.name == "Ann Recommends"
    expect first.bookIds == ["b", "a"]
    expect first.collectionId == None
    second = plans.at(1)
    expect second.libraryId == "lib-2"
    expect second.action == "update"
    expect second.collectionId == "col-2"
    third = plans.at(2)
    expect third.libraryId == "lib-3"
    expect third.action == "remove"
    expect third.collectionId == "col-3"
}
