use abs.recommendations.absclient as client
use abs.recommendations.absclient.AbsApi
use abs.recommendations.signin
use abs.recommendations.common
use abs.recommendations.ratings
use abs.recommendations.sessions
use abs.recommendations.sessions.Server

test syncDryRunsByDefaultAndOnlyWritesWhenAskedTo {
    fake Server {
        sessionMaxAge: 3600
        mirrorEnabled: true
    }
    fake AbsApi {
        gateway itemAsService(itemId: string) -> Result<client.Book, client.AbsError> {
            return Ok(client.Book(itemId: itemId, libraryId: "lib-1", title: "T", authors: "A"))
        }

        gateway createCollectionAsService(libraryId: string, name: string, description: string, bookIds: List<string>) -> Result<string, client.AbsError> {
            expect name == "ann Recommends"
            if calls(AbsApi.createCollectionAsService) == 1 {
                expect bookIds == ["b", "a"]
            } else {
                expect bookIds == ["a"]
            }
            return Ok("col-${calls(AbsApi.createCollectionAsService)}")
        }

        gateway updateCollectionAsService(collectionId: string, name: string, description: string, bookIds: List<string>) -> Result<int, client.AbsError> {
            if collectionId == "col-1" and bookIds.length() == 1 {
                return Err(client.AbsError.NotFound)
            }
            return Ok(200)
        }

        gateway deleteCollectionAsService(collectionId: string) -> Result<int, client.AbsError> {
            return Ok(200)
        }
    }

    ann = sessions.startSession(signin.Identity(userId: "u1", username: "ann", userType: "user")).token
    expect ratings.putRating(ann, "a", ratings.RatingInput(score: 7, note: None, recommended: true)) is Ok(_)
    expect ratings.putRating(ann, "b", ratings.RatingInput(score: 9, note: None, recommended: true)) is Ok(_)
    expect syncCollections(ann, None, None) is Ok(preview)
    expect preview.length() == 1
    expect preview.at(0).action == "would-create"
    expect preview.at(0).books == 2
    expect calls(AbsApi.createCollectionAsService) == 0
    expect allSyncStates().length() == 0
    expect syncCollections(ann, None, false) is Ok(first)
    expect first.at(0).action == "created"
    expect allSyncStates().length() == 1
    expect allSyncStates().at(0).collectionId == "col-1"
    expect syncCollections(ann, None, false) is Ok(second)
    expect second.at(0).action == "updated"
    expect calls(AbsApi.createCollectionAsService) == 1
    // someone deleted our collection in ABS: the update says 404, so it is made again
    expect ratings.putRating(ann, "b", ratings.RatingInput(score: 9, note: None, recommended: false)) is Ok(_)
    expect syncCollections(ann, None, false) is Ok(recreated)
    expect recreated.at(0).action == "created"
    expect calls(AbsApi.createCollectionAsService) == 2
    // nothing left to recommend: our collection is removed and forgotten
    expect ratings.putRating(ann, "a", ratings.RatingInput(score: 7, note: None, recommended: false)) is Ok(_)
    expect syncCollections(ann, None, false) is Ok(removed)
    expect removed.at(0).action == "removed"
    expect allSyncStates().length() == 0
    expect calls(AbsApi.deleteCollectionAsService) == 1
}

test syncIsOffByDefaultAndPrivateToTheirOwner {
    fake Server {
        sessionMaxAge: 3600
        mirrorEnabled: false
    }
    fake AbsApi {
        gateway createCollectionAsService(libraryId: string, name: string, description: string, bookIds: List<string>) -> Result<string, client.AbsError> {
            expect false
            return Err(client.AbsError.NotFound)
        }

        gateway updateCollectionAsService(collectionId: string, name: string, description: string, bookIds: List<string>) -> Result<int, client.AbsError> {
            expect false
            return Err(client.AbsError.NotFound)
        }

        gateway deleteCollectionAsService(collectionId: string) -> Result<int, client.AbsError> {
            expect false
            return Err(client.AbsError.NotFound)
        }
    }

    ann = sessions.startSession(signin.Identity(userId: "u1", username: "ann", userType: "user")).token
    expect syncCollections(ann, None, false) is Err(common.ApiError.NotFound(what))
    // disabled means disabled for everyone: a stranger learns nothing about sessions
    expect syncCollections(None, None, false) is Err(common.ApiError.NotFound(missing))
}

test aPersonCannotSyncSomeoneElsesList {
    fake Server {
        sessionMaxAge: 3600
        mirrorEnabled: true
    }
    fake AbsApi {
        gateway createCollectionAsService(libraryId: string, name: string, description: string, bookIds: List<string>) -> Result<string, client.AbsError> {
            expect false
            return Err(client.AbsError.NotFound)
        }

        gateway updateCollectionAsService(collectionId: string, name: string, description: string, bookIds: List<string>) -> Result<int, client.AbsError> {
            return Ok(200)
        }

        gateway deleteCollectionAsService(collectionId: string) -> Result<int, client.AbsError> {
            return Ok(200)
        }
    }

    ann = sessions.startSession(signin.Identity(userId: "u1", username: "ann", userType: "user")).token
    expect syncCollections(ann, "u2", false) is Err(common.ApiError.Refused(why))
    expect calls(AbsApi.createCollectionAsService) == 0
}
