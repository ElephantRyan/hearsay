use hearsay.absclient as client;
use hearsay.absclient.catalog;
use hearsay.absclient.catalog.AbsCatalog;
use hearsay.absclient.collections.AbsCollections;
use hearsay.accounts;
use hearsay.ratings;
use hearsay.sessions;
use hearsay.sessions.SessionConfig;
use hearsay.settings.AbsService;
use hearsay.settings.SyncConfig;
use hearsay.settings.Abs;

test syncDryRunsByDefaultAndOnlyWritesWhenAskedTo {
    fake AbsService {
        token: "svc";
    }

    fake Abs {
        url: "https://abs.test";
    }

    fake SessionConfig {
        sessionMaxAge: 3600;
    }

    fake SyncConfig {
        mirrorEnabled: true;
    }

    fake AbsCatalog {
        // Every book is in no series, as ABS would say.
        gateway itemsAsService(itemIds: List<string>)
                -> Result<List<catalog.Book>, client.AbsError> {
            return Ok(
                map(id in itemIds):
                        catalog.Book(
                            itemId: id,
                            libraryId: "lib-1",
                            title: "T",
                            authors: "A",
                            series: []
                        )
            );
        }

        gateway itemAsService(itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(catalog.Book(itemId: itemId, libraryId: "lib-1", title: "T", authors: "A"));
        }
    }

    fake AbsCollections {
        gateway createCollectionAsService(
            libraryId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<string, client.AbsError> {
            expect name == "ann Recommends";
            if (calls(AbsCollections.createCollectionAsService) == 1) {
                expect bookIds == ["b", "a"];
            } else {
                expect bookIds == ["a"];
            }

            return Ok("col-${calls(AbsCollections.createCollectionAsService)}");
        }

        gateway updateCollectionAsService(
            collectionId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<int, client.AbsError> {
            if (collectionId == "col-1" && bookIds.length() == 1) {
                return Err(client.AbsError.NotFound);
            }

            return Ok(200);
        }

        gateway deleteCollectionAsService(collectionId: string) -> Result<int, client.AbsError> {
            return Ok(200);
        }
    }

    annId = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User);
    ann = sessions.startSession(annId).token;
    expect ratings.putRating(annId, "a", ratings.RatingInput(score: 7, note: None, recommended: true)) is Ok(_);
    expect ratings.putRating(annId, "b", ratings.RatingInput(score: 9, note: None, recommended: true)) is Ok(_);
    expect syncCollections(annId, None, None) is Ok(preview);
    expect preview.length() == 1;
    expect preview.at(0).action == SyncOutcome.WouldCreate;
    expect preview.at(0).books == 2;
    expect calls(AbsCollections.createCollectionAsService) == 0;
    expect allSyncStates().length() == 0;
    expect syncCollections(annId, None, false) is Ok(first);
    expect first.at(0).action == SyncOutcome.Created;
    expect allSyncStates().length() == 1;
    expect allSyncStates().at(0).collectionId == "col-1";
    expect syncCollections(annId, None, false) is Ok(second);
    expect second.at(0).action == SyncOutcome.Updated;
    expect calls(AbsCollections.createCollectionAsService) == 1;
    // someone deleted our collection in ABS: the update says 404, so it is made again
    expect ratings.putRating(annId, "b", ratings.RatingInput(score: 9, note: None, recommended: false)) is Ok(_);
    expect syncCollections(annId, None, false) is Ok(recreated);
    expect recreated.at(0).action == SyncOutcome.Created;
    expect calls(AbsCollections.createCollectionAsService) == 2;
    // nothing left to recommend: our collection is removed and forgotten
    expect ratings.putRating(annId, "a", ratings.RatingInput(score: 7, note: None, recommended: false)) is Ok(_);
    expect syncCollections(annId, None, false) is Ok(removed);
    expect removed.at(0).action == SyncOutcome.Removed;
    expect allSyncStates().length() == 0;
    expect calls(AbsCollections.deleteCollectionAsService) == 1;
}

test syncIsOffByDefaultAndPrivateToTheirOwner {
    fake SessionConfig {
        sessionMaxAge: 3600;
    }

    fake SyncConfig {
        mirrorEnabled: false;
    }

    fake AbsCollections {
        gateway createCollectionAsService(
            libraryId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<string, client.AbsError> {
            expect false;
            return Err(client.AbsError.NotFound);
        }

        gateway updateCollectionAsService(
            collectionId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<int, client.AbsError> {
            expect false;
            return Err(client.AbsError.NotFound);
        }

        gateway deleteCollectionAsService(collectionId: string) -> Result<int, client.AbsError> {
            expect false;
            return Err(client.AbsError.NotFound);
        }
    }

    annId = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User);
    ann = sessions.startSession(annId).token;
    expect syncCollections(annId, None, false) is Err(SyncError.MirroringOff);
}

// disabled means disabled for everyone: a stranger learns nothing about sessions
test aPersonCannotSyncSomeoneElsesList {
    fake SessionConfig {
        sessionMaxAge: 3600;
    }

    fake SyncConfig {
        mirrorEnabled: true;
    }

    fake AbsCollections {
        gateway createCollectionAsService(
            libraryId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<string, client.AbsError> {
            expect false;
            return Err(client.AbsError.NotFound);
        }

        gateway updateCollectionAsService(
            collectionId: string,
            name: string,
            description: string,
            bookIds: List<string>)
                -> Result<int, client.AbsError> {
            return Ok(200);
        }

        gateway deleteCollectionAsService(collectionId: string) -> Result<int, client.AbsError> {
            return Ok(200);
        }
    }

    annId = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User);
    ann = sessions.startSession(annId).token;
    expect syncCollections(annId, "u2", false) is Err(SyncError.NotAllowed);
    expect calls(AbsCollections.createCollectionAsService) == 0;
}
