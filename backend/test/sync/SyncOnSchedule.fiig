use hearsay.absclient as client
use hearsay.absclient.catalog
use hearsay.absclient.catalog.AbsCatalog
use hearsay.absclient.collections.AbsCollections
use hearsay.accounts
use hearsay.ratings
use hearsay.sessions
use hearsay.sessions.SessionConfig
use hearsay.settings.Abs
use hearsay.settings.AbsService
use hearsay.settings.SyncConfig

test theScheduledSyncDoesNothingWhileMirroringIsOff {
    fake SyncConfig {
        mirrorEnabled: false
    }
    fake AbsCollections {
        gateway createCollectionAsService(abs: client.AbsTarget, libraryId: string, name: string, description: string, bookIds: List<string>) -> Result<string, client.AbsError> {
            expect false
            return Ok("never")
        }

        gateway updateCollectionAsService(abs: client.AbsTarget, collectionId: string, name: string, description: string, bookIds: List<string>) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }

        gateway deleteCollectionAsService(abs: client.AbsTarget, collectionId: string) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }
    }

    expect syncOnSchedule() is Ok(none)
    expect none == 0
    expect calls(AbsCollections.createCollectionAsService) == 0
}

test theScheduledSyncBringsEveryonesCollectionsUpToDate {
    fake AbsService {
        token: "svc"
    }
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SyncConfig {
        mirrorEnabled: true
    }
    fake AbsCatalog {
        gateway itemAsService(abs: client.AbsTarget, itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(catalog.Book(itemId: itemId, libraryId: "lib-1", title: "T", authors: "A"))
        }
    }
    fake AbsCollections {
        gateway createCollectionAsService(abs: client.AbsTarget, libraryId: string, name: string, description: string, bookIds: List<string>) -> Result<string, client.AbsError> {
            if name == "bob Recommends" {
                return Err(client.AbsError.Unauthorized)
            }
            return Ok("col-ann")
        }

        gateway updateCollectionAsService(abs: client.AbsTarget, collectionId: string, name: string, description: string, bookIds: List<string>) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }

        gateway deleteCollectionAsService(abs: client.AbsTarget, collectionId: string) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }
    }

    expect syncOnSchedule() is Ok(nothing)
    expect nothing == 0
    annId = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)
    ann = sessions.startSession(annId).token
    bobId = accounts.Identity(userId: "u2", username: "bob", userType: client.AbsUserType.User)
    bob = sessions.startSession(bobId).token
    expect ratings.putRating(annId, "a", ratings.RatingInput(score: 9, note: None, recommended: true)) is Ok(_)
    expect ratings.putRating(bobId, "b", ratings.RatingInput(score: 8, note: None, recommended: true)) is Ok(_)
    expect ratings.putRating(bobId, "c", ratings.RatingInput(score: 3, note: None, recommended: false)) is Ok(_)

    expect syncOnSchedule() is Err(SyncError.SomeWritesFailed(failed, total))
    expect failed == 1
    expect total == 2
    expect calls(AbsCollections.createCollectionAsService) == 2
    expect allSyncStates().length() == 1
    expect allSyncStates().at(0).userId == "u1"
}
