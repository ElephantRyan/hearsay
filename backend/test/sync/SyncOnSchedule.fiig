use abs.recommendations.absclient as client
use abs.recommendations.absclient.catalog
use abs.recommendations.absclient.catalog.AbsCatalog
use abs.recommendations.absclient.collections.AbsCollections
use abs.recommendations.accounts
use abs.recommendations.common
use abs.recommendations.ratings
use abs.recommendations.sessions
use abs.recommendations.sessions.SessionConfig
use abs.recommendations.settings
use abs.recommendations.settings.Abs
use abs.recommendations.settings.SyncConfig

test theScheduledSyncDoesNothingWhileMirroringIsOff {
    fake SyncConfig {
        mirrorEnabled: false
    }
    fake AbsCollections {
        gateway createCollectionAsService(abs: client.AbsTarget, libraryId: string, name: string, description: string, bookIds: List<string>) -> Result<string, client.AbsError> {
            expect false
            return Ok("never")
        }

        gateway updateCollectionAsService(abs: client.AbsTarget, collectionId: string, name: string, description: string, bookIds: List<string>) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }

        gateway deleteCollectionAsService(abs: client.AbsTarget, collectionId: string) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }
    }

    expect syncOnSchedule() is Ok(none)
    expect none == 0
    expect calls(AbsCollections.createCollectionAsService) == 0
}

test theScheduledSyncBringsEveryonesCollectionsUpToDate {
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SyncConfig {
        mirrorEnabled: true
    }
    fake AbsCatalog {
        gateway itemAsService(abs: client.AbsTarget, itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(catalog.Book(itemId: itemId, libraryId: "lib-1", title: "T", authors: "A"))
        }
    }
    fake AbsCollections {
        gateway createCollectionAsService(abs: client.AbsTarget, libraryId: string, name: string, description: string, bookIds: List<string>) -> Result<string, client.AbsError> {
            if name == "bob Recommends" {
                return Err(client.AbsError.Unauthorized)
            }
            return Ok("col-ann")
        }

        gateway updateCollectionAsService(abs: client.AbsTarget, collectionId: string, name: string, description: string, bookIds: List<string>) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }

        gateway deleteCollectionAsService(abs: client.AbsTarget, collectionId: string) -> Result<int, client.AbsError> {
            expect false
            return Ok(200)
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    expect syncOnSchedule() is Ok(nothing)
    expect nothing == 0
    ann = sessions.startSession(accounts.Identity(userId: "u1", username: "ann", userType: "user")).token
    bob = sessions.startSession(accounts.Identity(userId: "u2", username: "bob", userType: "user")).token
    expect ratings.putRating(ann, "a", ratings.RatingInput(score: 9, note: None, recommended: true)) is Ok(_)
    expect ratings.putRating(bob, "b", ratings.RatingInput(score: 8, note: None, recommended: true)) is Ok(_)
    expect ratings.putRating(bob, "c", ratings.RatingInput(score: 3, note: None, recommended: false)) is Ok(_)

    expect syncOnSchedule() is Err(common.ApiError.Unavailable(why))
    expect why == "1 of 2 collection writes failed"
    expect calls(AbsCollections.createCollectionAsService) == 2
    expect allSyncStates().length() == 1
    expect allSyncStates().at(0).userId == "u1"
}
