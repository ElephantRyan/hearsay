test beginUrlCarriesStateAndTheS256Challenge {
    fake Oidc {
        issuer: "https://idp.test/application/o/abs/"
        clientId: "cid"
        clientSecret: "csec"
        redirectUri: "http://localhost:8080/auth/callback"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect request.url == "https://idp.test/application/o/abs/.well-known/openid-configuration"
            return Ok(
                http.Reply(status: 200, headers: [], body: "{\"authorization_endpoint\":\"https://idp.test/application/o/authorize/\",\"token_endpoint\":\"https://idp.test/application/o/token/\",\"userinfo_endpoint\":\"https://idp.test/application/o/userinfo/\",\"issuer\":\"x\"}".utf8()),
            )
        }
    }

    expect AuthentikSignIn.beginUrl("st-1", "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk") is Ok(url)
    expect url.startsWith("https://idp.test/application/o/authorize/?")
    expect url.contains("response_type=code")
    expect url.contains("client_id=cid")
    expect url.contains("redirect_uri=http%3A%2F%2Flocalhost%3A8080%2Fauth%2Fcallback")
    expect url.contains("scope=openid+email+profile")
    expect url.contains("state=st-1")
    expect url.contains("code_challenge=E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM")
    expect url.contains("code_challenge_method=S256")
}
