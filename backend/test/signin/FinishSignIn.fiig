use abs.recommendations.accounts
use abs.recommendations.sessions
use abs.recommendations.sessions.SessionConfig
use abs.recommendations.signin.authentik.AuthentikSignIn
use abs.recommendations.signin.password.AbsPasswordSignIn

// The callback only exchanges the code when the state matches the cookie.
// Authentik is faked; a call to it from a mismatched callback fails the test.
test oidcCallbackChecksStateBeforeExchanging {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SignInConfig {
        authMode: "both"
        frontendUrl: "https://app.test"
    }
    fake AbsPasswordSignIn {
        gateway authenticate(attempt: accounts.SignInAttempt) -> Result<accounts.Identity, accounts.SignInError> {
            expect false
            return Err(accounts.SignInError.WrongMethod)
        }
    }
    fake AuthentikSignIn {
        gateway beginUrl(state: string, codeVerifier: string) -> Result<string, accounts.SignInError> {
            return Ok("https://idp.test/authorize?state=${state}")
        }

        gateway authenticate(attempt: accounts.SignInAttempt) -> Result<accounts.Identity, accounts.SignInError> {
            match attempt {
                accounts.SignInAttempt.AuthorizationCode(code, verifier) -> {
                    expect verifier == "ver-1"
                    if code == "unknown-person" {
                        return Err(accounts.SignInError.NoAccount)
                    }
                    return Ok(accounts.Identity(userId: "u1", username: "ann", userType: "user"))
                }
                accounts.SignInAttempt.Password(username, password) -> {
                    return Err(accounts.SignInError.WrongMethod)
                }
            }
        }
    }

    good = finishSignIn("code-1", "st-1", None, "st-1.ver-1")
    expect good.location == "https://app.test"
    match good.session {
        None -> {
            expect false
        }
        opened -> {
            expect sessions.currentUser(opened.token) is Ok(me)
            expect me.userId == "u1"
        }
    }
    expect finishSignIn("code-1", "WRONG", None, "st-1.ver-1").location == "https://app.test/sign-in?error=state"
    expect finishSignIn("code-1", "st-1", None, None).location == "https://app.test/sign-in?error=state"
    expect finishSignIn("code-1", "st-1", None, "garbage").location == "https://app.test/sign-in?error=state"
    expect finishSignIn(None, "st-1", None, "st-1.ver-1").location == "https://app.test/sign-in?error=missing"
    expect finishSignIn(None, None, "access_denied", None).location == "https://app.test/sign-in?error=denied"
    expect finishSignIn("unknown-person", "st-1", None, "st-1.ver-1").location == "https://app.test/sign-in?error=no-account"
    expect calls(AuthentikSignIn.authenticate) == 2
    expect startOidc() is Ok(start)
    expect start.url.startsWith("https://idp.test/authorize?state=")
    expect start.pending.split(".").length() == 2
}

test finishSignInIsOffInPasswordOnlyMode {
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake SignInConfig {
        authMode: "abs"
        frontendUrl: "https://app.test"
    }
    fake AbsPasswordSignIn {
        gateway authenticate(attempt: accounts.SignInAttempt) -> Result<accounts.Identity, accounts.SignInError> {
            expect false
            return Err(accounts.SignInError.WrongMethod)
        }
    }
    fake AuthentikSignIn {
        gateway beginUrl(state: string, codeVerifier: string) -> Result<string, accounts.SignInError> {
            expect false
            return Err(accounts.SignInError.WrongMethod)
        }

        gateway authenticate(attempt: accounts.SignInAttempt) -> Result<accounts.Identity, accounts.SignInError> {
            expect false
            return Err(accounts.SignInError.WrongMethod)
        }
    }

    expect finishSignIn("c", "s", None, "s.v").location == "https://app.test/sign-in?error=disabled"
    expect calls(AuthentikSignIn.authenticate) == 0
}
