use abs.recommendations.absclient.Abs
use abs.recommendations.accounts
use fiig.http
use fiig.http.HttpClient

test passwordSignInGivesAnIdentity {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            return Ok(
                http.Reply(status: 200, headers: [], body: "{\"user\":{\"id\":\"u-1\",\"username\":\"ryan\",\"type\":\"user\",\"accessToken\":\"acc\",\"refreshToken\":\"ref\"}}".utf8()),
            )
        }
    }

    attempt = accounts.SignInAttempt.Password("ryan", "pw")
    expect AbsPasswordSignIn.authenticate(attempt) is Ok(identity)
    expect identity == accounts.Identity(userId: "u-1", username: "ryan", userType: "user")
}

test passwordSignInRefusals {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if request.url == "https://abs.test/login" {
                return Ok(http.Reply(status: 401, headers: [], body: "Invalid".utf8()))
            }
            return Ok(http.Reply(status: 500, headers: [], body: "".utf8()))
        }
    }

    wrong = accounts.SignInAttempt.Password("ryan", "nope")
    expect AbsPasswordSignIn.authenticate(wrong) is Err(accounts.SignInError.Refused(why))
    expect why == "wrong username or password"
    code = accounts.SignInAttempt.AuthorizationCode("c", "v")
    expect AbsPasswordSignIn.authenticate(code) is Err(accounts.SignInError.WrongMethod)
    expect calls(HttpClient.send) == 1
}
