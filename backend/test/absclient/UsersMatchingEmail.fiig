test usersMatchingEmailIgnoresCaseAndSkipsUsersWithoutOne {
    users = [
        AbsUserEntry(id: "u-1", username: "ryan", type: "admin", email: "Ryan@Example.com"),
        AbsUserEntry(id: "u-2", username: "mom", type: "user", email: None),
        AbsUserEntry(id: "u-3", username: "sam", type: "user", email: "sam@example.com"),
    ]
    expect usersMatchingEmail(users, "ryan@example.com").length() == 1
    expect usersMatchingEmail(users, "ryan@example.com").at(0).id == "u-1"
    expect usersMatchingEmail(users, "nobody@example.com").length() == 0
}
