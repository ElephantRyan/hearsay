use abs.recommendations.absclient
use abs.recommendations.absclient.Abs
use abs.recommendations.absclient.AbsService
use fiig.http
use fiig.http.HttpClient

// Writes are the dangerous calls, so bad ids stop before any request: a path
// built from "../users" would be a write-capable request to the wrong place.
test absCollectionWritesRefuseBadIdsAndMapFailures {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsService {
        token: "svc"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if request.url == "https://abs.test/api/collections/gone" {
                return Ok(http.Reply(status: 404, headers: [], body: "Not Found".utf8()))
            }
            if request.url == "https://abs.test/api/collections/denied" {
                return Ok(http.Reply(status: 403, headers: [], body: "Forbidden".utf8()))
            }
            return Ok(http.Reply(status: 200, headers: [], body: "{\"id\":\"x\"}".utf8()))
        }
    }

    expect AbsCollections.deleteCollectionAsService("../users") is Err(absclient.AbsError.NotFound)
    expect AbsCollections.updateCollectionAsService("a/b", "n", "d", []) is Err(absclient.AbsError.NotFound)
    expect AbsCollections.createCollectionAsService("lib/../x", "n", "d", []) is Err(absclient.AbsError.NotFound)
    expect AbsCollections.createCollectionAsService("lib-1", "n", "d", ["ok-id", "../bad"]) is Err(absclient.AbsError.NotFound)
    expect calls(HttpClient.send) == 0
    expect AbsCollections.deleteCollectionAsService("gone") is Err(absclient.AbsError.NotFound)
    expect AbsCollections.updateCollectionAsService("denied", "n", "d", []) is Err(absclient.AbsError.Rejected(status))
    expect status == 403
}

// What a collection write sends: the verb, the path, the token, and a JSON body
// carrying the books in order. ABS's reply is faked with the one member read.
test absCollectionWritesSendExactlyWhatTheyShould {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsService {
        token: "svc"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect http.headerValue(request.headers, "authorization") == "Bearer svc"
            expect http.headerValue(request.headers, "content-type") == "application/json"
            if request.method == http.Method.Post {
                expect request.url == "https://abs.test/api/collections"
                match request.body {
                    None -> {
                        expect false
                    }
                    sent -> {
                        match sent.utf8() {
                            None -> {
                                expect false
                            }
                            text -> {
                                expect text.contains("\"libraryId\":\"lib-1\"")
                                expect text.contains("\"name\":\"Ann Recommends\"")
                                expect text.contains("\"books\":[\"b-2\",\"b-1\"]")
                            }
                        }
                    }
                }
                return Ok(
                    http.Reply(status: 200, headers: [], body: "{\"id\":\"col-1\",\"libraryId\":\"lib-1\",\"name\":\"Ann Recommends\",\"books\":[],\"lastUpdate\":1}".utf8()),
                )
            }
            if request.method == http.Method.Patch {
                expect request.url == "https://abs.test/api/collections/col-1"
                return Ok(http.Reply(status: 200, headers: [], body: "{\"id\":\"col-1\"}".utf8()))
            }
            expect request.method == http.Method.Delete
            expect request.url == "https://abs.test/api/collections/col-1"
            expect request.body == None
            return Ok(http.Reply(status: 200, headers: [], body: "OK".utf8()))
        }
    }

    expect AbsCollections.createCollectionAsService("lib-1", "Ann Recommends", "d", ["b-2", "b-1"]) is Ok(id)
    expect id == "col-1"
    expect AbsCollections.updateCollectionAsService("col-1", "Ann Recommends", "d", ["b-1"]) is Ok(patched)
    expect patched == 200
    expect AbsCollections.deleteCollectionAsService("col-1") is Ok(deleted)
    expect deleted == 200
    expect calls(HttpClient.send) == 3
}
