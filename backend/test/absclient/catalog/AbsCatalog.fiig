use hearsay.absclient;
use hearsay.settings.Abs;
use fiig.http;
use fiig.http.HttpClient;
use hearsay.settings;
use hearsay.settings.AbsService;

// Replies are shaped like the live ABS 2.37.2's (checked 2026-11-19): a minified
// listing carries one `authorName`, which may be null; a search nests the same
// item under `book[].libraryItem` beside other result kinds this app ignores.
test absBrowseReadsLibrariesPagesAndSearchHits {
    fake AbsService {
        token: "svc";
    }

    fake Abs {
        url: "https://abs.test";
    }

    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect http.headerValue(request.headers, "authorization") == "Bearer svc";
            expect request.method == http.Method.Get;
            if (request.url == "https://abs.test/api/libraries") {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: "{\"libraries\":[{\"id\":\"lib-1\",\"name\":\"Audiobooks\",\"mediaType\":\"book\",\"folders\":[]},{\"id\":\"lib-2\",\"name\":\"Podcasts\",\"mediaType\":\"podcast\"}]}".utf8(),
                    ),
                );
            }

            if (request.url == "https://abs.test/api/libraries/lib-1/items?sort=media.metadata.title&minified=1&page=2&limit=2") {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: "{\"results\":[{\"id\":\"it-1\",\"libraryId\":\"lib-1\",\"size\":1,\"media\":{\"metadata\":{\"title\":\"Dune\",\"authorName\":\"Frank Herbert\",\"subtitle\":null}}},{\"id\":\"it-2\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"Anon\",\"authorName\":null}}}],\"total\":1117,\"limit\":2,\"page\":2,\"sortBy\":\"media.metadata.title\"}".utf8(),
                    ),
                );
            }

            if (request.url == "https://abs.test/api/libraries/lib-1/items?sort=media.metadata.authorName&desc=1&minified=1&page=0&limit=2") {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: "{\"results\":[],\"total\":1117,\"limit\":2,\"page\":0}".utf8(),
                    ),
                );
            }

            // a series' books in series order, and an author's: ABS's filter is the
            // group and the id in unpadded URL-safe base64 ("se-1", "au-1")
            if (request.url == "https://abs.test/api/libraries/lib-1/items?sort=sequence&filter=series.c2UtMQ&minified=1&page=0&limit=2") {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: "{\"results\":[],\"total\":3,\"limit\":2,\"page\":0}".utf8(),
                    ),
                );
            }

            if (request.url == "https://abs.test/api/libraries/lib-1/items?sort=media.metadata.title&filter=authors.YXUtMQ&minified=1&page=0&limit=2") {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: "{\"results\":[],\"total\":4,\"limit\":2,\"page\":0}".utf8(),
                    ),
                );
            }

            if (request.url == "https://abs.test/api/libraries/lib-1/search?q=war+%26+peace&limit=5") {
                return Ok(
                    http.Reply(
                        status: 200,
                        headers: [],
                        body: "{\"book\":[{\"libraryItem\":{\"id\":\"it-9\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"War and Peace\",\"authorName\":\"Leo Tolstoy\"}}},\"matchKey\":\"title\"}],\"series\":[{\"series\":{\"id\":\"se-1\",\"name\":\"War Stories\"},\"books\":[{\"id\":\"it-9\"},{\"id\":\"it-10\"}]}],\"authors\":[{\"id\":\"au-1\",\"name\":\"Leo Tolstoy\",\"numBooks\":4}],\"narrators\":[],\"tags\":[],\"genres\":[]}".utf8(),
                    ),
                );
            }

            expect false;
            return Ok(http.Reply(status: 404, headers: [], body: "".utf8()));
        }
    }

    expect AbsCatalog.librariesAsService() is Ok(libraries);
    expect libraries.length() == 2;
    expect libraries.at(0) == AbsLibrary(id: "lib-1", name: "Audiobooks", mediaType: "book");
    expect AbsCatalog.pageAsService("lib-1", 2, 2, BookOrder.TitleAscending, BookScope.All) is Ok(page);
    expect page.total == 1117;
    expect page.page == 2;
    expect page.books.length() == 2;
    expect page.books.at(0) == Book(itemId: "it-1", libraryId: "lib-1", title: "Dune", authors: "Frank Herbert");
    expect page.books.at(1).authors == "";
    expect AbsCatalog.pageAsService("lib-1", 0, 2, BookOrder.AuthorDescending, BookScope.All) is Ok(byAuthor);
    expect byAuthor.total == 1117;
    expect AbsCatalog.searchAsService("lib-1", "war & peace", 5) is Ok(found);
    expect found.page.books.length() == 1;
    expect found.page.books.at(0).title == "War and Peace";
    expect found.authors == [CatalogMatch(id: "au-1", name: "Leo Tolstoy", books: 4)];
    expect found.series == [CatalogMatch(id: "se-1", name: "War Stories", books: 2)];
    expect AbsCatalog.pageAsService("lib-1", 0, 2, BookOrder.SeriesOrder, BookScope.Series("se-1")) is Ok(oneSeries);
    expect oneSeries.total == 3;
    expect AbsCatalog.pageAsService("lib-1", 0, 2, BookOrder.TitleAscending, BookScope.Author("au-1")) is Ok(oneAuthor);
    expect oneAuthor.total == 4;
    // a scope id is checked as a book id is, before anything is sent
    expect AbsCatalog.pageAsService("lib-1", 0, 2, BookOrder.TitleAscending, BookScope.Author("../users")) is Err(absclient.AbsError.NotFound);
    expect calls(HttpClient.send) == 6;
}

// An id from a caller's URL goes into an ABS path sent with the server's own
// token. A hostile one must be refused before any request is made.
test absRefusesHostileIdsWithoutCallingAbs {
    fake AbsService {
        token: "svc";
    }

    fake Abs {
        url: "https://abs.test";
    }

    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect false;
            return Ok(http.Reply(status: 200, headers: [], body: "{}".utf8()));
        }
    }

    expect AbsCatalog.itemAsService("../../api/users") is Err(absclient.AbsError.NotFound);
    expect AbsCatalog.itemAsService("a/b") is Err(absclient.AbsError.NotFound);
    expect AbsCatalog.itemAsService("") is Err(absclient.AbsError.NotFound);
    expect AbsCatalog.item("https://abs.test", "tok", "x?y=1") is Err(absclient.AbsError.NotFound);
    expect AbsCatalog.pageAsService("../users", 0, 10, BookOrder.TitleAscending, BookScope.All) is Err(absclient.AbsError.NotFound);
    expect AbsCatalog.searchAsService("lib/../x", "q", 10) is Err(absclient.AbsError.NotFound);
    expect calls(HttpClient.send) == 0;
}

// Trimmed from a real GET /api/items/{id} reply: a null subtitle and members
// this app doesn't read.
test absItemBecomesABook {
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect request.url == "https://abs.test/api/items/it-1";
            expect request.method == http.Method.Get;
            expect request.body == None;
            return Ok(
                http.Reply(
                    status: 200,
                    headers: [],
                    body: "{\"id\":\"it-1\",\"libraryId\":\"lib-1\",\"path\":\"/audiobooks/x\",\"media\":{\"coverPath\":\"/c.webp\",\"metadata\":{\"title\":\"After the Rabbit\",\"subtitle\":null,\"authors\":[{\"id\":\"a-1\",\"name\":\"Nelson Chereta\"}],\"series\":[],\"genres\":[\"Fantasy\"],\"publishedYear\":\"2017\"},\"tags\":[]}}".utf8(),
                ),
            );
        }
    }

    expect AbsCatalog.item("https://abs.test", "tok", "it-1") is Ok(book);
    expect book == Book(itemId: "it-1", libraryId: "lib-1", title: "After the Rabbit", authors: "Nelson Chereta", series: []);
}

// A refusal is a value, not a fault: a missing book, a reply that isn't JSON.
test absCatalogRefusalsAreValues {
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if (request.url == "https://abs.test/login") {
                return Ok(
                    http.Reply(
                        status: 401,
                        headers: [],
                        body: "Invalid username or password".utf8(),
                    ),
                );
            }

            if (request.url == "https://abs.test/api/items/gone") {
                return Ok(http.Reply(status: 404, headers: [], body: "Not Found".utf8()));
            }

            if (request.url == "https://abs.test/api/items/odd") {
                return Ok(
                    http.Reply(status: 200, headers: [], body: "<html>not json</html>".utf8()),
                );
            }

            return Ok(http.Reply(status: 500, headers: [], body: "".utf8()));
        }
    }

    expect AbsCatalog.item("https://abs.test", "tok", "gone") is Err(absclient.AbsError.NotFound);
    expect AbsCatalog.item("https://abs.test", "tok", "odd") is Err(absclient.AbsError.Unreadable(_));
}

// Many books in one POST /api/items/batch/get, which reads. ABS leaves out ids it
// doesn't have.
test absBatchLooksUpManyBooksInOneCall {
    fake AbsService {
        token: "svc";
    }

    fake Abs {
        url: "https://abs.test";
    }

    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect request.method == http.Method.Post;
            expect request.url == "https://abs.test/api/items/batch/get";
            expect http.headerValue(request.headers, "authorization") == "Bearer svc";
            expect request.body == "{\"libraryItemIds\":[\"b-1\",\"gone\",\"b-2\"]}".utf8();
            return Ok(
                http.Reply(
                    status: 200,
                    headers: [],
                    body: "{\"libraryItems\":[{\"id\":\"b-1\",\"libraryId\":\"lib-1\",\"libraryFiles\":[],\"media\":{\"metadata\":{\"title\":\"Alpha\",\"authorName\":\"A. Author, B. Author\",\"authors\":[{\"id\":\"a1\",\"name\":\"A. Author\"}]},\"chapters\":[]}},{\"id\":\"b-2\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"Beta\",\"authorName\":null}}}]}".utf8(),
                ),
            );
        }
    }

    expect AbsCatalog.itemsAsService(["b-1", "gone", "b-2"]) is Ok(found);
    expect found == [Book(itemId: "b-1", libraryId: "lib-1", title: "Alpha", authors: "A. Author, B. Author", series: []), Book(itemId: "b-2", libraryId: "lib-1", title: "Beta", authors: "", series: [])];
}

test absBatchRefusesAHostileIdWithoutCallingAbs {
    fake AbsService {
        token: "svc";
    }

    fake Abs {
        url: "https://abs.test";
    }

    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect false;
            return Ok(http.Reply(status: 500, headers: [], body: "".utf8()));
        }
    }

    expect AbsCatalog.itemsAsService(["b-1", "../users"]) is Err(absclient.AbsError.NotFound);
}

// A listing filtered by series gives each book's series as one object, not a
// list, so a listing doesn't read it: the page still parses.
test aSeriesListingParsesWhateverShapeItsSeriesHas {
    body = "{\"results\":[{\"id\":\"vc-1\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"Forging Hephaestus\",\"authorName\":\"Drew Hayes\",\"series\":{\"id\":\"vc\",\"name\":\"Villains' Code\",\"sequence\":\"1\"}}}}],\"total\":1,\"limit\":100,\"page\":0}";
    expect bookPageOfListing(body.utf8()) is Ok(page);
    expect page.books.first().title == "Forging Hephaestus";
    expect page.books.first().series == None;
}

// The batch lookup gives series as a list, which is read; none is [].
test aBatchReplyReadsEachBooksSeries {
    body = "{\"libraryItems\":[{\"id\":\"vc-2.5\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"Villains' Vignettes Volume I\",\"authorName\":\"Drew Hayes\",\"series\":[{\"id\":\"vc\",\"name\":\"Villains' Code\",\"sequence\":\"2.5\"}]}}},{\"id\":\"alone\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"Warbreaker\",\"authorName\":\"Brandon Sanderson\",\"series\":[]}}}]}";
    expect booksOfBatchReply(body.utf8()) is Ok(found);
    expect found.at(0).series == [SeriesRef(id: "vc", name: "Villains' Code", sequence: "2.5")];
    none: List<SeriesRef> = [];
    expect found.at(1).series == none;
}
