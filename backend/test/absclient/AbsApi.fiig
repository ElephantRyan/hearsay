use fiig.http
use fiig.http.HttpClient

// Replies are shaped like the live ABS 2.37.2's (checked 2026-11-19): a minified
// listing carries one `authorName`, which may be null; a search nests the same
// item under `book[].libraryItem` beside other result kinds this app ignores.
test absBrowseReadsLibrariesPagesAndSearchHits {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsService {
        token: "svc"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect http.headerValue(request.headers, "authorization") == "Bearer svc"
            expect request.method == http.Method.Get
            if request.url == "https://abs.test/api/libraries" {
                return Ok(
                    http.Reply(status: 200, headers: [], body: "{\"libraries\":[{\"id\":\"lib-1\",\"name\":\"Audiobooks\",\"mediaType\":\"book\",\"folders\":[]},{\"id\":\"lib-2\",\"name\":\"Podcasts\",\"mediaType\":\"podcast\"}]}".utf8()),
                )
            }
            if request.url == "https://abs.test/api/libraries/lib-1/items?sort=media.metadata.title&minified=1&page=2&limit=2" {
                return Ok(
                    http.Reply(status: 200, headers: [], body: "{\"results\":[{\"id\":\"it-1\",\"libraryId\":\"lib-1\",\"size\":1,\"media\":{\"metadata\":{\"title\":\"Dune\",\"authorName\":\"Frank Herbert\",\"subtitle\":null}}},{\"id\":\"it-2\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"Anon\",\"authorName\":null}}}],\"total\":1117,\"limit\":2,\"page\":2,\"sortBy\":\"media.metadata.title\"}".utf8()),
                )
            }
            if request.url == "https://abs.test/api/libraries/lib-1/search?q=war+%26+peace&limit=5" {
                return Ok(
                    http.Reply(status: 200, headers: [], body: "{\"book\":[{\"libraryItem\":{\"id\":\"it-9\",\"libraryId\":\"lib-1\",\"media\":{\"metadata\":{\"title\":\"War and Peace\",\"authorName\":\"Leo Tolstoy\"}}},\"matchKey\":\"title\"}],\"series\":[],\"authors\":[],\"narrators\":[],\"tags\":[],\"genres\":[]}".utf8()),
                )
            }
            expect false
            return Ok(http.Reply(status: 404, headers: [], body: "".utf8()))
        }
    }

    expect AbsApi.librariesAsService() is Ok(libraries)
    expect libraries.length() == 2
    expect libraries.at(0) == AbsLibrary(id: "lib-1", name: "Audiobooks", mediaType: "book")
    expect AbsApi.pageAsService("lib-1", 2, 2) is Ok(page)
    expect page.total == 1117
    expect page.page == 2
    expect page.books.length() == 2
    expect page.books.at(0) == Book(itemId: "it-1", libraryId: "lib-1", title: "Dune", authors: "Frank Herbert")
    expect page.books.at(1).authors == ""
    expect AbsApi.searchAsService("lib-1", "war & peace", 5) is Ok(found)
    expect found.books.length() == 1
    expect found.books.at(0).title == "War and Peace"
    expect calls(HttpClient.send) == 3
}

// Writes are the dangerous calls, so bad ids stop before any request: a path
// built from "../users" would be a write-capable request to the wrong place.
test absCollectionWritesRefuseBadIdsAndMapFailures {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsService {
        token: "svc"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if request.url == "https://abs.test/api/collections/gone" {
                return Ok(http.Reply(status: 404, headers: [], body: "Not Found".utf8()))
            }
            if request.url == "https://abs.test/api/collections/denied" {
                return Ok(http.Reply(status: 403, headers: [], body: "Forbidden".utf8()))
            }
            return Ok(http.Reply(status: 200, headers: [], body: "{\"id\":\"x\"}".utf8()))
        }
    }

    expect AbsApi.deleteCollectionAsService("../users") is Err(AbsError.NotFound)
    expect AbsApi.updateCollectionAsService("a/b", "n", "d", []) is Err(AbsError.NotFound)
    expect AbsApi.createCollectionAsService("lib/../x", "n", "d", []) is Err(AbsError.NotFound)
    expect AbsApi.createCollectionAsService("lib-1", "n", "d", ["ok-id", "../bad"]) is Err(AbsError.NotFound)
    expect calls(HttpClient.send) == 0
    expect AbsApi.deleteCollectionAsService("gone") is Err(AbsError.NotFound)
    expect AbsApi.updateCollectionAsService("denied", "n", "d", []) is Err(AbsError.Rejected(status))
    expect status == 403
}

// What a collection write sends: the verb, the path, the token, and a JSON body
// carrying the books in order. ABS's reply is faked with the one member read.
test absCollectionWritesSendExactlyWhatTheyShould {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsService {
        token: "svc"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect http.headerValue(request.headers, "authorization") == "Bearer svc"
            expect http.headerValue(request.headers, "content-type") == "application/json"
            if request.method == http.Method.Post {
                expect request.url == "https://abs.test/api/collections"
                match request.body {
                    None -> {
                        expect false
                    }
                    sent -> {
                        match sent.utf8() {
                            None -> {
                                expect false
                            }
                            text -> {
                                expect text.contains("\"libraryId\":\"lib-1\"")
                                expect text.contains("\"name\":\"Ann Recommends\"")
                                expect text.contains("\"books\":[\"b-2\",\"b-1\"]")
                            }
                        }
                    }
                }
                return Ok(
                    http.Reply(status: 200, headers: [], body: "{\"id\":\"col-1\",\"libraryId\":\"lib-1\",\"name\":\"Ann Recommends\",\"books\":[],\"lastUpdate\":1}".utf8()),
                )
            }
            if request.method == http.Method.Patch {
                expect request.url == "https://abs.test/api/collections/col-1"
                return Ok(http.Reply(status: 200, headers: [], body: "{\"id\":\"col-1\"}".utf8()))
            }
            expect request.method == http.Method.Delete
            expect request.url == "https://abs.test/api/collections/col-1"
            expect request.body == None
            return Ok(http.Reply(status: 200, headers: [], body: "OK".utf8()))
        }
    }

    expect AbsApi.createCollectionAsService("lib-1", "Ann Recommends", "d", ["b-2", "b-1"]) is Ok(id)
    expect id == "col-1"
    expect AbsApi.updateCollectionAsService("col-1", "Ann Recommends", "d", ["b-1"]) is Ok(patched)
    expect patched == 200
    expect AbsApi.deleteCollectionAsService("col-1") is Ok(deleted)
    expect deleted == 200
    expect calls(HttpClient.send) == 3
}

// An id from a caller's URL goes into an ABS path sent with the server's own
// token. A hostile one must be refused before any request is made.
test absRefusesHostileIdsWithoutCallingAbs {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsService {
        token: "svc"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect false
            return Ok(http.Reply(status: 200, headers: [], body: "{}".utf8()))
        }
    }

    expect AbsApi.itemAsService("../../api/users") is Err(AbsError.NotFound)
    expect AbsApi.itemAsService("a/b") is Err(AbsError.NotFound)
    expect AbsApi.itemAsService("") is Err(AbsError.NotFound)
    expect AbsApi.item("tok", "x?y=1") is Err(AbsError.NotFound)
    expect AbsApi.pageAsService("../users", 0, 10) is Err(AbsError.NotFound)
    expect AbsApi.searchAsService("lib/../x", "q", 10) is Err(AbsError.NotFound)
    expect calls(HttpClient.send) == 0
}

// Trimmed from a real GET /api/items/{id} reply: a null subtitle and members
// this app doesn't read.
test absItemBecomesABook {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect request.url == "https://abs.test/api/items/it-1"
            expect request.method == http.Method.Get
            expect request.body == None
            return Ok(
                http.Reply(status: 200, headers: [], body: "{\"id\":\"it-1\",\"libraryId\":\"lib-1\",\"path\":\"/audiobooks/x\",\"media\":{\"coverPath\":\"/c.webp\",\"metadata\":{\"title\":\"After the Rabbit\",\"subtitle\":null,\"authors\":[{\"id\":\"a-1\",\"name\":\"Nelson Chereta\"}],\"series\":[],\"genres\":[\"Fantasy\"],\"publishedYear\":\"2017\"},\"tags\":[]}}".utf8()),
            )
        }
    }

    expect AbsApi.item("tok", "it-1") is Ok(book)
    expect book == Book(itemId: "it-1", libraryId: "lib-1", title: "After the Rabbit", authors: "Nelson Chereta")
}

// The reply body is the shape ABS 2.37.2 returned (checked live 2026-11-19):
// extra members, including the legacy `token`, are ignored.
test absLoginReadsTheRealReplyShape {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect request.url == "https://abs.test/login"
            expect request.method == http.Method.Post
            return Ok(
                http.Reply(status: 200, headers: [], body: "{\"user\":{\"id\":\"u-1\",\"username\":\"ryan\",\"email\":null,\"type\":\"user\",\"token\":\"legacy\",\"mediaProgress\":[],\"permissions\":{\"download\":true},\"accessToken\":\"acc\",\"refreshToken\":\"ref\"},\"userDefaultLibraryId\":\"lib-1\",\"Source\":\"docker\"}".utf8()),
            )
        }
    }

    expect AbsApi.login("ryan", "pw") is Ok(session)
    expect session == AbsSession(userId: "u-1", username: "ryan", userType: "user", accessToken: "acc", refreshToken: "ref")
    expect calls(HttpClient.send) == 1
}

test absMeSendsTheToken {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect http.headerValue(request.headers, "authorization") == "Bearer tok-1"
            return Ok(
                http.Reply(status: 200, headers: [], body: "{\"id\":\"u-1\",\"username\":\"ryan\",\"type\":\"admin\",\"permissions\":{}}".utf8()),
            )
        }
    }

    expect AbsApi.me("tok-1") is Ok(user)
    expect user == AbsUser(id: "u-1", username: "ryan", type: "admin")
}

test absRefusalsAreValues {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if request.url == "https://abs.test/login" {
                return Ok(
                    http.Reply(status: 401, headers: [], body: "Invalid username or password".utf8()),
                )
            }
            if request.url == "https://abs.test/api/items/gone" {
                return Ok(http.Reply(status: 404, headers: [], body: "Not Found".utf8()))
            }
            if request.url == "https://abs.test/api/items/odd" {
                return Ok(
                    http.Reply(status: 200, headers: [], body: "<html>not json</html>".utf8()),
                )
            }
            return Ok(http.Reply(status: 500, headers: [], body: "".utf8()))
        }
    }

    expect AbsApi.login("ryan", "wrong") is Err(AbsError.Unauthorized)
    expect AbsApi.item("tok", "gone") is Err(AbsError.NotFound)
    expect AbsApi.item("tok", "odd") is Err(AbsError.Unreadable(_))
    expect AbsApi.me("tok") is Err(AbsError.Rejected(status))
    expect status == 500
}
