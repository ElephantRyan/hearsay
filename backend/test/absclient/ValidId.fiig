test validIdAllowsOnlyIdCharacters {
    expect validId("58b7c908-fc73-44d4-b572-b8c09e348ce4");
    expect validId("li_abc123");
    expect !validId("");
    expect !validId("../users");
    expect !validId("..%2Fusers");
    expect !validId("a/b");
    expect !validId("a?x=1");
    expect !validId("a b");
    expect !validId("a#b");
    expect !validId("id\n");
    expect !validId("é");
    expect !validId("0123456789012345678901234567890123456789012345678901234567890123456789");
}
