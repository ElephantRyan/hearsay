use hearsay.absclient as client
use hearsay.absclient.catalog
use hearsay.absclient.catalog.AbsCatalog
use hearsay.accounts
use hearsay.ratings.rated
use hearsay.sessions
use hearsay.sessions.SessionConfig
use hearsay.settings
use hearsay.settings.Abs

// Rates through the real workflows with ABS faked, as a person the adapter has
// already settled. The book is fetched on every write, so a changed title is
// cached.
test ratingFlowCachesTheBookAndKeepsCreatedAt {
    fake Abs {
        url: "https://abs.test"
    }
    fake SessionConfig {
        sessionMaxAge: 3600
    }
    fake AbsCatalog {
        gateway itemAsService(abs: client.AbsTarget, itemId: string) -> Result<catalog.Book, client.AbsError> {
            if itemId == "gone" {
                return Err(client.AbsError.NotFound)
            }
            return Ok(
                catalog.Book(itemId: itemId, libraryId: "lib-1", title: "Dune", authors: "Frank Herbert"),
            )
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    ann = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)
    token = sessions.startSession(ann).token
    expect putRating(ann, "dune", RatingInput(score: 9, note: "great", recommended: true)) is Ok(first)
    expect putRating(ann, "dune", RatingInput(score: 4, note: None, recommended: false)) is Ok(second)
    expect second.createdAt == first.createdAt
    expect second.score == 4
    expect second.note == ""
    expect putRating(ann, "dune", RatingInput(score: 12, note: None, recommended: true)) is Err(RatingError.Invalid(field, reason))
    expect field == "score"
    expect putRating(ann, "gone", RatingInput(score: 5, note: None, recommended: true)) is Err(RatingError.BookNotFound)
    expect rated.listMyRatings(token, None) is Ok(mine)
    expect mine.length() == 1
    expect mine.at(0).title == "Dune"
    expect deleteMyRating(ann, "dune") is Ok(removed)
    expect removed == 1
    expect deleteMyRating(ann, "dune") is Err(RatingError.NoRating)
}

// A rating that is wrong is refused before Audiobookshelf is asked anything:
// the check needs no I/O, so it comes first.
test aBadRatingCostsNoAbsCall {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsCatalog {
        gateway itemAsService(abs: client.AbsTarget, itemId: string) -> Result<catalog.Book, client.AbsError> {
            return Ok(catalog.Book(itemId: itemId, libraryId: "lib-1", title: "Dune", authors: "Frank Herbert"))
        }
    }

    settings.rememberSetting("abs.serviceToken", "svc", "test")
    ann = accounts.Identity(userId: "u1", username: "ann", userType: client.AbsUserType.User)
    expect putRating(ann, "dune", RatingInput(score: 0, note: None, recommended: true)) is Err(RatingError.Invalid(_, _))
    expect calls(AbsCatalog.itemAsService) == 0
}
