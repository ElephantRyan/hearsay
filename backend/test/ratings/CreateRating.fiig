test longNoteIsRefused {
    ten = "0123456789"
    fifty = "${ten}${ten}${ten}${ten}${ten}"
    note280 = "${fifty}${fifty}${fifty}${fifty}${fifty}${ten}${ten}${ten}"
    expect note280.length() == 280
    fits = RatingInput(score: 5, note: note280, recommended: false)
    expect createRating("u1", "a", fits, 1000) is Ok(_)
    tooLong = RatingInput(score: 5, note: "${note280}x", recommended: false)
    expect createRating("u1", "a", tooLong, 1000) is Err(_)
}

test scoreOutOfRangeIsRefused {
    low = RatingInput(score: 0, note: "", recommended: true)
    high = RatingInput(score: 11, note: "", recommended: true)
    expect createRating("u1", "a", low, 1000) is Err(_)
    expect createRating("u1", "a", high, 1000) is Err(_)
    ok = RatingInput(score: 10, note: "", recommended: true)
    expect createRating("u1", "a", ok, 1000) is Ok(_)
}
