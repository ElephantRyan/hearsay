test longNoteIsRefused {
    note280 = "x".repeat(280);
    expect note280.length() == 280;
    fits = RatingInput(score: 5, note: note280, recommended: false);
    expect checkRating("a", fits) is Ok(_);
    tooLong = RatingInput(score: 5, note: "${note280}x", recommended: false);
    expect checkRating("a", tooLong) is Err(RatingError.Invalid(field, _));
    expect field == "note";
}

test scoreOutOfRangeIsRefused {
    low = RatingInput(score: 0, note: "", recommended: true);
    high = RatingInput(score: 11, note: "", recommended: true);
    expect checkRating("a", low) is Err(_);
    expect checkRating("a", high) is Err(_);
    ok = RatingInput(score: 10, note: None, recommended: true);
    expect checkRating("a", ok) is Ok(checked);
    expect checked == CheckedRating(itemId: "a", score: 10, note: "", recommended: true);
}

test aBlankItemIsRefused {
    ok = RatingInput(score: 5, note: None, recommended: true);
    expect checkRating("  ", ok) is Err(RatingError.Invalid(field, _));
    expect field == "itemId";
}
