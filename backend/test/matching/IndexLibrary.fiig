use hearsay.absclient as client;
use hearsay.absclient.catalog;
use hearsay.absclient.catalog.AbsCatalog;
use hearsay.settings;

test theIndexMatchesByAsinThenIsbnThenTitle {
    fake AbsCatalog {
        gateway librariesAsService() -> Result<List<catalog.AbsLibrary>, client.AbsError> {
            return Ok(
                [
                    catalog.AbsLibrary(id: "lib-1", name: "Audiobooks", mediaType: "book"),
                    catalog.AbsLibrary(id: "pod-1", name: "Podcasts", mediaType: "podcast"),
                ],
            );
        }

        // 251 books: a full page of 250 numbered ones, then three named ones on page 1.
        gateway pageAsService(
            libraryId: string,
            page: int,
            size: int,
        ) -> Result<catalog.BookPage, client.AbsError> {
            expect libraryId == "lib-1";
            expect size == 250;
            if (calls(AbsCatalog.pageAsService) > 2) {
                return Err(client.AbsError.Rejected(status: 502));
            }

            if (page == 0) {
                books: List<catalog.Book> = [];
                n: int = 0;
                while (n < 250) {
                    books = append(
                        books,
                        catalog.Book(
                            itemId: "n-${n}",
                            libraryId: "lib-1",
                            title: "Number ${n}",
                            authors: "Counter",
                            asin: "N${n}",
                            isbn: None,
                        ),
                    );
                    n = n + 1;
                }

                return Ok(catalog.BookPage(total: 253, page: 0, limit: 250, books: books));
            }

            return Ok(
                catalog.BookPage(
                    total: 253,
                    page: 1,
                    limit: 250,
                    books: [
                        catalog.Book(
                            itemId: "dune",
                            libraryId: "lib-1",
                            title: "Dune",
                            authors: "Frank Herbert",
                            asin: "b0dune",
                            isbn: None,
                        ),
                        catalog.Book(
                            itemId: "isbn-only",
                            libraryId: "lib-1",
                            title: "Isbn Only",
                            authors: "A",
                            asin: None,
                            isbn: "978-1",
                        ),
                        catalog.Book(
                            itemId: "hobbit",
                            libraryId: "lib-1",
                            title: "The Hobbit",
                            authors: "J. R. R. Tolkien",
                            asin: None,
                            isbn: None,
                        ),
                    ],
                ),
            );
        }
    }

    expect indexLibrary() is Ok(summary);
    expect summary == IndexSummary(books: 253, withAsin: 251, withIsbn: 1, titleOnly: 1);
    expect calls(AbsCatalog.pageAsService) == 2;
    expect matchBook(keysOf("B0DUNE", None, "Dune (Unabridged)", "Someone Else")) == LocalMatch(itemId: "dune", libraryId: "lib-1", how: "asin");
    expect matchBook(keysOf(None, "9781", "Different Title", "Nobody")) == LocalMatch(itemId: "isbn-only", libraryId: "lib-1", how: "isbn");
    expect matchBook(keysOf("B-ELSEWHERE", None, "Hobbit", "J.R.R. Tolkien, Narrator")) == LocalMatch(itemId: "hobbit", libraryId: "lib-1", how: "title");
    expect matchBook(keysOf(None, None, "Not Here", "Anyone")) == None;
    // A rebuild that fails part-way keeps the old index.
    expect indexLibrary() is Err(client.AbsFault.Down(_));
    expect matchBook(keysOf("b0dune", None, "", "")) == LocalMatch(itemId: "dune", libraryId: "lib-1", how: "asin");
}
