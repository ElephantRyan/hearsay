// The status and message a client sees for each error. 401 names no scheme:
// the browser holds a cookie, not a challenge to answer.
conversion apiErrorResponse(error: ApiError) -> HttpResponse<string> {
    match error {
        ApiError.Unauthenticated -> HttpResponse(status: 401, body: "sign in first")
        ApiError.Refused(reason) -> HttpResponse(status: 403, body: reason)
        ApiError.Invalid(field, reason) -> HttpResponse(status: 400, body: "${field} ${reason}")
        ApiError.NotFound(what) -> HttpResponse(status: 404, body: "no ${what}")
        ApiError.Unavailable(detail) -> HttpResponse(status: 503, body: detail)
    }
}
