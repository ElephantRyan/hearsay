use abs.client

// The same as apiErrorOfAbs, except a 404 here means the library, not a book.
conversion apiErrorOfLibrary(error: client.AbsError) -> ApiError {
    match error {
        client.AbsError.NotFound -> ApiError.NotFound("library with that id")
        client.AbsError.Unauthorized -> apiErrorOfAbs(error)
        client.AbsError.Rejected(status) -> apiErrorOfAbs(error)
        client.AbsError.Unreachable(failure) -> apiErrorOfAbs(error)
        client.AbsError.Unreadable(failure) -> apiErrorOfAbs(error)
    }
}
