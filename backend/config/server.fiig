// What a deployment decides (PLAN.md section 8). authMode is `oidc`, `abs`
// or `both`: which sign-in routes answer.
config Server {
    authMode: string from env "AUTH_MODE" = "both"
    sessionMaxAge: int from env "SESSION_MAX_AGE" = 7 * 24 * 60 * 60
    frontendUrl: string from env "FRONTEND_URL" = "http://localhost:5173"
    mirrorEnabled: bool from env "MIRROR_ENABLED" = false
}
