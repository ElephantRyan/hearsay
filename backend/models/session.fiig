// A signed-in person's session: a random token the browser holds as a cookie
// and the database holds only as its SHA-256 (ADR 0075 §4). maxAge is read
// from config by the activity that opens it, since the conversion that sets
// the cookie can't read config (ADR 0071 §2).
use abs.signin

model Session {
    token: string
    identity: signin.Identity
    maxAge: int
}
