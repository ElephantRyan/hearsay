test browseInputsAreCheckedAndDefaulted {
    expect checkPage(None) is Ok(firstPage)
    expect firstPage == 0
    expect checkPage(7) is Ok(seventh)
    expect seventh == 7
    expect checkPage(-1) is Err(ApiError.Invalid(pageField, pageReason))
    expect pageField == "page"

    expect checkSize(None) is Ok(defaultSize)
    expect defaultSize == 24
    expect checkSize(100) is Ok(biggest)
    expect biggest == 100
    expect checkSize(0) is Err(ApiError.Invalid(sizeField, sizeReason))
    expect sizeField == "size"
    expect checkSize(101) is Err(ApiError.Invalid(tooBig, tooBigReason))

    expect searchText(None) is Ok(None)
    expect searchText("   ") is Ok(None)
    expect searchText("  dune  ") is Ok(typed)
    expect typed == "dune"
    ten = "0123456789"
    hundred = "${ten}${ten}${ten}${ten}${ten}${ten}${ten}${ten}${ten}${ten}"
    expect searchText("${hundred}x") is Err(ApiError.Invalid(qField, qReason))
}
