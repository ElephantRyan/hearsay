test rankingOrdersByAverageThenCountThenRecency {
    rows = [
        row("u1", "dune", 9, true, 1),
        row("u2", "dune", 8, true, 2),
        row("u1", "emma", 9, true, 3),
        row("u1", "ubik", 9, true, 4),
        row("u2", "ubik", 8, true, 5),
        row("u3", "ubik", 9, true, 6),
        row("u1", "kim", 8, true, 7),
        row("u2", "kim", 9, true, 8),
        row("u1", "secret", 10, false, 9),
    ]
    ranked = rankRecommendations(rows)
    expect ranked.length() == 4
    expect ranked.at(0).itemId == "emma"
    expect ranked.at(1).itemId == "ubik"
    expect ranked.at(2).itemId == "kim"
    expect ranked.at(3).itemId == "dune"
    expect ranked.at(1).average == 8.67
    expect ranked.at(2).average == 8.5
    expect ranked.at(1).title == "Title of ubik"
}

private {
    row(userId: string, itemId: string, score: int, recommended: bool, at: int) -> RatingRow {
        return RatingRow(userId: userId, username: "name-${userId}", itemId: itemId, libraryId: "lib-1", title: "Title of ${itemId}", authors: "An Author", score: score, note: "", recommended: recommended, createdAt: at, updatedAt: at)
    }
}
