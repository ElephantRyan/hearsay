// signInProvider can return either provider, so both are faked (ADR 0091 §4);
// the one the attempt should not reach fails the test if it is called.
use abs.signin
use abs.signin.authentik.AuthentikSignIn
use abs.signin.password.AbsPasswordSignIn

test signInUsesTheChosenProvider {
    fake AbsPasswordSignIn {
        gateway authenticate(attempt: signin.SignInAttempt) -> Result<signin.Identity, signin.SignInError> {
            return Ok(signin.Identity(userId: "u-pw", username: "ryan", userType: "user"))
        }
    }
    fake AuthentikSignIn {
        gateway beginUrl(state: string, codeVerifier: string) -> Result<string, signin.SignInError> {
            return Ok("https://idp.test/")
        }
        gateway authenticate(attempt: signin.SignInAttempt) -> Result<signin.Identity, signin.SignInError> {
            return Ok(signin.Identity(userId: "u-oidc", username: "ryan", userType: "user"))
        }
    }
    expect signIn(signin.SignInAttempt.Password("ryan", "pw")) is Ok(byPassword)
    expect byPassword.userId == "u-pw"
    expect signIn(signin.SignInAttempt.AuthorizationCode("c", "v")) is Ok(byCode)
    expect byCode.userId == "u-oidc"
    expect calls(AbsPasswordSignIn.authenticate) == 1
    expect calls(AuthentikSignIn.authenticate) == 1
}
