test longNoteIsRefused {
    ten = "0123456789"
    fifty = "${ten}${ten}${ten}${ten}${ten}"
    note280 = "${fifty}${fifty}${fifty}${fifty}${fifty}${ten}${ten}${ten}"
    expect note280.length() == 280
    fits = NewRating(itemId: "a", score: 5, note: note280, recommended: false)
    expect createRating("u1", fits, 1000) is Ok(_)
    tooLong = NewRating(itemId: "a", score: 5, note: "${note280}x", recommended: false)
    expect createRating("u1", tooLong, 1000) is Err(_)
}
