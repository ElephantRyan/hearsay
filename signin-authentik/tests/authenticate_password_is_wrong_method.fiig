use abs.client.Abs
use abs.client.AbsService
use abs.signin
use fiig.http
use fiig.http.HttpClient

test passwordAttemptIsTheWrongMethod {
    fake Abs {
        url: "https://abs.test"
    }
    fake AbsService {
        token: "svc-token"
    }
    fake Oidc {
        issuer: "https://idp.test/application/o/abs/"
        clientId: "cid"
        clientSecret: "csec"
        redirectUri: "http://localhost:8080/auth/callback"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            expect false
            return Ok(http.Reply(status: 500, headers: [], body: "".utf8()))
        }
    }
    attempt = signin.SignInAttempt.Password("ryan", "pw")
    expect AuthentikSignIn.authenticate(attempt) is Err(signin.SignInError.WrongMethod)
    expect calls(HttpClient.send) == 0
}
