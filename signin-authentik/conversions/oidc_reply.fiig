use abs.signin
use fiig.http

// A sent request as the identity provider answers it. 400, 401 and 403 mean
// the provider rejected what the person or browser presented (a used or
// expired code, a wrong state); anything else is the provider being down.
conversion oidcReply(sent: Result<http.Reply, http.HttpError>) -> Result<http.Reply, signin.SignInError> {
    match sent {
        Err(failure) -> Err(signin.SignInError.Unavailable("the identity provider is unreachable"))
        Ok(reply) -> {
            if reply.status == 200 {
                return Ok(reply)
            }
            if reply.status == 400 or reply.status == 401 or reply.status == 403 {
                return Err(signin.SignInError.Refused("the identity provider did not accept this sign-in"))
            }
            return Err(signin.SignInError.Unavailable("the identity provider answered ${reply.status}"))
        }
    }
}
