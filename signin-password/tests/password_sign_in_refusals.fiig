use abs.client.Abs
use abs.signin
use fiig.http
use fiig.http.HttpClient

test passwordSignInRefusals {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            if request.url == "https://abs.test/login" {
                return Ok(http.Reply(status: 401, headers: [], body: "Invalid".utf8()))
            }
            return Ok(http.Reply(status: 500, headers: [], body: "".utf8()))
        }
    }
    wrong = signin.SignInAttempt.Password("ryan", "nope")
    expect AbsPasswordSignIn.authenticate(wrong) is Err(signin.SignInError.Refused(why))
    expect why == "wrong username or password"
    code = signin.SignInAttempt.AuthorizationCode("c", "v")
    expect AbsPasswordSignIn.authenticate(code) is Err(signin.SignInError.WrongMethod)
    expect calls(HttpClient.send) == 1
}
