use abs.client.Abs
use abs.signin
use fiig.http
use fiig.http.HttpClient

test passwordSignInGivesAnIdentity {
    fake Abs {
        url: "https://abs.test"
    }
    fake HttpClient {
        gateway send(request: http.Request) -> Result<http.Reply, http.HttpError> {
            return Ok(http.Reply(status: 200, headers: [], body: "{\"user\":{\"id\":\"u-1\",\"username\":\"ryan\",\"type\":\"user\",\"accessToken\":\"acc\",\"refreshToken\":\"ref\"}}".utf8()))
        }
    }
    attempt = signin.SignInAttempt.Password("ryan", "pw")
    expect AbsPasswordSignIn.authenticate(attempt) is Ok(identity)
    expect identity == signin.Identity(userId: "u-1", username: "ryan", userType: "user")
}
